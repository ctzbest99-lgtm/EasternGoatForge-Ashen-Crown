/// scr_build_greyhaven_blacksmith(): fills rm_greyhaven_blacksmith (20x15 tiles, 320x240 px) from embedded data. Blacksmith, Tomas's forge (burnt; Tomas on a pallet, Pell).
/// Call from the room's Creation Code. Generated by src/export.py.
function scr_build_greyhaven_blacksmith() {
    var _d = scr_greyhaven_blacksmith_data();
    scr_map_build_from_arrays(_d, 20, 15);
    scr_map_spawn_markers(scr_greyhaven_blacksmith_markers());
    scr_map_enable_camera(320, 180);
    scr_camera_follow_player();
}

