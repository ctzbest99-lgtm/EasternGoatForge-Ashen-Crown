/// scr_dialogue_data_ch3 — Chapter 3 dialogue nodes, keyed by the line ids in
/// docs/story/CHAPTER3_SCRIPT.md (approved by Kevin, Nov 14 2026, 3:53 PM ET). Text is verbatim.
/// GENERATED by tools/gen_ch3_dialogue.py — edit the script and re-run, do not hand-edit.
/// Speaker "" is NARRATION. The last block holds the wiring pass's placeholder lines (not in the script).

function scr_ch3_dialogue_node(_id) {
    switch (_id) {
        case "VR_ENTER_01":
            return { id: "VR_ENTER_01", speaker: "Taren", lines: ["Capital road. Keep your hood handy.", "The Crown has a long memory and a short list of friends."] };
        case "VR_ENTER_02":
            return { id: "VR_ENTER_02", speaker: "Kael", lines: ["I wore their colors for four years.", "You're the one they'll look at twice."] };
        case "VR_ENTER_03":
            return { id: "VR_ENTER_03", speaker: "Taren", lines: ["Then I'll be dull as a fence post until we're through the gates.", "After that, we find Alden — and a way at your door."] };
        case "FK_03_01":
            return { id: "FK_03_01", speaker: "", lines: ["An armored figure stands in the middle of the road.", "It does not draw a weapon."] };
        case "FK_03_02":
            return { id: "FK_03_02", speaker: "Kael", lines: ["You again."] };
        case "FK_03_03":
            return { id: "FK_03_03", speaker: "Taren", lines: ["Friend of yours?"] };
        case "FK_03_04":
            return { id: "FK_03_04", speaker: "Kael", lines: ["He never stays long enough to be one."] };
        case "FK_03_05":
            return { id: "FK_03_05", speaker: "Fallen Knight", lines: ["You cannot cross where she did. Not yet."] };
        case "FK_03_06":
            return { id: "FK_03_06", speaker: "Taren", lines: ["She. You mean his sister? Talk sense."] };
        case "FK_03_07":
            return { id: "FK_03_07", speaker: "Kael", lines: ["Hey— wait."] };
        case "FK_03_08":
            return { id: "FK_03_08", speaker: "Taren", lines: ["I don't like a man who knows your family", "and won't give you his name."] };
        case "FK_03_09":
            return { id: "FK_03_09", speaker: "Kael", lines: ["I don't like him either. He still isn't why we're here."] };
        case "VR_SIGN_01":
            return { id: "VR_SIGN_01", speaker: "", lines: ["Valemere. Capital of Eldoria. Keep to the Crown road after dark."] };
        case "VR_STONE_01":
            return { id: "VR_STONE_01", speaker: "", lines: ["Architect work, older than the road. The carvings are too faint", "to read. No door this time."] };
        case "VR_STONE_02":
            return { id: "VR_STONE_02", speaker: "Kael", lines: ["They liked putting marks on things that last.", "I wish one of them had been instructions."] };
        case "VR_SETTLE_01":
            return { id: "VR_SETTLE_01", speaker: "Villager", lines: ["Going to the capital? Watch the gates. They've been", "searching carts like everyone's hiding a banner."] };
        case "VR_SETTLE_02":
            return { id: "VR_SETTLE_02", speaker: "Taren", lines: ["We'll be very ordinary."] };
        case "VR_DERRY_01":
            return { id: "VR_DERRY_01", speaker: "Derry", lines: ["Holt. I'd keep that name in your coat till you're", "past the walls. The capital's been hanging quieter men."] };
        case "VR_DERRY_02":
            return { id: "VR_DERRY_02", speaker: "Taren", lines: ["I'm not here to raise a banner. I'm here with a friend."] };
        case "VR_DERRY_03":
            return { id: "VR_DERRY_03", speaker: "Derry", lines: ["Then be a friend and not a captain, just for a day.", "I won't ask who sent you. Don't ask who sent me."] };
        case "VR_DERRY_04":
            return { id: "VR_DERRY_04", speaker: "Kael", lines: ["We didn't come to seize anything."] };
        case "VR_DERRY_05":
            return { id: "VR_DERRY_05", speaker: "Derry", lines: ["Good. The people who talk about seizing things", "get counted twice at the gate."] };
        case "VR_DERRY_R1":
            return { id: "VR_DERRY_R1", speaker: "Derry", lines: ["Keep walking. I was never here."] };
        case "VR_RUMOR_01":
            return { id: "VR_RUMOR_01", speaker: "Cart driver", lines: ["They say the king's been shut up in the Royal District", "for weeks. No one I know has seen him."] };
        case "VM_GATE_01":
            return { id: "VM_GATE_01", speaker: "Gate Captain", lines: ["Names. Business. Hands where I can see them."] };
        case "VM_GATE_02":
            return { id: "VM_GATE_02", speaker: "Kael", lines: ["Kael Varyn. I served four years. We're here", "to see a friend and to ask a few questions."] };
        case "VM_GATE_03":
            return { id: "VM_GATE_03", speaker: "Gate Captain", lines: ["Varyn. Greyhaven, if the lists are right.", "Sorry about the town. Questions about what?"] };
        case "VM_GATE_04":
            return { id: "VM_GATE_04", speaker: "Kael", lines: ["My sister. And a door that wouldn't open."] };
        case "VM_GATE_05":
            return { id: "VM_GATE_05", speaker: "Gate Captain", lines: ["Then you're in the wrong city for miracles.", "And you — the quiet one. Name."] };
        case "VM_GATE_06":
            return { id: "VM_GATE_06", speaker: "Taren", lines: ["Taren. From near Millhaven. I'm with him."] };
        case "VM_GATE_07":
            return { id: "VM_GATE_07", speaker: "Gate Captain", lines: ["Near Millhaven's been noisy. Keep your swords", "in their sheaths and your mouths smaller than they are."] };
        case "VM_GATE_08":
            return { id: "VM_GATE_08", speaker: "Taren", lines: ["We'll be a credit to the cobbles."] };
        case "VM_GATE_R1":
            return { id: "VM_GATE_R1", speaker: "Gate Captain", lines: ["You're in. Don't make me remember you twice."] };
        case "VM_GATE_SIGN":
            return { id: "VM_GATE_SIGN", speaker: "", lines: ["Valemere. Under the Crown's peace."] };
        case "VM_ROYAL_01":
            return { id: "VM_ROYAL_01", speaker: "Crown Guard", lines: ["Royal District is closed to petitioners this month.", "If you have a seal, you're already inside. If you don't, walk on."] };
        case "VM_ROYAL_02":
            return { id: "VM_ROYAL_02", speaker: "Taren", lines: ["Closed. Of course it is."] };
        case "VM_ROYAL_03":
            return { id: "VM_ROYAL_03", speaker: "Kael", lines: ["I didn't come to petition a wall."] };
        case "VM_MIL_01":
            return { id: "VM_MIL_01", speaker: "Drill Sergeant", lines: ["You. The one with the longsword. You stand like you drilled here."] };
        case "VM_MIL_02":
            return { id: "VM_MIL_02", speaker: "Kael", lines: ["I did. I'm not drilling today."] };
        case "VM_MIL_03":
            return { id: "VM_MIL_03", speaker: "Drill Sergeant", lines: ["Then don't loiter. And tell your friend", "to stop looking at the yard like he's measuring it."] };
        case "VM_TEMPLE_01":
            return { id: "VM_TEMPLE_01", speaker: "Acolyte of the Radiant Flame", lines: ["The Ash is a corruption and a punishment. That is the teaching.", "If you've come for comfort, the doors are open. If not, still —", "the doors are open."] };
        case "VM_TEMPLE_02":
            return { id: "VM_TEMPLE_02", speaker: "Kael", lines: ["I'm looking for my sister, not a sermon."] };
        case "VM_TEMPLE_03":
            return { id: "VM_TEMPLE_03", speaker: "Acolyte", lines: ["Then I will pray you find her uncorrupted."] };
        case "VM_MERCH_01":
            return { id: "VM_MERCH_01", speaker: "Stallkeeper", lines: ["Potions, blades, paper, and bad advice. Coin first.", "The Lower City's cheaper if you don't like sleeping."] };
        case "VM_CLERK_01":
            return { id: "VM_CLERK_01", speaker: "Crown Clerk", lines: ["If this is about the Crownveil, I have no comment.", "If this is about a missing girl, file it at the watch and wait."] };
        case "VM_CLERK_02":
            return { id: "VM_CLERK_02", speaker: "Kael", lines: ["How long is a wait?"] };
        case "VM_CLERK_03":
            return { id: "VM_CLERK_03", speaker: "Crown Clerk", lines: ["For Greyhaven? I wouldn't wait in this office.", "I'd try people who don't work here."] };
        case "VM_CLERK_04":
            return { id: "VM_CLERK_04", speaker: "Taren", lines: ["That's the most honest thing a clerk has ever told us.", "Lower City, then."] };
        case "VM_OLD_01":
            return { id: "VM_OLD_01", speaker: "", lines: ["Older stone than the rest of the capital. A few Architect marks", "sit in the walls, worn almost smooth."] };
        case "VM_OLD_02":
            return { id: "VM_OLD_02", speaker: "Taren", lines: ["Your Architects got everywhere, didn't they?"] };
        case "VM_OLD_03":
            return { id: "VM_OLD_03", speaker: "Kael", lines: ["Everywhere except into an answer."] };
        case "VM_LOWER_01":
            return { id: "VM_LOWER_01", speaker: "Street hawker", lines: ["Lamps, locks, rumors, and regret. The Salt Lamp's down the lane", "if you're buying the last two."] };
        case "AD_MEET_01":
            return { id: "AD_MEET_01", speaker: "", lines: ["A man is speaking in the square, not shouting, not hiding.", "People have stopped to listen."] };
        case "AD_MEET_02":
            return { id: "AD_MEET_02", speaker: "Alden", lines: ["The crown has failed these people. We can say that", "without burning the city down tonight."] };
        case "AD_MEET_03":
            return { id: "AD_MEET_03", speaker: "Alden", lines: ["When we hold this city, we can actually build something.", "Not another throne. Something that belongs to them."] };
        case "AD_MEET_04":
            return { id: "AD_MEET_04", speaker: "Taren", lines: ["Alden."] };
        case "AD_MEET_05":
            return { id: "AD_MEET_05", speaker: "Alden", lines: ["Taren. And — Kael. Look at you.", "I heard about Greyhaven. I'm sorry. I'm glad you came."] };
        case "AD_MEET_06":
            return { id: "AD_MEET_06", speaker: "Kael", lines: ["I'm looking for Mira. And for a way through a door", "that wouldn't open."] };
        case "AD_MEET_07":
            return { id: "AD_MEET_07", speaker: "Alden", lines: ["Then you're looking in the right kingdom and the wrong offices.", "The Crown doesn't answer questions it has already failed."] };
        case "AD_MEET_08":
            return { id: "AD_MEET_08", speaker: "Taren", lines: ["He's been saying that since we were boys.", "I still think he's right."] };
        case "AD_MEET_09":
            return { id: "AD_MEET_09", speaker: "Alden", lines: ["I still think we can do this without becoming them.", "Taren keeps me honest. You always did, both of you."] };
        case "AD_MEET_10":
            return { id: "AD_MEET_10", speaker: "Kael", lines: ["I can't stay for a cause today. I need a lead."] };
        case "AD_MEET_11":
            return { id: "AD_MEET_11", speaker: "Alden", lines: ["Then take the Lower City. If the archives won't open,", "talk to the people who steal from them."] };
        case "AD_MEET_12":
            return { id: "AD_MEET_12", speaker: "Taren", lines: ["We'll come find you again."] };
        case "AD_MEET_13":
            return { id: "AD_MEET_13", speaker: "Alden", lines: ["Do. I'll be here, or I'll be where the work is.", "Be careful at the gates on the way out. Both of you."] };
        case "AD_MEET_R1":
            return { id: "AD_MEET_R1", speaker: "Alden", lines: ["The Lower City first. Then come back and tell me what you found.", "I meant what I said. All of it."] };
        case "SL_ENTER_01":
            return { id: "SL_ENTER_01", speaker: "", lines: ["A low room, salt-crusted lamps, and a bar that has heard", "worse plans than this one."] };
        case "SL_NIM_01":
            return { id: "SL_NIM_01", speaker: "Nim", lines: ["Sit if you want. I don't sell maps to men who haven't", "even looked at the square. Walk first."] };
        case "SL_NIM_02":
            return { id: "SL_NIM_02", speaker: "Nim", lines: ["You're the Greyhaven soldier and the loud captain", "trying not to look loud. Fine. I might have work."] };
        case "SL_NIM_03":
            return { id: "SL_NIM_03", speaker: "Taren", lines: ["We're buying a lead, not a sermon."] };
        case "SL_NIM_04":
            return { id: "SL_NIM_04", speaker: "Nim", lines: ["Then buy this: the Crown seized a scholar's notes", "when he walked out of court. They're in a warehouse down-lane."] };
        case "SL_NIM_05":
            return { id: "SL_NIM_05", speaker: "Nim", lines: ["People say they point at some old Architect sanctuary", "a day's walk from the walls. I don't read. I just hear."] };
        case "SL_NIM_06":
            return { id: "SL_NIM_06", speaker: "Kael", lines: ["That's close enough."] };
        case "SL_NIM_07":
            return { id: "SL_NIM_07", speaker: "Nim", lines: ["You'll need a thief. I don't do locks anymore.", "She does. Lyra — they're paying."] };
        case "SL_LYRA_01":
            return { id: "SL_LYRA_01", speaker: "Lyra", lines: ["I heard \"paying.\" The rest can wait."] };
        case "SL_LYRA_02":
            return { id: "SL_LYRA_02", speaker: "Taren", lines: ["We need those notes. That's the job."] };
        case "SL_LYRA_03":
            return { id: "SL_LYRA_03", speaker: "Lyra", lines: ["A warehouse, a lock, and two men who walk in", "like they still have an army behind them. Cute."] };
        case "SL_LYRA_04":
            return { id: "SL_LYRA_04", speaker: "Kael", lines: ["Can you open it or not?"] };
        case "SL_LYRA_05":
            return { id: "SL_LYRA_05", speaker: "Lyra", lines: ["I can open it. Coin up front for me, finder's cut for Nim.", "I don't work for causes. I work for coin."] };
        case "SL_LYRA_06":
            return { id: "SL_LYRA_06", speaker: "Taren", lines: ["You'll get your coin."] };
        case "SL_LYRA_07":
            return { id: "SL_LYRA_07", speaker: "Lyra", lines: ["Then try to look like you belong in an alley.", "The grim one can stay grim. It's almost a disguise."] };
        case "SL_LYRA_R1":
            return { id: "SL_LYRA_R1", speaker: "Lyra", lines: ["Warehouse first. Compliments later, or never."] };
        case "SL_NIM_R1":
            return { id: "SL_NIM_R1", speaker: "Nim", lines: ["I didn't hear a plan. I heard coin. Go on."] };
        case "SL_PARCEL_01":
            return { id: "SL_PARCEL_01", speaker: "Nim", lines: ["If you're already walking the Merchant District,", "take this parcel to the stall under the blue awning."] };
        case "SL_PARCEL_02":
            return { id: "SL_PARCEL_02", speaker: "SYSTEM", lines: ["Accept?"] };
        case "SL_PARCEL_03_YES":
            return { id: "SL_PARCEL_03_YES", speaker: "Nim", lines: ["No Crown seal. No speeches. Come back for your coin."] };
        case "SL_PARCEL_04_NO":
            return { id: "SL_PARCEL_04_NO", speaker: "Nim", lines: ["Suit yourself. The stall isn't going anywhere."] };
        case "VM_PARCEL_01":
            return { id: "VM_PARCEL_01", speaker: "Stallkeeper", lines: ["That's Nim's hand. I never saw you."] };
        case "VM_PARCEL_02":
            return { id: "VM_PARCEL_02", speaker: "SYSTEM", lines: ["Delivered: Nim's Parcel."] };
        case "SL_PARCEL_05":
            return { id: "SL_PARCEL_05", speaker: "Nim", lines: ["Clean enough. Here."] };
        case "SL_PARCEL_06":
            return { id: "SL_PARCEL_06", speaker: "SYSTEM", lines: ["Obtained: 60 Gold, Antidote x2."] };
        case "LC_HEIST_01":
            return { id: "LC_HEIST_01", speaker: "Lyra", lines: ["Side door. Watch the lane. If someone shouts,", "I was never with you."] };
        case "LC_HEIST_02":
            return { id: "LC_HEIST_02", speaker: "Taren", lines: ["Comforting."] };
        case "LC_HEIST_03":
            return { id: "LC_HEIST_03", speaker: "Lyra", lines: ["I don't do comforting. I do quiet."] };
        case "LC_LOCK_01":
            return { id: "LC_LOCK_01", speaker: "", lines: ["The lock gives under Lyra's picks with an unimpressed click."] };
        case "LC_NOTE_01":
            return { id: "LC_NOTE_01", speaker: "", lines: ["A scholar's hand, hurried. A sketch of a hollow in the hills", "a day's walk from the capital. Architect doors. Still standing."] };
        case "LC_NOTE_02":
            return { id: "LC_NOTE_02", speaker: "", lines: ["\"I will not be at court. If they want the rest,", "they can walk to the sanctuary themselves.\""] };
        case "LC_NOTE_03":
            return { id: "LC_NOTE_03", speaker: "Kael", lines: ["A day's walk. That's a path."] };
        case "LC_NOTE_04":
            return { id: "LC_NOTE_04", speaker: "SYSTEM", lines: ["Obtained: Scholar's Notes (Story Item)."] };
        case "LC_HEIST_04":
            return { id: "LC_HEIST_04", speaker: "Lyra", lines: ["You have your paper. I have my coin coming.", "Let's not die in a hallway about it."] };
        case "LC_BREAK_01":
            return { id: "LC_BREAK_01", speaker: "The Debtman", lines: ["Easy. That's a heavy bag of paper for a light thief."] };
        case "LC_BREAK_02":
            return { id: "LC_BREAK_02", speaker: "Lyra", lines: ["It's a job, not a gift. Walk around."] };
        case "LC_BREAK_03":
            return { id: "LC_BREAK_03", speaker: "The Debtman", lines: ["Someone still wants those notes. And someone still", "wants you reminded what a debt sounds like."] };
        case "LC_BREAK_04":
            return { id: "LC_BREAK_04", speaker: "Taren", lines: ["She's with us."] };
        case "LC_BREAK_05":
            return { id: "LC_BREAK_05", speaker: "Lyra", lines: ["Don't do me favors. We can run, or we can finish this.", "I'm finishing it."] };
        case "DM_INTRO_01":
            return { id: "DM_INTRO_01", speaker: "The Debtman", lines: ["Put the notes down. Walk away lighter than you came.", "That's the generous version."] };
        case "DM_INTRO_02":
            return { id: "DM_INTRO_02", speaker: "Kael", lines: ["We're not putting them down."] };
        case "DM_INTRO_03":
            return { id: "DM_INTRO_03", speaker: "The Debtman", lines: ["Then this is the other version."] };
        case "DM_INTRO_04":
            return { id: "DM_INTRO_04", speaker: "Lyra", lines: ["You want a reminder? Here's one.", "I finish what I take."] };
        case "DM_SYS_01":
            return { id: "DM_SYS_01", speaker: "SYSTEM", lines: ["Lyra Veyne has joined the party.", "She takes the third party slot."] };
        case "DM_SYS_02":
            return { id: "DM_SYS_02", speaker: "SYSTEM", lines: ["Weapon: twin daggers.", "Starting skills: Twin Cut, Open Vein, and Cutthroat (passive)."] };
        case "DM_SYS_03":
            return { id: "DM_SYS_03", speaker: "SYSTEM", lines: ["Twin Cut: two successive dagger hits.", "Open Vein: a strike that applies Bleed."] };
        case "DM_SYS_04":
            return { id: "DM_SYS_04", speaker: "SYSTEM", lines: ["Cutthroat: Lyra's critical hits come more often."] };
        case "DM_SYS_05":
            return { id: "DM_SYS_05", speaker: "SYSTEM", lines: ["Bleed deals damage over time. Some foes shake it off.", "Some don't."] };
        case "DM_PHASE2_01":
            return { id: "DM_PHASE2_01", speaker: "The Debtman", lines: ["Fine. I'll collect it myself."] };
        case "DM_DEFEAT_01":
            return { id: "DM_DEFEAT_01", speaker: "The Debtman", lines: ["Enough. Keep the paper. The debt doesn't go with it."] };
        case "DM_DEFEAT_02":
            return { id: "DM_DEFEAT_02", speaker: "Lyra", lines: ["Tell whoever sent you I finished the job.", "They can bill me when they can find me."] };
        case "DM_DEFEAT_03":
            return { id: "DM_DEFEAT_03", speaker: "The Debtman", lines: ["They can always find you. That's the point."] };
        case "DM_DEFEAT_04":
            return { id: "DM_DEFEAT_04", speaker: "Taren", lines: ["She's walking out with us."] };
        case "DM_DEFEAT_05":
            return { id: "DM_DEFEAT_05", speaker: "The Debtman", lines: ["Then you're in it too. Don't look surprised later."] };
        case "DM_REWARD_01":
            return { id: "DM_REWARD_01", speaker: "SYSTEM", lines: ["The way out is clear. The notes are still in hand."] };
        case "LY_JOIN_01":
            return { id: "LY_JOIN_01", speaker: "Taren", lines: ["You could have run."] };
        case "LY_JOIN_02":
            return { id: "LY_JOIN_02", speaker: "Lyra", lines: ["And died tired in an alley when they caught up.", "I finish jobs. That's how I stay paid, and breathing."] };
        case "LY_JOIN_03":
            return { id: "LY_JOIN_03", speaker: "Kael", lines: ["The notes point at a sanctuary a day from the walls.", "I'm going."] };
        case "LY_JOIN_04":
            return { id: "LY_JOIN_04", speaker: "Lyra", lines: ["Then I'm going as far as that paper goes.", "I'm already on someone's list. Your company is cover."] };
        case "LY_JOIN_05":
            return { id: "LY_JOIN_05", speaker: "Taren", lines: ["We aren't a hiding place."] };
        case "LY_JOIN_06":
            return { id: "LY_JOIN_06", speaker: "Lyra", lines: ["Don't look at me like I signed an oath.", "I signed a job."] };
        case "LY_JOIN_07":
            return { id: "LY_JOIN_07", speaker: "Kael", lines: ["That's enough for today."] };
        case "LY_JOIN_08":
            return { id: "LY_JOIN_08", speaker: "Lyra", lines: ["Good. You can keep the grim. He can keep the speeches.", "I'll keep the knives."] };
        case "LY_JOIN_R1":
            return { id: "LY_JOIN_R1", speaker: "Lyra", lines: ["A day's walk to a pile of Architect doors.", "Try to keep up, both of you."] };
        case "SL_NIM_B1":
            return { id: "SL_NIM_B1", speaker: "Nim", lines: ["I didn't see a fight. I didn't see her leave with you.", "If anyone asks, you drank water and overpaid."] };
        case "LC_HAWKER_B1":
            return { id: "LC_HAWKER_B1", speaker: "Street hawker", lines: ["You're famous for half a night. I'd spend that fame", "on the road, not in my lane."] };
        case "VM_GATE_B1":
            return { id: "VM_GATE_B1", speaker: "Gate Captain", lines: ["Still here. Still not a miracle. If you're leaving,", "leave before I learn a second name for your friend."] };
        case "AD_MEET_B1":
            return { id: "AD_MEET_B1", speaker: "Alden", lines: ["You found a path. I can see it on your faces.", "Go walk it. I'll still be here when you come back."] };
        case "VM_TEMPLE_B1":
            return { id: "VM_TEMPLE_B1", speaker: "Acolyte", lines: ["If you're walking out to old stones, be careful.", "The Ash finds people who dig."] };
        case "LC_NOTE_R1":
            return { id: "LC_NOTE_R1", speaker: "", lines: ["A sanctuary in a hollow, a day's walk from Valemere.", "Architect doors. The writer would not stay at court."] };
        case "LC_NOTE_R2":
            return { id: "LC_NOTE_R2", speaker: "Kael", lines: ["Then that's where we go."] };
        case "VM_WEST_SIGN":
            return { id: "VM_WEST_SIGN", speaker: "", lines: ["West country road. Hills by sundown tomorrow, if you don't linger."] };
        case "VM_HANDOFF_01":
            return { id: "VM_HANDOFF_01", speaker: "Taren", lines: ["A day's walk. Alden will keep. The Crown will not", "get kinder while we're gone."] };
        case "VM_HANDOFF_02":
            return { id: "VM_HANDOFF_02", speaker: "Lyra", lines: ["Then walk. I didn't pull a warehouse job", "to camp under a gate and talk about feelings."] };
        case "VM_HANDOFF_03":
            return { id: "VM_HANDOFF_03", speaker: "Kael", lines: ["We walk."] };
        case "VM_HANDOFF_04":
            return { id: "VM_HANDOFF_04", speaker: "SYSTEM", lines: ["Quest updated: Find the Hollow Sanctuary named in the notes."] };
        case "VM_HANDOFF_05":
            return { id: "VM_HANDOFF_05", speaker: "SYSTEM", lines: ["Chapter 3 — Crowns and Alleys — Complete."] };
        case "VR_WEST_SIGN":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "VR_WEST_SIGN", speaker: "", lines: ["West country road. Hills by sundown tomorrow, if you don't linger."] };
        case "VM_SALT_SIGN":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "VM_SALT_SIGN", speaker: "", lines: ["A lamp above the door, crusted white with salt.", "The Salt Lamp. Questions cost extra."] };
