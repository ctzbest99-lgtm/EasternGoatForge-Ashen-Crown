/// scr_build_old_watchtower(): fills rm_old_watchtower (60x45 tiles, 960x720 px) from embedded data.
/// Call from the room's Creation Code. Generated by src/export.py.
function scr_build_old_watchtower() {
    var _d = scr_old_watchtower_data();
    scr_map_build_from_arrays(_d, 60, 45);
    scr_map_spawn_markers(scr_old_watchtower_markers());
    scr_map_enable_camera(320, 180);
    scr_camera_follow_player();
}

