/// scr_audio — music, ambience and SFX for ASHEN CROWN.
/// Assets are generated by tools/audio (see docs/AUDIO.md) and imported as
/// snd_mus_* / snd_amb_* / snd_sfx_* resources. Every lookup goes through
/// scr_audio_sound() and is guarded, so a missing import plays nothing instead of crashing.
#macro AUDIO_SETTINGS_FILE "ashen_settings.ini"
#macro AUDIO_MASTER_GAIN 1.0
#macro AUDIO_MUSIC_GAIN 0.55
#macro AUDIO_AMB_GAIN 0.30
#macro AUDIO_SFX_GAIN 0.80

/// Create global.audio once. Safe to call any number of times.
function scr_audio_init() {
    if (variable_global_exists("audio_ctx") && is_struct(global.audio_ctx)) return;
    global.audio_ctx = {
        music_key: "",
        music_inst: -1,
        amb_key: "",
        amb_inst: -1,
        sfx_cache: {},
        master: AUDIO_MASTER_GAIN,
        music_gain: AUDIO_MUSIC_GAIN,
        amb_gain: AUDIO_AMB_GAIN,
        sfx_gain: AUDIO_SFX_GAIN,
        muted: false
    };
}

/// Resolve an audio asset by full resource name or short key ("menu_move" -> snd_sfx_menu_move).
/// Returns -1 when the asset is not in the project. Results are cached per key.
function scr_audio_sound(_name) {
    scr_audio_init();
    var _cache = global.audio_ctx.sfx_cache;
    if (variable_struct_exists(_cache, _name)) return _cache[$ _name];
    var _idx = asset_get_index(_name);
    if (!audio_exists(_idx)) _idx = asset_get_index("snd_sfx_" + _name);
    if (!audio_exists(_idx)) _idx = asset_get_index("snd_mus_" + _name);
    if (!audio_exists(_idx)) _idx = asset_get_index("snd_amb_" + _name);
    if (!audio_exists(_idx)) _idx = -1;
    _cache[$ _name] = _idx;
    return _idx;
}

/// Play a one-shot effect. _pitch_var gives each hit a little variation (0 = none).
function scr_audio_sfx(_name, _pitch_var = 0.04, _gain = 1) {
    scr_audio_init();
    var _c = global.audio_ctx;
    if (_c.muted) return -1;
    var _snd = scr_audio_sound(_name);
    if (_snd == -1) return -1;
    var _inst = audio_play_sound(_snd, 5, false);
    if (_inst == -1) return -1;
    audio_sound_gain(_inst, _gain * _c.sfx_gain * _c.master, 0);
    if (_pitch_var > 0) audio_sound_pitch(_inst, 1 + random_range(-_pitch_var, _pitch_var));
    return _inst;
}

/// Switch the looping music track. Keys: "overworld" | "battle" | "boss" | "" (silence).
/// Re-requesting the current track does nothing, so room re-entry never restarts the loop.
function scr_audio_music(_key) {
    scr_audio_init();
    var _c = global.audio_ctx;
    if (_c.music_key == _key) return _c.music_inst;
    if (_c.music_inst != -1) {
        audio_stop_sound(_c.music_inst);
        _c.music_inst = -1;
    }
    _c.music_key = _key;
    if (_key == "" || _c.muted) return -1;
    var _snd = scr_audio_sound("snd_mus_" + _key);
    if (_snd == -1) return -1;
    _c.music_inst = audio_play_sound(_snd, 10, true);
    if (_c.music_inst != -1) audio_sound_gain(_c.music_inst, _c.music_gain * _c.master, 0);
    return _c.music_inst;
}

/// Switch the looping ambience bed. Keys: "wind" | "forest" | "dungeon" | "fire"
/// | "water" | "night" | "" (silence).
function scr_audio_ambience(_key) {
    scr_audio_init();
    var _c = global.audio_ctx;
    if (_c.amb_key == _key) return _c.amb_inst;
    if (_c.amb_inst != -1) {
        audio_stop_sound(_c.amb_inst);
        _c.amb_inst = -1;
    }
    _c.amb_key = _key;
    if (_key == "" || _c.muted) return -1;
    var _snd = scr_audio_sound("snd_amb_" + _key);
    if (_snd == -1) return -1;
    _c.amb_inst = audio_play_sound(_snd, 1, true);
    if (_c.amb_inst != -1) audio_sound_gain(_c.amb_inst, _c.amb_gain * _c.master, 0);
    return _c.amb_inst;
}

function scr_audio_stop_music() { scr_audio_music(""); }
function scr_audio_stop_ambience() { scr_audio_ambience(""); }

/// 0..1 gains for the options menu. _kind: "master" | "music" | "sfx" | "ambience".
function scr_audio_set_gain(_kind, _value) {
    scr_audio_init();
    var _c = global.audio_ctx;
    var _v = clamp(_value, 0, 1);
    switch (_kind) {
        case "master": _c.master = _v; break;
        case "music": _c.music_gain = _v; break;
        case "sfx": _c.sfx_gain = _v; break;
        case "ambience": _c.amb_gain = _v; break;
        default: return;
    }
    if (_c.music_inst != -1) audio_sound_gain(_c.music_inst, _c.music_gain * _c.master, 0);
    if (_c.amb_inst != -1) audio_sound_gain(_c.amb_inst, _c.amb_gain * _c.master, 0);
}

/// Current 0..1 gain for "master" | "music" | "sfx" | "ambience".
function scr_audio_get_gain(_kind) {
    scr_audio_init();
    var _c = global.audio_ctx;
    switch (_kind) {
        case "master":   return _c.master;
        case "music":    return _c.music_gain;
        case "sfx":      return _c.sfx_gain;
        case "ambience": return _c.amb_gain;
    }
    return 0;
}

/// Read the saved gains and mute flag. A missing or unreadable file leaves the
/// compiled-in defaults alone, so the game is never silent on a first run.
function scr_audio_settings_load() {
    scr_audio_init();
    var _c = global.audio_ctx;
    if (!file_exists(AUDIO_SETTINGS_FILE)) return;
    ini_open(AUDIO_SETTINGS_FILE);
    scr_audio_set_gain("master", ini_read_real("audio", "master", _c.master));
    scr_audio_set_gain("music", ini_read_real("audio", "music", _c.music_gain));
    scr_audio_set_gain("sfx", ini_read_real("audio", "sfx", _c.sfx_gain));
    scr_audio_set_gain("ambience", ini_read_real("audio", "ambience", _c.amb_gain));
    var _muted = ini_read_real("audio", "muted", _c.muted ? 1 : 0);
    ini_close();
    scr_audio_mute(_muted >= 1);
}

/// Write the current gains and mute flag. Called by the title Options screen
/// whenever a value changes, so the file never lags the menu behind it.
function scr_audio_settings_save() {
    scr_audio_init();
    var _c = global.audio_ctx;
    ini_open(AUDIO_SETTINGS_FILE);
    ini_write_real("audio", "master", _c.master);
    ini_write_real("audio", "music", _c.music_gain);
    ini_write_real("audio", "sfx", _c.sfx_gain);
    ini_write_real("audio", "ambience", _c.amb_gain);
    ini_write_real("audio", "muted", _c.muted ? 1 : 0);
    ini_close();
}

function scr_audio_mute(_on) {
    scr_audio_init();
    var _c = global.audio_ctx;
    _c.muted = _on;
    if (_on) {
        scr_audio_stop_music();
        scr_audio_stop_ambience();
    }
}

/// Music + ambience for a room. Called from obj_game_controller : Room Start.
/// Room names are compared as strings so unbuilt rooms cannot break the lookup.
function scr_audio_room_enter(_room) {
    scr_audio_init();
    var _name = room_get_name(_room);

    if (_room == BATTLE_ROOM) {
        var _g = global.game;
        var _boss = false;
        if (variable_struct_exists(_g, "pending_battle") && is_struct(_g.pending_battle)) {
            var _pb = _g.pending_battle;
            if (variable_struct_exists(_pb, "boss_index") && _pb.boss_index >= 0) _boss = true;
        }
        scr_audio_music(_boss ? "boss" : "battle");
        scr_audio_ambience("");
        return;
    }
    if (_room == TITLE_ROOM) {
        scr_audio_music("overworld");
        scr_audio_ambience("");
        return;
    }

    scr_audio_music("overworld");

    var _amb = "";
    switch (_name) {
        case "rm_overworld":        _amb = "wind"; break;
        case "rm_millhaven_road":   _amb = "wind"; break;
        case "rm_valemere_road":    _amb = "wind"; break;
        case "rm_valemere":         _amb = "wind"; break;
        case "rm_wrenfield":        _amb = "forest"; break;
        case "rm_hollow_approach":  _amb = "wind"; break;
        case "rm_blackwood_garrison": _amb = "forest"; break;
        case "rm_blackwood_deep":   _amb = "forest"; break;
        case "rm_blackwood_hollow": _amb = "fire"; break;
        case "rm_old_watchtower":   _amb = "wind"; break;
        case "rm_watchtower_basement": _amb = "dungeon"; break;
        case "rm_warehouse":        _amb = "dungeon"; break;
        case "rm_hollow_sanctuary": _amb = "dungeon"; break;
        case "rm_greyhaven_chapel": _amb = "dungeon"; break;
        case "rm_greyhaven_tavern": _amb = "fire"; break;
        case "rm_greyhaven_blacksmith": _amb = "fire"; break;
        case "rm_greyhaven_varyn_house": _amb = "fire"; break;
        case "rm_wrenfield_bent_post": _amb = "fire"; break;
        case "rm_salt_lamp":        _amb = "fire"; break;
        case "rm_garrison_keep":    _amb = "fire"; break;
        default:                    _amb = "";
    }
    scr_audio_ambience(_amb);
}

/// One cue per resolved skill. Called by obj_battle_controller.run_skill just before the
/// clip starts, so the sound lands with the animation rather than with the command.
function scr_audio_skill_cue(_sk, _hit, _side, _actor_id = "") {
    if (!is_struct(_sk) || !is_struct(_hit)) return;
    var _effect = variable_struct_exists(_sk, "effect") ? _sk.effect : "";
    var _crit = false;
    if (is_array(_hit.targets)) {
        for (var _i = 0; _i < array_length(_hit.targets); _i++) {
            if (is_struct(_hit.targets[_i]) && variable_struct_exists(_hit.targets[_i], "crit")
                && _hit.targets[_i].crit) _crit = true;
        }
    }
    switch (_effect) {
        case "damage":
        case "steal":
            // Ranged release: the Ashbound Hunter shoots a bow, the Crossbowman's Bolt is a bolt.
            // Everything else swings.
            var _ranged = (_actor_id == "ashbound_hunter")
                || (variable_struct_exists(_sk, "id") && _sk.id == "crossbow_bolt");
            if (_ranged) scr_audio_sfx("arrow", 0.05, 0.85);
            else if (variable_struct_exists(_sk, "id") && _sk.id == "attack") scr_audio_sfx("attack_swing", 0.06, 0.9);
            scr_audio_sfx(_crit ? "hit_crit" : "hit", 0.06, _crit ? 1 : 0.85);
            break;
        case "heal":
            scr_audio_sfx("heal", 0.02);
            break;
        case "status":
            scr_audio_sfx("cast", 0.04, 0.8);
            break;
        default:
            scr_audio_sfx("cast", 0.04, 0.7);
    }
}
