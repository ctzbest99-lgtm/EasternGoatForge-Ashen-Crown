/// scr_wf_markers_data: marker tables for the Chapter 2 rooms (generated by wrenfield/src/export_wf.py, do not hand-edit).
/// Extra keys used here: show_if_flag / hide_if_flag (state filter, see scr_wf_filter_markers), sprite (suggested sprite asset),
/// type "extra" (silent background NPC: crowd, guards). Everything else follows Zone 1.

/// scr_millhaven_road_markers() -> array of marker structs. Millhaven Road: signpost, Crown notice, traveler (hook), Architect stones, Crown patrol (32x60 tiles).
function scr_millhaven_road_markers() {
    return [
        { type: "sign", name: "mr_signpost", tile_x: 18, tile_y: 4, x: 296, y: 80, sign_tile: "signpost3", script_id: "MR_SIGN_01", text: "Wrenfield. Millhaven beyond. Valemere by the west road.", lines: ["Wrenfield. Millhaven beyond. Valemere by the west road."], struck_lines: [] },
        { type: "sign", name: "mr_crown_notice", tile_x: 12, tile_y: 16, x: 200, y: 272, sign_tile: "crown_notice", script_id: "MR_NOTICE_01", sets_flag: "flag_hook_taren", text: "By order of the Reeve at Wrenfield: those who aid the rebellion will hang. Public judgment at midday.", lines: ["By order of the Reeve at Wrenfield: those who aid the rebellion", "will hang. Public judgment at midday."], struck_lines: [], note: "Backup hook: reading it also sets flag_hook_taren (advance Q_BV_S1 -> Q_BV_S2 if still active)." },
        { type: "player_spawn", name: "from_overworld", tile_x: 16, tile_y: 1, x: 264, y: 32, facing: "down", note: "Arrive here from the overworld entrance millhaven_road." },
        { type: "zone_exit", name: "to_overworld", tile_x: 15, tile_y: 0, x: 248, y: 16, target_room: "rm_overworld", target_spawn: "millhaven_road", w: 3, h: 1 },
        { type: "player_spawn", name: "from_wrenfield", tile_x: 16, tile_y: 57, x: 264, y: 928, facing: "up", note: "Arrive here walking back out of Wrenfield by the north checkpoint." },
        { type: "zone_exit", name: "to_wrenfield", tile_x: 15, tile_y: 59, x: 248, y: 960, target_room: "rm_wrenfield", target_spawn: "from_millhaven_road", w: 3, h: 1 },
        { type: "story", name: "mr_enter", tile_x: 16, tile_y: 3, x: 264, y: 64, trigger: "on_enter_once", script_id: "MR_ENTER_01", story_flag: "flag_mr_entered", rect_px: [208, 32, 320, 64], note: "Kael's road line on first entry." },
        { type: "npc", name: "traveler", tile_x: 14, tile_y: 10, x: 232, y: 176, npc_id: "traveler", speaker: "Traveler", script_id: "MR_HOOK_01", script_chain: ["MR_HOOK_01", "MR_HOOK_02", "MR_HOOK_03", "MR_HOOK_04", "MR_HOOK_05"], sprite: "spr_traveler_ow16_idle_up", hostile: false, repeat_script_id: "MR_HOOK_R1", sets_flag: "flag_hook_taren", facing: "up", note: "Walking north (toward the overworld) on the first stretch. Hook: sets flag_hook_taren; complete Q_BV_S1 if active, start Q_BV_S2. Faces up; turns to the player when spoken to." },
        { type: "lore", name: "architect_stones", tile_x: 10, tile_y: 29, x: 168, y: 480, script_id: "MR_STONE_01", script_chain: ["MR_STONE_01", "MR_STONE_02"], lines: ["Old stones half-sunk in the grass. Architect work, if Kael had to guess.", "The carvings are too worn to read."], struck_lines: [], note: "MR_STONE_01 (narration) then MR_STONE_02 (Kael)." },
        { type: "encounter", name: "mr_crown_patrol", tile_x: 17, tile_y: 41, x: 280, y: 672, enemy_id: "crown_patrolman", fallback_enemy_id: "bandit", encounter_id: "enc_crown_patrol", hostile: true, avoidable: true, once: true, script_id: "MR_PATROL_01", script_chain: ["MR_PATROL_01", "MR_PATROL_02", "MR_PATROL_03"], sprite: "spr_crown_soldier_firm_ow16_idle_up", escort_sprite: "spr_crown_soldier_unwilling_ow16_idle_up", note: "Optional scripted patrol on the road (two Crown soldiers: one firm, one unwilling). Can be walked around through the grass or fought (enc_crown_patrol). Human soldiers, not Ash-corrupted." },
        { type: "extra", name: "mr_patrol_escort", tile_x: 18, tile_y: 41, x: 296, y: 672, sprite: "spr_crown_soldier_unwilling_ow16_idle_up", note: "Second patrol soldier (the unwilling one). Part of mr_crown_patrol; remove with it." },
        { type: "encounter_zone", name: "millhaven_road", tile_x: 3, tile_y: 18, x: 56, y: 304, table_id: "ch2_millhaven_road", fallback_table_id: "zone01_path", enemy_table: [{ enemy_id: "crown_patrolman", weight: 3 }, { enemy_id: "crown_crossbowman", weight: 1 }, { enemy_id: "bandit", weight: 2 }, { enemy_id: "ash_wolf", weight: 2 }], rect_px: [48, 288, 464, 896], enemies: "Crown Patrols (human), Bandits, Ash Wolves", levels: "8-10" }
    ];
}

/// scr_wrenfield_markers() -> array of marker structs. Wrenfield: checkpoints, the square and the gallows, The Bent Post, Len's store, the west road (56x44 tiles).
function scr_wrenfield_markers() {
    return [
        { type: "player_spawn", name: "from_millhaven_road", tile_x: 12, tile_y: 1, x: 200, y: 32, facing: "down", note: "Arrive from rm_millhaven_road (south exit)." },
        { type: "player_spawn", name: "from_valemere_road", tile_x: 2, tile_y: 27, x: 40, y: 448, facing: "right", note: "Arrive from rm_valemere_road at the west road mouth (west_road_to_valemere is tile 0,27)." },
        { type: "zone_exit", name: "to_millhaven_road", tile_x: 11, tile_y: 0, x: 184, y: 16, target_room: "rm_millhaven_road", target_spawn: "from_wrenfield", w: 3, h: 1 },
        { type: "story", name: "wf_enter", tile_x: 12, tile_y: 2, x: 200, y: 48, trigger: "on_enter_once", story_flag: "flag_wrenfield_entered", rect_px: [160, 16, 240, 48], note: "Sets flag_wrenfield_entered on first entry (no line)." },
        { type: "story", name: "wf_gate", tile_x: 12, tile_y: 5, x: 200, y: 96, trigger: "on_enter_once", script_id: "WF_GATE_01", script_chain: ["WF_GATE_01", "WF_GATE_02", "WF_GATE_03"], story_flag: "flag_wf_gate_seen", rect_px: [160, 80, 240, 96], speaker_npc: "crown_sergeant_gate", hide_if_flag: "flag_execution_stopped", note: "The sergeant stops Kael at the checkpoint gap the first time through." },
        { type: "npc", name: "crown_sergeant", tile_x: 13, tile_y: 6, x: 216, y: 112, npc_id: "crown_sergeant", speaker: "Crown Sergeant", script_id: "WF_GATE_A1", script_chain: ["WF_GATE_A1"], sprite: "spr_crown_sergeant_gate_ow16_idle_left", hostile: false, hide_if_flag: "flag_execution_stopped", note: "North checkpoint. Repeat line before the rescue." },
        { type: "npc", name: "crown_sergeant_after", tile_x: 13, tile_y: 6, x: 216, y: 112, npc_id: "crown_sergeant", speaker: "Crown Sergeant", script_id: "WF_GATE_B1", script_chain: ["WF_GATE_B1"], sprite: "spr_crown_sergeant_gate_ow16_idle_left", hostile: false, show_if_flag: "flag_execution_stopped", note: "Same man, same post, after the rescue." },
        { type: "sign", name: "wf_posted_list", tile_x: 14, tile_y: 9, x: 232, y: 160, sign_tile: "notice_board", script_id: "WF_NOTICE_01", text: "A list of the accused, nailed to the post. \"Aiding the Broken Yoke.\" Four names. One of them is Bram.", lines: ["A list of the accused, nailed to the post. \"Aiding the Broken Yoke.\"", "Four names. One of them is Bram."], struck_lines: [] },
        { type: "extra", name: "checkpoint_guard_north", tile_x: 10, tile_y: 6, x: 168, y: 112, sprite: "spr_crown_soldier_firm_ow16_idle_down", hide_if_flag: "flag_execution_stopped", note: "Extra checkpoint guard (no lines). Spawn as a plain blocking NPC if you want the gap to feel watched." },
        { type: "story", name: "wf_gallows", tile_x: 28, tile_y: 18, x: 456, y: 304, trigger: "on_enter_once", script_id: "WF_GALLOWS_01", script_chain: ["WF_GALLOWS_01", "WF_GALLOWS_02", "WF_GALLOWS_03", "WF_GALLOWS_04", "WF_GALLOWS_05", "WF_GALLOWS_06", "WF_GALLOWS_07", "WF_GALLOWS_08"], story_flag: "flag_close_call", then_script: "WF_CALDER_INTRO_01", battle: "enc_reeve_calder", rect_px: [256, 272, 656, 368], hide_if_flag: "flag_execution_stopped", note: "Walking into the crowd in front of the scaffold starts WF_GALLOWS. After WF_GALLOWS_06: Kael and Taren reach the right-hand gallows; swap gallows_taut for gallows_cut (patch below) and Bram to spr_bram_bound_ow16_idle_down when the rope parts (WF_GALLOWS_07). Then WF_CALDER_INTRO and enc_reeve_calder (Taren joins at battle start). After WF_CALDER_DEFEAT set flag_execution_stopped and rebuild the room." },
        { type: "story_npc", name: "prisoner_a", tile_x: 26, tile_y: 14, x: 424, y: 240, npc_id: "prisoner_a", sprite: "spr_prisoner_a_ow16_idle_down", story_flag: "flag_execution_stopped", hostile: false, on_solid_ok: true, hide_if_flag: "flag_execution_stopped", note: "Bound on the scaffold. Left-hand gallows." },
        { type: "story_npc", name: "prisoner_b", tile_x: 27, tile_y: 14, x: 440, y: 240, npc_id: "prisoner_b", sprite: "spr_prisoner_b_ow16_idle_down", story_flag: "flag_execution_stopped", hostile: false, on_solid_ok: true, hide_if_flag: "flag_execution_stopped", note: "Bound on the scaffold. Left-hand gallows." },
        { type: "story_npc", name: "prisoner_c", tile_x: 30, tile_y: 14, x: 488, y: 240, npc_id: "prisoner_c", sprite: "spr_prisoner_c_ow16_idle_down", story_flag: "flag_execution_stopped", hostile: false, on_solid_ok: true, hide_if_flag: "flag_execution_stopped", note: "Bound on the scaffold. Right-hand gallows." },
        { type: "story_npc", name: "bram_noosed", tile_x: 31, tile_y: 14, x: 504, y: 240, npc_id: "bram", sprite: "spr_bram_bound_ow16_noose_taut_strip2", story_flag: "flag_execution_stopped", hostile: false, on_solid_ok: true, hide_if_flag: "flag_execution_stopped", note: "Bound on the scaffold. Right-hand gallows, the right-most place: \"the tall one, on the right\". His sprite carries the taut rope up to the gallows_taut rope end (lines up when he stands on this tile with origin (8,23)). Animate the 2-frame tiptoe at ~2 fps." },
        { type: "story_npc", name: "reeve_calder", tile_x: 28, tile_y: 15, x: 456, y: 256, npc_id: "reeve_calder", sprite: "spr_reeve_calder_ow16_idle_down", script_id: "WF_GALLOWS_01", story_flag: "flag_execution_stopped", hostile: false, hide_if_flag: "flag_execution_stopped", note: "Reading the sentence at the front of the scaffold. Boss: enc_reeve_calder." },
        { type: "story_npc", name: "taren", tile_x: 31, tile_y: 18, x: 504, y: 304, npc_id: "taren", sprite: "spr_taren_ow16_idle_up", script_id: "WF_GALLOWS_03", story_flag: "flag_taren_in_battle", hostile: false, hide_if_flag: "flag_execution_stopped", note: "Taren Holt in the crowd, bastard sword out, working toward the right-hand gallows." },
        { type: "npc", name: "oda", tile_x: 22, tile_y: 21, x: 360, y: 352, npc_id: "oda", speaker: "Oda", script_id: "WF_ODA_A1", script_chain: ["WF_ODA_A1", "WF_ODA_A2"], sprite: "spr_oda_ow16_idle_up", hostile: false, hide_if_flag: "flag_execution_stopped", choice: { yes: "WF_ODA_A3_YES", no: "WF_ODA_A4_NO" }, quest_start: "Q_SIDE_ODA", facing: "up", note: "In the crowd, side-quest giver. Talk to her before walking into the gallows trigger (the trigger rect starts one row south of her)." },
        { type: "extra", name: "crowd_1", tile_x: 19, tile_y: 19, x: 312, y: 320, sprite: "spr_villager_a_ow16_idle_up", hide_if_flag: "flag_execution_stopped", note: "Silent crowd (no lines). Plain blocking NPC." },
        { type: "extra", name: "crowd_2", tile_x: 24, tile_y: 19, x: 392, y: 320, sprite: "spr_villager_b_ow16_idle_up", hide_if_flag: "flag_execution_stopped", note: "Silent crowd (no lines). Plain blocking NPC." },
        { type: "extra", name: "crowd_3", tile_x: 26, tile_y: 21, x: 424, y: 352, sprite: "spr_villager_a_ow16_idle_up", hide_if_flag: "flag_execution_stopped", note: "Silent crowd (no lines). Plain blocking NPC." },
        { type: "extra", name: "crowd_4", tile_x: 33, tile_y: 20, x: 536, y: 336, sprite: "spr_villager_b_ow16_idle_up", hide_if_flag: "flag_execution_stopped", note: "Silent crowd (no lines). Plain blocking NPC." },
        { type: "extra", name: "crowd_5", tile_x: 35, tile_y: 19, x: 568, y: 320, sprite: "spr_villager_a_ow16_idle_up", hide_if_flag: "flag_execution_stopped", note: "Silent crowd (no lines). Plain blocking NPC." },
        { type: "extra", name: "crowd_6", tile_x: 37, tile_y: 21, x: 600, y: 352, sprite: "spr_villager_b_ow16_idle_up", hide_if_flag: "flag_execution_stopped", note: "Silent crowd (no lines). Plain blocking NPC." },
        { type: "extra", name: "crowd_7", tile_x: 30, tile_y: 22, x: 488, y: 368, sprite: "spr_villager_a_ow16_idle_up", hide_if_flag: "flag_execution_stopped", note: "Silent crowd (no lines). Plain blocking NPC." },
        { type: "extra", name: "crowd_8", tile_x: 20, tile_y: 22, x: 328, y: 368, sprite: "spr_villager_b_ow16_idle_right", hide_if_flag: "flag_execution_stopped", note: "Silent crowd (no lines). Plain blocking NPC." },
        { type: "npc", name: "soldier_unwilling", tile_x: 18, tile_y: 16, x: 296, y: 272, npc_id: "crown_soldier_unwilling", speaker: "Crown Soldier", script_id: "WF_SOLDIER_A1", script_chain: ["WF_SOLDIER_A1"], sprite: "spr_crown_soldier_unwilling_ow16_idle_right", hostile: false, hide_if_flag: "flag_execution_stopped", note: "Unwilling, on the edge of the square." },
        { type: "npc", name: "soldier_firm", tile_x: 39, tile_y: 17, x: 632, y: 288, npc_id: "crown_soldier_firm", speaker: "Crown Soldier", script_id: "WF_SOLDIER_A2", script_chain: ["WF_SOLDIER_A2"], sprite: "spr_crown_soldier_firm_ow16_idle_left", hostile: false, hide_if_flag: "flag_execution_stopped", note: "The firmer one, other side of the square." },
        { type: "extra", name: "scaffold_guard_23", tile_x: 23, tile_y: 15, x: 376, y: 256, sprite: "spr_crown_soldier_firm_ow16_idle_down", hide_if_flag: "flag_execution_stopped", note: "Calder's detachment (no lines). They are the 2-3 Crown Soldiers in enc_reeve_calder." },
        { type: "extra", name: "scaffold_guard_34", tile_x: 34, tile_y: 15, x: 552, y: 256, sprite: "spr_crown_soldier_firm_ow16_idle_down", hide_if_flag: "flag_execution_stopped", note: "Calder's detachment (no lines). They are the 2-3 Crown Soldiers in enc_reeve_calder." },
        { type: "npc", name: "len_outside", tile_x: 47, tile_y: 16, x: 760, y: 272, npc_id: "len", speaker: "Len", script_id: "WF_STORE_A1", script_chain: ["WF_STORE_A1"], sprite: "spr_len_ow16_idle_down", hostile: false, hide_if_flag: "flag_execution_stopped", note: "Standing in front of his own shutters." },
        { type: "barrier", name: "store_door_shut", tile_x: 46, tile_y: 15, x: 744, y: 256, requires_flag: "flag_execution_stopped", w: 1, h: 1, script_id: "WF_STORE_SHUT", lines: ["Shuttered and barred. Len isn't selling today."], struck_lines: [], written_by: "art pass (placeholder, not in the script)", note: "Store door is shut until the rescue." },
        { type: "npc", name: "oda_after", tile_x: 21, tile_y: 24, x: 344, y: 400, npc_id: "oda", speaker: "Oda", script_id: "WF_ODA_B1", script_chain: ["WF_ODA_B1", "WF_ODA_B2"], sprite: "spr_oda_ow16_idle_right", hostile: false, show_if_flag: "flag_execution_stopped", quest_turn_in: "Q_SIDE_ODA", reward: ["Minor Potion x2", "40 Gold"], sets_flag: "flag_oda_done", note: "Turn-in. If never spoken to before, start and finish here in one talk." },
        { type: "npc", name: "bram", tile_x: 22, tile_y: 24, x: 360, y: 400, npc_id: "bram", speaker: "Bram", script_id: "WF_ODA_B3", script_chain: ["WF_ODA_B3"], sprite: "spr_bram_ow16_rub_neck_strip2", hostile: false, examine_script_id: "WF_BRAM_B1", show_if_flag: "flag_execution_stopped", note: "Freed, sitting up beside his sister; rubs the rope mark (2-frame strip). Optional line, or WF_BRAM_B1 narration if examined." },
        { type: "npc", name: "soldier_unwilling_after", tile_x: 10, tile_y: 7, x: 168, y: 128, npc_id: "crown_soldier_unwilling", speaker: "Crown Soldier", script_id: "WF_SOLDIER_B1", script_chain: ["WF_SOLDIER_B1"], sprite: "spr_crown_soldier_unwilling_ow16_idle_down", hostile: false, show_if_flag: "flag_execution_stopped", note: "Pulled back to the north checkpoint." },
        { type: "npc", name: "soldier_firm_after", tile_x: 10, tile_y: 27, x: 168, y: 448, npc_id: "crown_soldier_firm", speaker: "Crown Soldier", script_id: "WF_SOLDIER_B2", script_chain: ["WF_SOLDIER_B2"], sprite: "spr_crown_soldier_firm_ow16_idle_right", hostile: false, show_if_flag: "flag_execution_stopped", note: "Pulled back to Calder's west checkpoint." },
        { type: "extra", name: "crowd_after_1", tile_x: 30, tile_y: 19, x: 488, y: 320, sprite: "spr_villager_a_ow16_idle_up", show_if_flag: "flag_execution_stopped", note: "Villagers lingering by the empty gallows (no lines). Relieved, still afraid." },
        { type: "extra", name: "crowd_after_2", tile_x: 25, tile_y: 21, x: 408, y: 352, sprite: "spr_villager_b_ow16_idle_up", show_if_flag: "flag_execution_stopped", note: "Villagers lingering by the empty gallows (no lines). Relieved, still afraid." },
        { type: "extra", name: "crowd_after_3", tile_x: 35, tile_y: 24, x: 568, y: 400, sprite: "spr_villager_a_ow16_idle_left", show_if_flag: "flag_execution_stopped", note: "Villagers lingering by the empty gallows (no lines). Relieved, still afraid." },
        { type: "extra", name: "crowd_after_4", tile_x: 34, tile_y: 27, x: 552, y: 448, sprite: "spr_villager_b_ow16_idle_right", show_if_flag: "flag_execution_stopped", note: "Villagers lingering by the empty gallows (no lines). Relieved, still afraid." },
        { type: "extra", name: "west_guard_9", tile_x: 9, tile_y: 29, x: 152, y: 480, sprite: "spr_crown_soldier_firm_ow16_idle_right", show_if_flag: "flag_execution_stopped", note: "West checkpoint guard (no lines)." },
        { type: "extra", name: "west_guard_12", tile_x: 12, tile_y: 30, x: 200, y: 496, sprite: "spr_crown_soldier_firm_ow16_idle_right", show_if_flag: "flag_execution_stopped", note: "West checkpoint guard (no lines)." },
        { type: "entrance", name: "door_bent_post", tile_x: 5, tile_y: 16, x: 88, y: 272, target_room: "rm_wrenfield_bent_post", target_spawn: "from_wrenfield", status: "built", note: "The Bent Post (inn). Closed before the rescue (chairs up, cold hearth), open after." },
        { type: "player_spawn", name: "from_bent_post", tile_x: 5, tile_y: 17, x: 88, y: 288, facing: "down" },
        { type: "entrance", name: "door_len_store", tile_x: 46, tile_y: 15, x: 744, y: 256, target_room: "rm_wrenfield_store", target_spawn: "from_wrenfield", status: "built", show_if_flag: "flag_execution_stopped", note: "Len's store. Only enterable after the rescue (store_door_shut blocks it before)." },
        { type: "player_spawn", name: "from_store", tile_x: 46, tile_y: 16, x: 744, y: 272, facing: "down" },
        { type: "sign", name: "wf_west_sign", tile_x: 4, tile_y: 27, x: 72, y: 448, sign_tile: "signpost_west", script_id: "WF_WEST_SIGN", text: "West: Valemere. The capital road.", lines: ["West: Valemere. The capital road."], struck_lines: [] },
        { type: "barrier", name: "west_road_closed", tile_x: 0, tile_y: 27, x: 8, y: 448, requires_flag: "flag_taren_recruited", w: 1, h: 3, script_id: "WF_WEST_LOCKED", lines: ["Crown checkpoint. West road closed by order of the Reeve."], struck_lines: [], written_by: "art pass (placeholder, not in the script)", note: "Safety net so Chapter 2 cannot end before the rescue and the join talk." },
        { type: "zone_exit", name: "west_road_to_valemere", tile_x: 0, tile_y: 27, x: 8, y: 448, target_room: "rm_valemere_road", target_spawn: "from_wrenfield", status: "built", fallback_room: "rm_overworld", fallback_spawn: "from_wrenfield_west", w: 1, h: 3, script_id: "WF_HANDOFF_01", script_chain: ["WF_HANDOFF_01", "WF_HANDOFF_02", "WF_HANDOFF_03", "WF_HANDOFF_SYS_01"], sets_flag: "flag_chapter2_complete", note: "Ends Chapter 2: handoff lines and the chapter-complete screen, then rm_valemere_road (built in Chapter 3). fallback_room / fallback_spawn are only a safety net if that room ever goes missing. No Fallen Knight here." },
        { type: "location", name: "west_checkpoint", tile_x: 9, tile_y: 28, x: 152, y: 464, note: "Calder's remaining checkpoint on the west road (\"a checkpoint on the west road\")." },
        { type: "location", name: "north_checkpoint", tile_x: 12, tile_y: 5, x: 200, y: 96, note: "Checkpoint on the road in from the Millhaven Road." }
    ];
}

/// scr_wrenfield_bent_post_markers() -> array of marker structs. The Bent Post inn: closed (chairs up, cold hearth, shutters) before the rescue, open after (24x16 tiles).
function scr_wrenfield_bent_post_markers() {
    return [
        { type: "player_spawn", name: "from_wrenfield", tile_x: 11, tile_y: 12, x: 184, y: 208, facing: "up", note: "Arrive from the Wrenfield door_bent_post." },
        { type: "zone_exit", name: "to_wrenfield", tile_x: 11, tile_y: 13, x: 184, y: 224, target_room: "rm_wrenfield", target_spawn: "from_bent_post", w: 2, h: 1 },
        // Added in-repo 2026-11-15 (owner decision: save crystals in towns with a church or a tavern).
        // wrenfield/src/export_wf.py is not in this repo, so keep this row if the file is ever regenerated.
        // Tile (4,9) is open floor by the west wall in both states: collision row 9 is 0 at x=4, and the
        // open patch's collision changes (5/7/9/11,8, 17,9, 5/7,11, 14/16,12) never touch this tile.
        { type: "save_point", name: "bent_post_save", tile_x: 4, tile_y: 9, x: 72, y: 160, note: "Save crystal in the Bent Post. Audited 2026-11-15: open floor, clear of decor, reachable from the door in both the closed and open states." },
        { type: "npc", name: "perrin", tile_x: 15, tile_y: 4, x: 248, y: 80, npc_id: "perrin", speaker: "Perrin", script_id: "WF_TAVERN_A1", script_chain: ["WF_TAVERN_A1", "WF_TAVERN_A2", "WF_TAVERN_A3"], sprite: "spr_perrin_ow16_idle_down", hostile: false, hide_if_flag: "flag_execution_stopped", note: "Behind the bar, chairs still up on the tables. The bar is closed." },
        { type: "npc", name: "perrin_after", tile_x: 15, tile_y: 4, x: 248, y: 80, npc_id: "perrin", speaker: "Perrin", script_id: "WF_TAVERN_B1", sprite: "spr_perrin_ow16_idle_down", hostile: false, inn_rest: true, rest_price: "first night free (placeholder)", show_if_flag: "flag_execution_stopped", note: "Bar open. Optional inn rest point (WF_TAVERN_B1 stage note). Price is for Coder/Design." },
        { type: "lore", name: "bent_post_notice", tile_x: 11, tile_y: 2, x: 184, y: 48, script_id: "WF_TAVERN_NOTICE", written_by: "art pass (placeholder, not in the script)", lines: ["Chalked on a board: \"Rooms upstairs. Ask Perrin.\""], struck_lines: [] }
    ];
}

