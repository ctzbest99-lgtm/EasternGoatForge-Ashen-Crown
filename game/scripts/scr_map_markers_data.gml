        { type: "story_npc", name: "fallen_knight_story_1", tile_x: 173, tile_y: 136, x: 2776, y: 2192, npc_id: "fallen_knight_story", script_id: "FK_01", story_flag: "flag_fk_seen_1", hostile: false, note: "Unnamed Fallen Knight (never fights). Stands motionless at the Abandoned Bandit Camp's north exit, says FK_01, then walks into the trees toward the Watchtower. Not the hostile fallen_knight enemy." },
        { type: "enemy_spawn", name: "fallen_knight_elite_camp", tile_x: 176, tile_y: 144, x: 2824, y: 2320, enemy_id: "fallen_knight", encounter_id: "zone01_bandit_camp_fallen_knight", group_size: 1, hostile: true, elite: true, note: "Elite Fallen Knight (hostile). Belongs at the Bandit Camp and the Watchtower only." },
