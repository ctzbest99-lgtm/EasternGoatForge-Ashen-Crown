        { type: "sign", name: "sign_north_gate", tile_x: 202, tile_y: 167, x: 3240, y: 2688, sign_tile: "signpost", text: "North Gate. Keep it barred after dark.", lines: ["North Gate. Keep it barred after dark."], struck_lines: [] },
        { type: "sign", name: "sign_hunters_camp", tile_x: 227, tile_y: 164, x: 3640, y: 2640, sign_tile: "signpost", text: "Hunter's Camp. Wolves thick this season — ask for Renn.", lines: ["Hunter's Camp. Wolves thick this season — ask for Renn."], struck_lines: [] },
        { type: "sign", name: "sign_old_road", tile_x: 202, tile_y: 159, x: 3240, y: 2560, sign_tile: "signpost_weathered", text: "Old Road. Travel in daylight. Crown Patrol", lines: ["Old Road. Travel in daylight. Crown Patrol"], struck_lines: [], weathered: true },
        { type: "sign", name: "sign_bandit_camp", tile_x: 178, tile_y: 139, x: 2856, y: 2240, sign_tile: "signpost", text: "Turn back. This is our road now.", lines: ["Turn back.", "This is our road now."], struck_lines: [1], note: "Line index 1 is crossed out (struck through) on the sign." },
        { type: "sign", name: "sign_watchtower", tile_x: 202, tile_y: 131, x: 3240, y: 2112, sign_tile: "signpost", text: "Old Watchtower. Property of the Crown. Closed by order.", lines: ["Old Watchtower. Property of the Crown. Closed by order."], struck_lines: [] },
