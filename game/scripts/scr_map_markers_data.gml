/// scr_map_markers_data: marker tables for rm_overworld, rm_old_watchtower and the Chapter 1 rooms (generated, do not hand-edit).

/// scr_overworld_markers() -> array of marker structs. ASHEN CROWN overworld hub (400x300 tiles).
/// Generated by src/export.py from the matching *_markers.json. x/y are pixels (feet: bottom-centre of the tile).
function scr_overworld_markers() {
    return [
        { type: "player_spawn", name: "player_start", tile_x: 199, tile_y: 186, x: 3192, y: 2992, facing: "up", script_id: "GH_ARRIVAL", story_flag: "flag_arrived_greyhaven", quest_start: "Q_MAIN_FIND_MIRA", note: "Opening (GH_ARRIVAL): the south road outside Greyhaven. Kael walks in alone." },
        { type: "entrance", name: "door_varyn_house", tile_x: 184, tile_y: 169, x: 2952, y: 2720, target_room: "rm_greyhaven_varyn_house", target_spawn: "from_overworld", status: "built", area: "greyhaven", note: "Doorway into rm_greyhaven_varyn_house (interior, burnt). The interior exit returns here." },
        { type: "entrance", name: "door_rusted_boar_tavern", tile_x: 209, tile_y: 169, x: 3352, y: 2720, target_room: "rm_greyhaven_tavern", target_spawn: "from_overworld", status: "built", area: "greyhaven", note: "Doorway into rm_greyhaven_tavern (interior, burnt). The interior exit returns here." },
        { type: "entrance", name: "door_greyhaven_chapel", tile_x: 189, tile_y: 177, x: 3032, y: 2848, target_room: "rm_greyhaven_chapel", target_spawn: "from_overworld", status: "built", area: "greyhaven", note: "Doorway into rm_greyhaven_chapel (interior, burnt). The interior exit returns here." },
        { type: "entrance", name: "door_blacksmith", tile_x: 209, tile_y: 178, x: 3352, y: 2864, target_room: "rm_greyhaven_blacksmith", target_spawn: "from_overworld", status: "built", area: "greyhaven", note: "Doorway into rm_greyhaven_blacksmith (interior, burnt). The interior exit returns here." },
        { type: "entrance", name: "door_general_store", tile_x: 215, tile_y: 172, x: 3448, y: 2768, target_room: "rm_greyhaven_general_store", target_spawn: "from_overworld", status: "built", area: "greyhaven", note: "Doorway into rm_greyhaven_general_store (interior, burnt). The interior exit returns here." },
        { type: "npc", name: "old_wenna", tile_x: 197, tile_y: 177, x: 3160, y: 2848, npc_id: "old_wenna", speaker: "Old Wenna", script_id: "GH_SQUARE_01", script_chain: ["GH_SQUARE_01"], hostile: false, area: "greyhaven", note: "Town Square survivor, by the well." },
        { type: "npc", name: "dov", tile_x: 201, tile_y: 177, x: 3224, y: 2848, npc_id: "dov", speaker: "Dov", script_id: "GH_SQUARE_02", script_chain: ["GH_SQUARE_02", "GH_SQUARE_03", "GH_SQUARE_04"], hostile: false, area: "greyhaven", note: "A boy about Mira's age. Hints at the passage under the town (location stays open)." },
        { type: "npc", name: "corwin", tile_x: 197, tile_y: 166, x: 3160, y: 2672, npc_id: "corwin", speaker: "Corwin", script_id: "GH_GATE_01_A", script_after_flag: { flag_pendant_found: "GH_GATE_01_B" }, script_chain_b: ["GH_GATE_01_B", "GH_GATE_02_B", "GH_GATE_03_B"], hostile: false, area: "greyhaven", note: "Militia watchman at the North Gate." },
        { type: "barrier", name: "north_gate_barrier", tile_x: 199, tile_y: 165, x: 3192, y: 2656, requires_flag: "flag_pendant_found", w: 1, h: 1, note: "North Gate stays shut until the pendant is found (GH_HOUSE_03 sets flag_pendant_found). Corwin explains (GH_GATE_01_A)." },
        { type: "npc", name: "old_hunter_renn", tile_x: 232, tile_y: 158, x: 3720, y: 2544, npc_id: "old_hunter_renn", speaker: "Old Hunter Renn", script_id: "HC_RENN", sprite: "spr_renn_ow16_idle_down", hostile: false, note: "Hunter's Camp (optional). Q_SIDE_RENN giver and turn-in; reward: Hunter's Charm." },
        { type: "location", name: "varyn_house", tile_x: 184, tile_y: 170, x: 2952, y: 2736, area: "greyhaven" },
