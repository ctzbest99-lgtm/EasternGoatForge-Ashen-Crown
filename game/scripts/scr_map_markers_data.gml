        { type: "treasure", name: "basement_chest_hall", tile_x: 38, tile_y: 25, x: 616, y: 416, loot: ["Minor Potion x2"], note: "Design proposal (canon item name)." },
        { type: "encounter_zone", name: "zone01_basement_nest", tile_x: 3, tile_y: 14, x: 56, y: 240, table_id: "zone01_basement_nest", fallback_table_id: "zone01_path", elite_fallen_knights: false, enemy_table: [{ enemy_id: "grave_spider", weight: 3 }, { enemy_id: "hollow_soldier", weight: 1 }], rect_px: [48, 224, 256, 448], enemies: "Grave Spiders, Hollow Soldiers", levels: "5-7" },
        { type: "encounter_zone", name: "zone01_basement_hall", tile_x: 22, tile_y: 14, x: 360, y: 240, table_id: "zone01_basement_hall", fallback_table_id: "zone01_path", elite_fallen_knights: true, enemy_table: [{ enemy_id: "hollow_soldier", weight: 2 }, { enemy_id: "grave_spider", weight: 1 }, { enemy_id: "fallen_knight", weight: 1, elite: true }], rect_px: [352, 224, 640, 416], enemies: "Hollow Soldiers, Grave Spiders, Fallen Knights", levels: "5-7" },
        { type: "enemy_spawn", name: "fallen_knight_basement", tile_x: 31, tile_y: 19, x: 504, y: 320, enemy_id: "fallen_knight", encounter_id: "zone01_basement_fallen_knight", group_size: 1, hostile: true, elite: true, note: "Elite Fallen Knight (hostile) guarding the way to the upper level." }
