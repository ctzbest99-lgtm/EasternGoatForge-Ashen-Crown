/// scr_old_watchtower_markers() -> array of marker structs. Old Watchtower grounds + Blackguard Arena (60x45 tiles).
/// Generated by src/export.py from the matching *_markers.json. x/y are pixels (feet: bottom-centre of the tile).
function scr_old_watchtower_markers() {
    return [
        { type: "player_spawn", name: "from_overworld", tile_x: 29, tile_y: 42, x: 472, y: 688, facing: "up", note: "Arrive here from the overworld Old Watchtower entrance." },
        { type: "zone_exit", name: "to_overworld", tile_x: 29, tile_y: 44, x: 472, y: 720, target_room: "rm_overworld", target_spawn: "old_watchtower", w: 4, h: 1 },
        { type: "entrance", name: "watchtower_basement_stairs", tile_x: 20, tile_y: 28, x: 328, y: 464, target_room: "rm_watchtower_basement", target_spawn: "from_watchtower", status: "built", note: "Stair down to the Watchtower Basement (Architect carvings), inside the collapsed tower. Room built: rm_watchtower_basement (44x32)." },
        { type: "entrance", name: "from_basement", tile_x: 22, tile_y: 17, x: 360, y: 288, target_room: "rm_watchtower_basement", target_spawn: "from_upper_level", status: "built", note: "Open hatch on the upper terrace. Arrival point from the Basement stairs (the Basement exit sets flag_wt_upper_unlocked); stepping back on it goes down again." },
        { type: "story_npc", name: "fallen_knight_story_2", tile_x: 20, tile_y: 29, x: 328, y: 480, npc_id: "fallen_knight_story", script_id: "FK_02", story_flag: "flag_fk_seen_2", hostile: false, note: "Unnamed Fallen Knight (never fights). Waits at the top of the stairs down to the Basement, says FK_02, then descends and is gone. Not the hostile fallen_knight enemy." },
        { type: "barrier", name: "locked_terrace_stairs", tile_x: 28, tile_y: 21, x: 456, y: 352, requires_flag: "flag_wt_upper_unlocked", w: 4, h: 1, note: "Blocks the terrace stairs from below until the player has come up through the Basement (route: Watchtower -> Basement -> Blackguard). Spawns obj_solid while flag_wt_upper_unlocked is unset." },
        { type: "barrier", name: "arena_gate", tile_x: 29, tile_y: 13, x: 472, y: 224, requires_item: "item_watchtower_key", w: 2, h: 1, script_id: "WT_DOOR_LOCKED", lines: ["Locked. The keyhole is crusted with rust."], struck_lines: [], note: "Blackguard Arena gate. Opens with the Watchtower Key (chest in the Basement spider nest)." },
        { type: "story", name: "blackguard_arena_enter", tile_x: 29, tile_y: 12, x: 472, y: 208, trigger: "on_enter_once", script_id: "BG_INTRO", story_flag: "flag_bg_intro_seen", quest_advance: "Q_FM_S9", rect_px: [448, 192, 512, 208], note: "Entering the arena completes Q_FM_S8 and plays BG_INTRO, then starts the boss battle (boss_spawn blackguard)." },
        { type: "encounter", name: "enc_ashbound_hunter_wt", tile_x: 33, tile_y: 33, x: 536, y: 544, enemy_id: "ashbound_hunter", fallback_enemy_id: "bandit", encounter_id: "enc_ashbound_hunter_wt", guaranteed: true, once: true, hostile: true, script_id: "ENC_AH_01", script_chain: ["ENC_AH_01", "ENC_AH_02"], after_victory_chain: ["ENC_AH_03", "ENC_AH_04", "ENC_AH_05"], skip_after_if_flag: "flag_parchment_found", drop_item: "item_ashbound_parchment", note: "Guaranteed first Ashbound Hunter fight, before the banner room, so the parchment can not be missed. fallback_enemy_id is used until ashbound_hunter is in scr_get_enemy_data." },
        { type: "lore", name: "wt_note_1", tile_x: 39, tile_y: 29, x: 632, y: 480, script_id: "WT_NOTE_01", speaker: "Faded Note", lines: ["Third week without relief. They say the post's being closed. Nobody says why."], struck_lines: [] },
        { type: "lore", name: "wt_note_2", tile_x: 17, tile_y: 31, x: 280, y: 512, script_id: "WT_NOTE_02", speaker: "Faded Note", lines: ["Scratching under the floor again last night. Rats, says the sergeant. Big rats."], struck_lines: [] },
        { type: "lore", name: "wt_wall_symbol", tile_x: 43, tile_y: 27, x: 696, y: 448, script_id: "WT_SYMBOL_01", symbol: "crown_ringing_black_sun", lines: ["Carvings older than the tower itself. The stone around them is too smooth."], struck_lines: [] },
        { type: "lore", name: "old_royal_banner", tile_x: 41, tile_y: 25, x: 664, y: 416, script_id: "WT_BANNER", story_flag: "flag_banner_clue", symbol: "crown_ringing_black_sun", note: "Old royal banner (royal_banner tile) bearing the pendant's symbol: a crown ringing a black sun." },
        { type: "treasure", name: "watchtower_chest_1", tile_x: 46, tile_y: 23, x: 744, y: 384, loot: ["placeholder"], note: "Was watchtower_chest_key; the Watchtower Key now lies in the Basement." },
        { type: "treasure", name: "watchtower_chest_2", tile_x: 12, tile_y: 34, x: 200, y: 560, loot: ["placeholder"] },
        { type: "treasure", name: "watchtower_chest_3", tile_x: 30, tile_y: 16, x: 488, y: 272, loot: ["placeholder"] },
        { type: "trap", name: "spike_trap_1", tile_x: 30, tile_y: 30, x: 488, y: 496, script_id: "WT_TRAP_01", lines: ["A pressure plate clicks underfoot—"], struck_lines: [], damage_pct: 10, note: "Hidden pressure plate (no tile drawn)." },
        { type: "trap", name: "spike_trap_2", tile_x: 37, tile_y: 37, x: 600, y: 608, script_id: "WT_TRAP_01", lines: ["A pressure plate clicks underfoot—"], struck_lines: [], damage_pct: 10, note: "Hidden pressure plate (no tile drawn)." },
