        { type: "trap_field", name: "trap_hall_plates", tile_x: 12, tile_y: 5, x: 200, y: 96, script_id: "WT_TRAP_01", lines: ["A pressure plate clicks underfoot—"], struck_lines: [], rect_tiles: [12, 5, 33, 8], rect_px: [192, 80, 544, 144], plate_tiles: [[12, 5], [13, 5], [14, 5], [15, 5], [16, 5], [17, 5], [18, 5], [19, 5], [23, 5], [24, 5], [25, 5], [26, 5], [27, 5], [28, 5], [32, 5], [33, 5], [15, 6], [16, 6], [17, 6], [18, 6], [21, 6], [24, 6], [25, 6], [26, 6], [27, 6], [30, 6], [33, 6], [12, 7], [13, 7], [17, 7], [20, 7], [21, 7], [22, 7], [25, 7], [29, 7], [30, 7], [31, 7], [12, 8], [13, 8], [14, 8], [15, 8], [19, 8], [20, 8], [21, 8], [22, 8], [23, 8], [27, 8], [28, 8], [29, 8], [30, 8], [31, 8], [32, 8], [33, 8]], safe_tiles: [[12, 6], [13, 6], [14, 6], [14, 7], [15, 7], [16, 7], [16, 8], [17, 8], [18, 7], [18, 8], [19, 6], [19, 7], [20, 5], [20, 6], [21, 5], [22, 5], [22, 6], [23, 6], [23, 7], [24, 7], [24, 8], [25, 8], [26, 7], [26, 8], [27, 7], [28, 6], [28, 7], [29, 5], [29, 6], [30, 5], [31, 5], [31, 6], [32, 6], [32, 7], [33, 7]], damage_pct: 10, resets: true, note: "Trap puzzle (Design proposal on the canon trap): every stone is a pressure plate except the carved sigil stones (crown ringing a black sun). Follow the sigils across. A plate shows WT_TRAP_01, deals damage_pct of max HP to the party and resets." },
        { type: "lore", name: "trap_hall_symbols", tile_x: 16, tile_y: 4, x: 264, y: 80, script_id: "WT_SYMBOL_01", lines: ["Carvings older than the tower itself. The stone around them is too smooth."], struck_lines: [], symbol: "crown_ringing_black_sun" },
        { type: "lore", name: "architect_mural", tile_x: 26, tile_y: 13, x: 424, y: 224, script_id: "WB_CARVING", script_chain: ["WB_CARVING_01", "WB_CARVING_02", "WB_CARVING_03", "WB_CARVING_04", "WB_CARVING_05"], story_flag: "flag_carvings_seen", symbol: "crown_ringing_black_sun", lines: ["A great crown, carved around a black sun.", "Beneath it, a woman stands before a stone door.", "The stone is worn smooth by thousands of years. The face is not."], struck_lines: [], note: "Wall-sized Architect relief (mural_architect, 6x4 tiles): a giant crown around a black sun; below it a woman (who resembles Mira) before a stone door. lines = the narration part; Kael replies WB_CARVING_04-05. Don't explain the resemblance." },
