/// scr_dialogue_data_ch2 — Chapter 2 dialogue nodes, keyed by the line ids in
/// docs/story/CHAPTER2_SCRIPT.md (approved by Kevin at cc8faff). Text is verbatim.
/// GENERATED by tools/gen_ch2_dialogue.py — edit the script and re-run, do not hand-edit.
/// Speaker "" is NARRATION. `expr` picks the portrait expression (scr_ch1_portrait).
/// The last block holds the map art pass's placeholder lines (not in the script).

function scr_ch2_dialogue_node(_id) {
    switch (_id) {
        case "CV_WAKE_01":
            return { id: "CV_WAKE_01", speaker: "", lines: ["Kael comes to on the stone. The sealed door is still in front of him.", "The pendant at his chest is quiet."] };
        case "CV_WAKE_02":
            return { id: "CV_WAKE_02", speaker: "Kael", lines: ["...Mira?"] };
        case "CV_WAKE_03":
            return { id: "CV_WAKE_03", speaker: "", lines: ["He puts a shoulder to the door. It does not move.", "Nothing answers from the other side."] };
        case "CV_WAKE_04":
            return { id: "CV_WAKE_04", speaker: "Kael", lines: ["So I can't follow her this way."] };
        case "CV_WAKE_05":
            return { id: "CV_WAKE_05", speaker: "", lines: ["Empty armor in a heap of ash. Whoever wore it is gone."] };
        case "CV_WAKE_06":
            return { id: "CV_WAKE_06", speaker: "", lines: ["Sealed. The pendant does not warm this time.", "She is on the other side of this. He is not."] };
        case "WT2_BACK_01":
            return { id: "WT2_BACK_01", speaker: "Kael", lines: ["Back the way I came, then. There has to be another path."] };
        case "WT2_SIGN_01":
            return { id: "WT2_SIGN_01", speaker: "", lines: ["Old Watchtower. Property of the Crown. Closed by order."] };
        case "WT2_BANNER_R1":
            return { id: "WT2_BANNER_R1", speaker: "", lines: ["The torn royal banner still hangs here. A crown ringing a black sun.", "The same mark as Mira's pendant."] };
        case "GH2_TOMAS_01":
            return { id: "GH2_TOMAS_01", speaker: "", lines: ["He's breathing. Barely. No worse than when Kael left.", "No better, either."] };
        case "GH2_PELL_01":
            return { id: "GH2_PELL_01", speaker: "Pell", lines: ["You're back. I thought you'd gone into those woods and stayed there.", "He's been in and out. Mostly out."] };
        case "GH2_PELL_02":
            return { id: "GH2_PELL_02", speaker: "Kael", lines: ["Keep doing what you're doing."] };
        case "GH2_PELL_03":
            return { id: "GH2_PELL_03", speaker: "Pell", lines: ["If you're heading out again, listen. Crown's been hanging people", "near Millhaven. Wrenfield, they said. Aiding the rebellion."] };
        case "GH2_PELL_04":
            return { id: "GH2_PELL_04", speaker: "Pell", lines: ["And someone swore they saw Taren Holt with the Broken Yoke.", "Your Taren. I thought you should hear it from a friend."] };
        case "GH2_PELL_05":
            return { id: "GH2_PELL_05", speaker: "Kael", lines: ["Taren. Near Millhaven.", "...Then that's where I'm going."] };
        case "GH2_TOMAS_R1":
            return { id: "GH2_TOMAS_R1", speaker: "", lines: ["Still out. Still breathing."] };
        case "GH2_PELL_R1":
            return { id: "GH2_PELL_R1", speaker: "Pell", lines: ["Wrenfield, near Millhaven. That's all I know. I'll stay with him."] };
        case "GH2_HOB_01":
            return { id: "GH2_HOB_01", speaker: "Hob", lines: ["Back already? Either you found her, or you didn't.", "You don't look like a man who found her."] };
        case "GH2_HOB_02":
            return { id: "GH2_HOB_02", speaker: "Kael", lines: ["She's alive. That's what I know."] };
        case "GH2_HOB_03":
            return { id: "GH2_HOB_03", speaker: "Hob", lines: ["I'll take alive. Drink's the same price as yesterday.", "Ashes didn't make it cheaper."] };
        case "GH2_ILSE_01":
            return { id: "GH2_ILSE_01", speaker: "Sister Ilse", lines: ["I prayed you would bring her home. I see that you have not.", "I will keep praying, if that is still welcome."] };
        case "GH2_ILSE_02":
            return { id: "GH2_ILSE_02", speaker: "Kael", lines: ["Pray for a way through a door that won't open."] };
        case "GH2_ILSE_03":
            return { id: "GH2_ILSE_03", speaker: "Sister Ilse", lines: ["Then I will pray for that too."] };
        case "GH2_MARDA_01":
            return { id: "GH2_MARDA_01", speaker: "Marda", lines: ["You again. Shelves are the same. Prices are the same.", "Don't look at me like that. Coin's still coin."] };
        case "GH2_WENNA_01":
            return { id: "GH2_WENNA_01", speaker: "Old Wenna", lines: ["The well still runs. The rest of us are doing the same.", "Go on, if you're going. We'll be here."] };
        case "GH2_DOV_01":
            return { id: "GH2_DOV_01", speaker: "Dov", lines: ["Did you find her? Mira. You went north."] };
        case "GH2_DOV_02":
            return { id: "GH2_DOV_02", speaker: "Kael", lines: ["I found where she went. I haven't reached her yet."] };
        case "GH2_DOV_03":
            return { id: "GH2_DOV_03", speaker: "Dov", lines: ["She said the door was hers. I should've believed her."] };
        case "GH2_CORWIN_01":
            return { id: "GH2_CORWIN_01", speaker: "Corwin", lines: ["In and out again? Fine. You should know: Crown patrols have been", "hanging \"sympathizers\" at Wrenfield, near Millhaven."] };
        case "GH2_CORWIN_02":
            return { id: "GH2_CORWIN_02", speaker: "Corwin", lines: ["A drover told me Taren Holt was seen there, with the Broken Yoke.", "If that's your business, I'd move before the ropes do."] };
        case "GH2_CORWIN_03":
            return { id: "GH2_CORWIN_03", speaker: "Kael", lines: ["It is now."] };
        case "GH2_GATE_SIGN":
            return { id: "GH2_GATE_SIGN", speaker: "", lines: ["North Gate. Keep it barred after dark."] };
        case "MR_SIGN_01":
            return { id: "MR_SIGN_01", speaker: "", lines: ["Wrenfield. Millhaven beyond. Valemere by the west road."] };
        case "MR_NOTICE_01":
            return { id: "MR_NOTICE_01", speaker: "", lines: ["By order of the Reeve at Wrenfield: those who aid the rebellion", "will hang. Public judgment at midday."] };
        case "MR_HOOK_01":
            return { id: "MR_HOOK_01", speaker: "Traveler", lines: ["If you're headed south, don't go through Wrenfield today.", "They're hanging folk for aiding the rebellion."] };
        case "MR_HOOK_02":
            return { id: "MR_HOOK_02", speaker: "Traveler", lines: ["I saw Taren Holt in the square. Sword out. Arguing with the Reeve.", "He always did have more nerve than sense."] };
        case "MR_HOOK_03":
            return { id: "MR_HOOK_03", speaker: "Kael", lines: ["You know him?"] };
        case "MR_HOOK_04":
            return { id: "MR_HOOK_04", speaker: "Traveler", lines: ["Everyone near Millhaven knows Taren. Or they did.", "I wouldn't linger. The ropes were already out."] };
        case "MR_HOOK_05":
            return { id: "MR_HOOK_05", speaker: "Kael", lines: ["Then I'm not lingering."] };
        case "MR_HOOK_R1":
            return { id: "MR_HOOK_R1", speaker: "Traveler", lines: ["Wrenfield. Midday. I wouldn't be there."] };
        case "MR_ENTER_01":
            return { id: "MR_ENTER_01", speaker: "Kael", lines: ["Near Millhaven. Taren's country.", "If he's in that square, I'm not leaving him in it."] };
        case "MR_STONE_01":
            return { id: "MR_STONE_01", speaker: "", lines: ["Old stones half-sunk in the grass. Architect work, if Kael had to guess.", "The carvings are too worn to read."] };
        case "MR_STONE_02":
            return { id: "MR_STONE_02", speaker: "Kael", lines: ["More Architect stones. Not a door this time.", "Good."] };
        case "MR_PATROL_01":
            return { id: "MR_PATROL_01", speaker: "Crown Soldier", lines: ["Halt. This road is under watch until Wrenfield is settled."] };
        case "MR_PATROL_02":
            return { id: "MR_PATROL_02", speaker: "Kael", lines: ["I'm passing through."] };
        case "MR_PATROL_03":
            return { id: "MR_PATROL_03", speaker: "Crown Soldier", lines: ["Everyone's passing through, until they aren't. Move along,", "or fall in and be counted."] };
        case "WF_GATE_01":
            return { id: "WF_GATE_01", speaker: "Crown Sergeant", lines: ["Square's open for judgment. In or out. Make it quiet."] };
        case "WF_GATE_02":
            return { id: "WF_GATE_02", speaker: "Kael", lines: ["I'm going in."] };
        case "WF_GATE_03":
            return { id: "WF_GATE_03", speaker: "Crown Sergeant", lines: ["Then keep your hands where I can see them. Reeve Calder", "is already reading the names."] };
        case "WF_NOTICE_01":
            return { id: "WF_NOTICE_01", speaker: "", lines: ["A list of the accused, nailed to the post. \"Aiding the Broken Yoke.\"", "Four names. One of them is Bram."] };
        case "WF_GATE_A1":
            return { id: "WF_GATE_A1", speaker: "Crown Sergeant", lines: ["You heard me. In or out."] };
        case "WF_SOLDIER_A1":
            return { id: "WF_SOLDIER_A1", speaker: "Crown Soldier", lines: ["Don't look at me. I don't tie the knots.", "I just hold the line."] };
        case "WF_SOLDIER_A2":
            return { id: "WF_SOLDIER_A2", speaker: "Crown Soldier", lines: ["Rebellion starts with a loaf and ends with a rope.", "Remember that, if you came to gawk."] };
        case "WF_TAVERN_A1":
            return { id: "WF_TAVERN_A1", speaker: "Perrin", lines: ["Bar's closed till the square's done. I don't pour for a hanging.", "You want a drink, come back when the ropes are down."], expr: "grim" };
        case "WF_TAVERN_A2":
            return { id: "WF_TAVERN_A2", speaker: "Kael", lines: ["They will be."] };
        case "WF_TAVERN_A3":
            return { id: "WF_TAVERN_A3", speaker: "Perrin", lines: ["Bold words. I'd keep them off the Reeve's ears."], expr: "grim" };
        case "WF_STORE_A1":
            return { id: "WF_STORE_A1", speaker: "Len", lines: ["Shop's shut. You can stare at the shutters like everyone else.", "I'm not selling while my neighbors are on a scaffold."], expr: "nervous" };
        case "WF_ODA_A1":
            return { id: "WF_ODA_A1", speaker: "Oda", lines: ["Please— they took my brother. Bram. He's on the list.", "He mended a cart for a stranger. That's all he did."], expr: "pleading" };
        case "WF_ODA_A2":
            return { id: "WF_ODA_A2", speaker: "SYSTEM", lines: ["Accept?"] };
        case "WF_ODA_A3_YES":
            return { id: "WF_ODA_A3_YES", speaker: "Oda", lines: ["He's in the square. The tall one, on the right. Please reach him."], expr: "worried" };
        case "WF_ODA_A4_NO":
            return { id: "WF_ODA_A4_NO", speaker: "Oda", lines: ["Then I'll reach him myself, if I have to go under the horses."], expr: "worried" };
        case "WF_GALLOWS_01":
            return { id: "WF_GALLOWS_01", speaker: "Reeve Calder", lines: ["By order of the Crown, these four gave aid to the Broken Yoke.", "The sentence is death. Let the village see it done."], expr: "stern" };
        case "WF_GALLOWS_02":
            return { id: "WF_GALLOWS_02", speaker: "", lines: ["On the right-hand gallows, a noose is already on a young man's neck.", "The rope is taut. His feet have almost left the boards."] };
        case "WF_GALLOWS_03":
            return { id: "WF_GALLOWS_03", speaker: "Taren", lines: ["Calder! Cut him down. You want a trial, you can have one.", "You will not have a show."], expr: "determined" };
        case "WF_GALLOWS_04":
            return { id: "WF_GALLOWS_04", speaker: "Reeve Calder", lines: ["The trial was held, Holt. You were not invited."], expr: "stern" };
        case "WF_GALLOWS_05":
            return { id: "WF_GALLOWS_05", speaker: "Kael", lines: ["Taren!"] };
        case "WF_GALLOWS_06":
            return { id: "WF_GALLOWS_06", speaker: "Taren", lines: ["Kael—? Later. The rope."], expr: "determined" };
        case "WF_GALLOWS_07":
            return { id: "WF_GALLOWS_07", speaker: "", lines: ["The rope parts. The young man slams into the boards and draws a breath.", "The other three are still bound. Still alive."] };
        case "WF_GALLOWS_08":
            return { id: "WF_GALLOWS_08", speaker: "Taren", lines: ["Stay down. All of you. Kael— with me."], expr: "determined" };
        case "WF_CALDER_INTRO_01":
            return { id: "WF_CALDER_INTRO_01", speaker: "Reeve Calder", lines: ["Stay where you are. This is Crown business."], expr: "stern" };
        case "WF_CALDER_INTRO_02":
            return { id: "WF_CALDER_INTRO_02", speaker: "Kael", lines: ["You're hanging farmers."] };
        case "WF_CALDER_INTRO_03":
            return { id: "WF_CALDER_INTRO_03", speaker: "Reeve Calder", lines: ["I'm hanging traitors. There is a difference,", "even if you have forgotten it."], expr: "stern" };
        case "WF_CALDER_INTRO_04":
            return { id: "WF_CALDER_INTRO_04", speaker: "Taren", lines: ["There's a rope on a man's neck, Reeve.", "That's the only difference I see."], expr: "determined" };
        case "WF_CALDER_INTRO_05":
            return { id: "WF_CALDER_INTRO_05", speaker: "Reeve Calder", lines: ["Holt. I should have known the Yoke would show itself.", "And you brought a friend. Put the swords down."], expr: "stern" };
        case "WF_CALDER_INTRO_06":
            return { id: "WF_CALDER_INTRO_06", speaker: "Taren", lines: ["After you cut the rest of them loose."], expr: "determined" };
        case "WF_CALDER_INTRO_07":
            return { id: "WF_CALDER_INTRO_07", speaker: "Reeve Calder", lines: ["I have my orders. I intend to keep this village standing.", "Step aside."], expr: "stern" };
        case "WF_CALDER_SYS_01":
            return { id: "WF_CALDER_SYS_01", speaker: "SYSTEM", lines: ["Taren Holt has joined the party.", "He takes the second party slot."] };
        case "WF_CALDER_SYS_02":
            return { id: "WF_CALDER_SYS_02", speaker: "SYSTEM", lines: ["Weapon: bastard sword (heavy sword).", "Starting skills: Rallying Cry, Cleave, and Unbowed (passive)."] };
        case "WF_CALDER_SYS_03":
            return { id: "WF_CALDER_SYS_03", speaker: "SYSTEM", lines: ["Rallying Cry raises the party's Attack for 3 turns.", "Cleave hits all enemies for reduced damage."] };
        case "WF_CALDER_SYS_03B":
            return { id: "WF_CALDER_SYS_03B", speaker: "SYSTEM", lines: ["Unbowed: Taren resists Fear and Stun."] };
        case "WF_CALDER_SYS_04":
            return { id: "WF_CALDER_SYS_04", speaker: "SYSTEM", lines: ["Rallying Cry: Taren leads the line. Kael is the one who holds it."] };
        case "WF_CALDER_PHASE2_01":
            return { id: "WF_CALDER_PHASE2_01", speaker: "Reeve Calder", lines: ["Hold, then. I'll finish this myself."], expr: "stern" };
        case "WF_CALDER_DEFEAT_01":
            return { id: "WF_CALDER_DEFEAT_01", speaker: "Reeve Calder", lines: ["Enough. I'll not spend another man on this square."], expr: "weary" };
        case "WF_CALDER_DEFEAT_02":
            return { id: "WF_CALDER_DEFEAT_02", speaker: "Taren", lines: ["Then cut them loose and get off the boards."], expr: "determined" };
        case "WF_CALDER_DEFEAT_03":
            return { id: "WF_CALDER_DEFEAT_03", speaker: "Reeve Calder", lines: ["You haven't won this village. You've only borrowed it.", "The Crown will be back before the week is out."], expr: "weary" };
        case "WF_CALDER_DEFEAT_04":
            return { id: "WF_CALDER_DEFEAT_04", speaker: "Kael", lines: ["We're not staying."] };
        case "WF_CALDER_DEFEAT_05":
            return { id: "WF_CALDER_DEFEAT_05", speaker: "Reeve Calder", lines: ["No. Men like you never do. You leave other people", "to live in what you've made."], expr: "weary" };
        case "WF_CALDER_REWARD_01":
            return { id: "WF_CALDER_REWARD_01", speaker: "SYSTEM", lines: ["The accused are free. The Crown has pulled back to the checkpoints.", "Wrenfield is still under occupation."] };
        case "WF_JOIN_01":
            return { id: "WF_JOIN_01", speaker: "Taren", lines: ["Kael Varyn. You pick your hours."], expr: "wry" };
        case "WF_JOIN_02":
            return { id: "WF_JOIN_02", speaker: "Kael", lines: ["You're one to talk."] };
        case "WF_JOIN_03":
            return { id: "WF_JOIN_03", speaker: "Taren", lines: ["I heard about Greyhaven. I was coming, and then this", "happened first. Tell me you found her."] };
        case "WF_JOIN_04":
            return { id: "WF_JOIN_04", speaker: "Kael", lines: ["No body. A pendant she left in the house.", "And a parchment that said she's alive."] };
        case "WF_JOIN_05":
            return { id: "WF_JOIN_05", speaker: "Kael", lines: ["A thing at the end of the road said she crossed the Crownveil.", "I found the door. It wouldn't open."] };
        case "WF_JOIN_06":
            return { id: "WF_JOIN_06", speaker: "Taren", lines: ["Then we find another way. I'm with you.", "You're not walking this one alone."], expr: "determined" };
        case "WF_JOIN_07":
            return { id: "WF_JOIN_07", speaker: "Taren", lines: ["The Yoke's fight and yours are going to keep crossing.", "I can live with that if you can."], expr: "determined" };
        case "WF_JOIN_08":
            return { id: "WF_JOIN_08", speaker: "Kael", lines: ["I just need to find Mira."] };
        case "WF_JOIN_09":
            return { id: "WF_JOIN_09", speaker: "Taren", lines: ["Then Valemere's the next step. Official doors won't open,", "but people will talk, if you know where to stand."] };
        case "WF_JOIN_10":
            return { id: "WF_JOIN_10", speaker: "Taren", lines: ["Alden's in the capital, talking to people who still think", "the Crown will save them. He'll want to see you."] };
        case "WF_JOIN_11":
            return { id: "WF_JOIN_11", speaker: "Kael", lines: ["Alden. It's been a while."] };
        case "WF_JOIN_12":
            return { id: "WF_JOIN_12", speaker: "Taren", lines: ["For all three of us. Come on. We shouldn't linger", "while Calder's still got a checkpoint on the west road."], expr: "determined" };
        case "WF_JOIN_R1":
            return { id: "WF_JOIN_R1", speaker: "Taren", lines: ["Valemere when you're ready. Alden's there. So are answers,", "if the Crown hasn't locked them all in a drawer."], expr: "wry" };
        case "WF_GATE_B1":
            return { id: "WF_GATE_B1", speaker: "Crown Sergeant", lines: ["Reeve says you get the road. He didn't say you get the village.", "Don't make me sorry I opened the bar."] };
        case "WF_SOLDIER_B1":
            return { id: "WF_SOLDIER_B1", speaker: "Crown Soldier", lines: ["I'm glad the ropes came down. I won't say that twice.", "Don't ask me to say it where Calder can hear."] };
        case "WF_SOLDIER_B2":
            return { id: "WF_SOLDIER_B2", speaker: "Crown Soldier", lines: ["You bought them a week, maybe two. Don't call it a victory."] };
        case "WF_TAVERN_B1":
            return { id: "WF_TAVERN_B1", speaker: "Perrin", lines: ["Bar's open. First one's on the house, because I have a conscience", "and almost had a funeral. After that, coin."], expr: "warm" };
        case "WF_STORE_B1":
            return { id: "WF_STORE_B1", speaker: "Len", lines: ["Shutters are up. Prices are what they are.", "I'd rather sell you a potion than a wreath."], expr: "smile" };
        case "WF_ODA_B1":
            return { id: "WF_ODA_B1", speaker: "Oda", lines: ["Bram's alive. He can't talk yet, but he's alive.", "You reached him. I won't forget that."], expr: "relieved" };
        case "WF_ODA_B2":
            return { id: "WF_ODA_B2", speaker: "SYSTEM", lines: ["Obtained: Minor Potion x2, 40 Gold."] };
        case "WF_ODA_B3":
            return { id: "WF_ODA_B3", speaker: "Bram", lines: ["I mended a cart. That's all. Tell them that,", "if they come back with more rope."], expr: "shaken" };
        case "WF_BRAM_B1":
            return { id: "WF_BRAM_B1", speaker: "", lines: ["He's alive. His neck will remember the rope longer than he wants it to."] };
        case "WF_WEST_SIGN":
            return { id: "WF_WEST_SIGN", speaker: "", lines: ["West: Valemere. The capital road."] };
        case "WF_HANDOFF_01":
            return { id: "WF_HANDOFF_01", speaker: "Taren", lines: ["That's our road. Stay sharp. Calder meant it", "when he said the Crown would be back."], expr: "determined" };
        case "WF_HANDOFF_02":
            return { id: "WF_HANDOFF_02", speaker: "Kael", lines: ["Let them come. I need answers, and Mira's still out there."] };
        case "WF_HANDOFF_03":
            return { id: "WF_HANDOFF_03", speaker: "Taren", lines: ["Then we go get both. Together this time."], expr: "determined" };
        case "WF_HANDOFF_04":
            return { id: "WF_HANDOFF_04", speaker: "SYSTEM", lines: ["Quest updated: Travel to Valemere for answers."] };
        case "WF_HANDOFF_05":
            return { id: "WF_HANDOFF_05", speaker: "SYSTEM", lines: ["Chapter 2 — The Weight of the Yoke — Complete."] };
        case "WF_STORE_SHUT":  // PLACEHOLDER (art pass, not in the script)
            return { id: "WF_STORE_SHUT", speaker: "", lines: ["Shuttered and barred. Len isn't selling today."] };
        case "WF_WEST_LOCKED":  // PLACEHOLDER (art pass, not in the script)
            return { id: "WF_WEST_LOCKED", speaker: "", lines: ["Crown checkpoint. West road closed by order of the Reeve."] };
        case "WF_TAVERN_NOTICE":  // PLACEHOLDER (art pass, not in the script)
            return { id: "WF_TAVERN_NOTICE", speaker: "", lines: ["Chalked on a board: \"Rooms upstairs. Ask Perrin.\""] };
        case "OW_MR_LOCKED":  // PLACEHOLDER (art pass, not in the script)
            return { id: "OW_MR_LOCKED", speaker: "", lines: ["Crown checkpoint. No passage south without the Reeve's leave."] };
        case "OW_MR_FORK_SIGN":  // PLACEHOLDER (art pass, not in the script)
            return { id: "OW_MR_FORK_SIGN", speaker: "", lines: ["South: Wrenfield and the Millhaven road."] };
        case "CH2_TBC":  // PLACEHOLDER (art pass, not in the script)
            return { id: "CH2_TBC", speaker: "", lines: ["To be continued."] };
    }
    return undefined;
}
