/// scr_build_watchtower_basement(): fills rm_watchtower_basement (44x32 tiles, 704x512 px) from embedded data. Watchtower Basement: Architect carvings, trap hall, spider nest.
/// Call from the room's Creation Code. Generated by src/export.py.
function scr_build_watchtower_basement() {
    var _d = scr_watchtower_basement_data();
    scr_map_build_from_arrays(_d, 44, 32);
    scr_map_spawn_markers(scr_watchtower_basement_markers());
    scr_map_enable_camera(320, 180);
    scr_camera_follow_player();
}

