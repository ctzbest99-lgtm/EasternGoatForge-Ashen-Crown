        { type: "lore", name: "the_descent", tile_x: 17, tile_y: 20, x: 280, y: 336, lines: ["The stair is cut narrower than the doorway above it, and it turns once before it reaches the floor.", "The air is dry. Nothing has moved here except dust, and the dust has settled in one direction."], note: "Look text at the bottom of the stair." },
        { type: "lore", name: "the_niches", tile_x: 4, tile_y: 10, x: 72, y: 176, lines: ["Four niches, and the bones in them are laid out straight, hands at their sides.", "The skulls face the shrine. Whoever put them here wanted them watching."], note: "Look text in the west burial niche." },
