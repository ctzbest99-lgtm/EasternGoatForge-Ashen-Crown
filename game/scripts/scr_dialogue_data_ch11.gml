/// scr_dialogue_data_ch11 — Chapter 11 dialogue nodes, keyed by the line ids in
/// docs/story/CHAPTER11_SCRIPT.md (built Nov 16 2026 from the approved Act IV decisions).
/// GENERATED by tools/gen_ch11_dialogue.py — edit the script and re-run, do not hand-edit.
/// Speaker "" is NARRATION. The last block holds wiring-only placeholder lines.

function scr_ch11_dialogue_node(_id) {
    switch (_id) {
        case "BH_ARRIVE_01":
            return { id: "BH_ARRIVE_01", speaker: "", lines: ["The steps end in a hall built for crowds. The ceiling goes up past the torchlight.", "There is dust on the floor and no footprints in it but theirs."] };
        case "BH_ARRIVE_02":
            return { id: "BH_ARRIVE_02", speaker: "Lyra", lines: ["Somebody swept this. Not recently. But somebody swept it."] };
        case "BH_ARRIVE_03":
            return { id: "BH_ARRIVE_03", speaker: "Caelan", lines: ["Look at the niches."] };
        case "BH_ARRIVE_04":
            return { id: "BH_ARRIVE_04", speaker: "", lines: ["Each niche holds a name cut into the stone. Every name has been struck through with a chisel: one diagonal, then another, the same depth, the same angle, the same hand."] };
        case "BH_ARRIVE_05":
            return { id: "BH_ARRIVE_05", speaker: "Sera", lines: ["That's not weathering. That's work."] };
        case "BH_ARRIVE_06":
            return { id: "BH_ARRIVE_06", speaker: "Caelan", lines: ["The same hand, the same chisel, done in one campaign. Nobody forgets a king by accident.", "Somebody stood where we're standing and crossed out every name in this room."] };
        case "BH_ARRIVE_07":
            return { id: "BH_ARRIVE_07", speaker: "Taren", lines: ["Then why keep the room?"] };
        case "BH_ARRIVE_08":
            return { id: "BH_ARRIVE_08", speaker: "Caelan", lines: ["Because you can't cross out a room. You can only cross out what's written in it."] };
        case "BH_ARRIVE_09":
            return { id: "BH_ARRIVE_09", speaker: "Alden", lines: ["I've spent four years arguing that the Crown lies to the people who keep it fed.", "I never once thought it would go back and edit the dead."] };
        case "BH_ARRIVE_10":
            return { id: "BH_ARRIVE_10", speaker: "Kael", lines: ["It went back and edited the dead. Keep walking."] };
        case "BH_NAMES_01":
            return { id: "BH_NAMES_01", speaker: "", lines: ["The name is gone under the chisel, but the title above it was left: *keeper of the fifth holding*. The same words as the survey page."] };
        case "BH_NAMES_02":
            return { id: "BH_NAMES_02", speaker: "Lyra", lines: ["Fifth holding. Coleford's ledger said the fifth holding had no tax line.", "It had a person in it."] };
        case "BH_NAMES_03":
            return { id: "BH_NAMES_03", speaker: "Caelan", lines: ["It had a whole house in it. This is the house."] };
        case "BH_NICHE_01":
            return { id: "BH_NICHE_01", speaker: "", lines: ["A cup, a knife, and a shoe sized for a child. The offerings were never taken.", "Whoever crossed out the names did not rob the dead."] };
        case "BH_NICHE_02":
            return { id: "BH_NICHE_02", speaker: "Sera", lines: ["That's the part I can't make fit. They hated this house enough to erase it and careful enough not to touch its offerings."] };
        case "BH_NICHE_03":
            return { id: "BH_NICHE_03", speaker: "Caelan", lines: ["Careful isn't the same as kind. Somebody was afraid of this room."] };
        case "FD_ARRIVE_01":
            return { id: "FD_ARRIVE_01", speaker: "", lines: ["The chamber has one piece of furniture in it and it is a throne.", "The man sitting in it has been dead for a very long time and has not finished doing it."] };
        case "FD_ARRIVE_02":
            return { id: "FD_ARRIVE_02", speaker: "Sera", lines: ["That's not a body. That's a body somebody maintains."] };
        case "FD_ARRIVE_03":
            return { id: "FD_ARRIVE_03", speaker: "Caelan", lines: ["Iron through the wrists. Through the ribs. The same riveted plate as the Warden, but older.", "They built the guardian into the king."] };
        case "FD_ARRIVE_04":
            return { id: "FD_ARRIVE_04", speaker: "Taren", lines: ["Why?"] };
        case "FD_ARRIVE_05":
            return { id: "FD_ARRIVE_05", speaker: "Caelan", lines: ["So the house would have a keeper. Not a ghost. A keeper."] };
        case "FD_ARRIVE_06":
            return { id: "FD_ARRIVE_06", speaker: "Alden", lines: ["There's a charter."] };
        case "FD_ARRIVE_07":
            return { id: "FD_ARRIVE_07", speaker: "", lines: ["A stone lectern at the foot of the dais. Under a sheet of something clearer than glass, a charter: one page, the Crown's oldest hand, and a seal pressed at the bottom that is not the Crown's seal."] };
        case "FD_ARRIVE_08":
            return { id: "FD_ARRIVE_08", speaker: "Kael", lines: ["The seal's on the outside. That's the one we came for.", "Read the charter first."] };
        case "BK_CHARTER_01":
            return { id: "BK_CHARTER_01", speaker: "", lines: ["The charter is one page. Land, obedience, the founding of a house, and the words *by this mark shall it be known*.", "At the bottom, pressed into the wax: a crown ringing a black sun."] };
        case "BK_CHARTER_02":
            return { id: "BK_CHARTER_02", speaker: "Caelan", lines: ["It's a foundation charter. Somebody legitimised a house with this.", "Read the line at the top. The old hand. Before the Crown wrote like the Crown."] };
        case "BK_CHARTER_03":
            return { id: "BK_CHARTER_03", speaker: "", lines: ["One line, older than the rest, in a hand that cuts instead of flows:", "*The mark of the Crownveil.*"] };
        case "BK_CHARTER_04":
            return { id: "BK_CHARTER_04", speaker: "Kael", lines: ["The Crownveil."] };
        case "BK_CHARTER_05":
            return { id: "BK_CHARTER_05", speaker: "Sera", lines: ["That's what it's called.", "Like the door."] };
        case "BK_CHARTER_06":
            return { id: "BK_CHARTER_06", speaker: "Lyra", lines: ["That's all it is? A name?"] };
        case "BK_CHARTER_07":
            return { id: "BK_CHARTER_07", speaker: "Caelan", lines: ["That's all the page says. A name and a seal and a house.", "It doesn't tell us what it means. It tells us what to call it, and it tells us somebody wanted it called that in front of witnesses.", "Whether the door is named after the mark or the mark after the door, nobody wrote down. Don't ask me to guess."] };
        case "BK_CHARTER_08":
            return { id: "BK_CHARTER_08", speaker: "Taren", lines: ["So we've come a hundred miles for a name."] };
        case "BK_CHARTER_09":
            return { id: "BK_CHARTER_09", speaker: "Caelan", lines: ["We've come a hundred miles to learn the mark has a name the Crown stopped saying.", "That's not nothing. That's a thing somebody was made to stop saying."] };
        case "BK_CHARTER_10":
            return { id: "BK_CHARTER_10", speaker: "Alden", lines: ["Say it again."] };
        case "BK_CHARTER_11":
            return { id: "BK_CHARTER_11", speaker: "Kael", lines: ["The Crownveil."] };
        case "BK_CHARTER_12":
            return { id: "BK_CHARTER_12", speaker: "", lines: ["On the dais, the kept king's head comes up.", "The iron through his wrists takes the weight of his hands, and the oath-work in his chest turns over once, like a key."] };
        case "BK_CHARTER_13":
            return { id: "BK_CHARTER_13", speaker: "Sera", lines: ["It heard the name."] };
        case "BK_CHARTER_14":
            return { id: "BK_CHARTER_14", speaker: "Caelan", lines: ["It's been waiting to hear the name."] };
        case "FK_INTRO_01":
            return { id: "FK_INTRO_01", speaker: "", lines: ["He stands. It takes a long time and none of it is graceful.", "The iron in his chest is doing the work his body stopped doing."] };
        case "FK_INTRO_02":
            return { id: "FK_INTRO_02", speaker: "Caelan", lines: ["It's not him. It's the oath wearing him.", "Same as the Warden. Older. Worse."] };
        case "FK_INTRO_03":
            return { id: "FK_INTRO_03", speaker: "Alden", lines: ["He's not attacking us. He's standing between us and the seal."] };
        case "FK_INTRO_04":
            return { id: "FK_INTRO_04", speaker: "Sera", lines: ["Same thing, from where I'm standing."] };
        case "FK_INTRO_05":
            return { id: "FK_INTRO_05", speaker: "Taren", lines: ["He's not going to stop."] };
        case "FK_INTRO_06":
            return { id: "FK_INTRO_06", speaker: "Kael", lines: ["No. Form up. Don't touch the seal until he's down."] };
        case "FK_AFTER_01":
            return { id: "FK_AFTER_01", speaker: "", lines: ["The iron goes still, and then the body does what bodies do.", "It takes a while. Nobody says anything while it happens."] };
        case "FK_AFTER_02":
            return { id: "FK_AFTER_02", speaker: "Caelan", lines: ["The oath let go. That's all that was holding him up.", "There's no ghost here. There never was."] };
        case "FK_AFTER_03":
            return { id: "FK_AFTER_03", speaker: "Sera", lines: ["Then what did we fight?"] };
        case "FK_AFTER_04":
            return { id: "FK_AFTER_04", speaker: "Caelan", lines: ["A promise that outlasted the man who made it."] };
        case "FK_AFTER_05":
            return { id: "FK_AFTER_05", speaker: "Taren", lines: ["Say that again for the ones at the back."] };
        case "FK_AFTER_06":
            return { id: "FK_AFTER_06", speaker: "Caelan", lines: ["Somebody promised this tomb a keeper, and the promise kept its word a hundred years after everybody who could be thanked for it was dead."] };
        case "FK_AFTER_07":
            return { id: "FK_AFTER_07", speaker: "", lines: ["The seal sits on its stand. A crown ringing a black sun, small enough for a hand."] };
        case "FK_AFTER_08":
            return { id: "FK_AFTER_08", speaker: "Alden", lines: ["That's it. That's what the road was for. That's what the ledger was paying for.", "A door, a keeper, and a stamp."] };
        case "FK_AFTER_09":
            return { id: "FK_AFTER_09", speaker: "Lyra", lines: ["A stamp with a name on it."] };
        case "FK_AFTER_10":
            return { id: "FK_AFTER_10", speaker: "Alden", lines: ["The old name. The one nobody's been allowed to say."] };
        case "FK_AFTER_11":
            return { id: "FK_AFTER_11", speaker: "", lines: ["Nobody moves toward the stand."] };
        case "SL_CHOICE_01":
            return { id: "SL_CHOICE_01", speaker: "Kael", lines: ["Somebody has to carry it out of here. It can't stay."] };
        case "SL_CHOICE_02":
            return { id: "SL_CHOICE_02", speaker: "Alden", lines: ["I'll take it."] };
        case "SL_CHOICE_03":
            return { id: "SL_CHOICE_03", speaker: "", lines: ["He says it before anyone else can, and he does not explain himself, which is new."] };
        case "SL_CHOICE_04":
            return { id: "SL_CHOICE_04", speaker: "Taren", lines: ["Alden."] };
        case "SL_CHOICE_05":
            return { id: "SL_CHOICE_05", speaker: "Alden", lines: ["I'm not going to argue for it. I'm telling you what I'd do with it, and you can decide I'm wrong.", "Whoever sits the throne next will need a reason. This is a reason with a name on it."] };
        case "SL_ALDEN_01":
            return { id: "SL_ALDEN_01", speaker: "Kael", lines: ["Take it."] };
        case "SL_ALDEN_02":
            return { id: "SL_ALDEN_02", speaker: "", lines: ["Alden picks the seal up the way you pick up something you intend to give back.", "He puts it inside his coat without looking at it again."] };
        case "SL_ALDEN_03":
            return { id: "SL_ALDEN_03", speaker: "Alden", lines: ["Thank you. I mean that. I'm not going to make a speech about it.", "When there's a reason to show it, I'll show it to all of you first."] };
        case "SL_ALDEN_04":
            return { id: "SL_ALDEN_04", speaker: "Taren", lines: ["…"] };
        case "SL_ALDEN_05":
            return { id: "SL_ALDEN_05", speaker: "Alden", lines: ["Taren."] };
        case "SL_ALDEN_06":
            return { id: "SL_ALDEN_06", speaker: "Taren", lines: ["It's a long walk back. Let's take it in daylight."] };
        case "SL_PARTY_01":
            return { id: "SL_PARTY_01", speaker: "Kael", lines: ["No. It stays with us."] };
        case "SL_PARTY_02":
            return { id: "SL_PARTY_02", speaker: "Alden", lines: ["All right."] };
        case "SL_PARTY_03":
            return { id: "SL_PARTY_03", speaker: "", lines: ["He steps back from the stand and puts his hands where everyone can see them, which is either grace or a lesson in how to be trusted, and nobody can tell which."] };
        case "SL_PARTY_04":
            return { id: "SL_PARTY_04", speaker: "Alden", lines: ["For what it's worth — I think you're wrong. I'd have said the same in your place.", "That's not the same as being sure."] };
        case "SL_PARTY_05":
            return { id: "SL_PARTY_05", speaker: "Taren", lines: ["…"] };
        case "ACT4_END_01":
            return { id: "ACT4_END_01", speaker: "", lines: ["They climb out of the barrow into a grey afternoon with the whole road to walk back.", "Behind them, the tomb is a hill again."] };
        case "ACT4_END_02":
            return { id: "ACT4_END_02", speaker: "Caelan", lines: ["It has a name. That's what we have: a name and the paper it was written on.", "Everything else in this kingdom is going to have to be asked about that name."] };
        case "ACT4_END_03":
            return { id: "ACT4_END_03", speaker: "Sera", lines: ["Then we ask. Out loud. In front of people."] };
        case "ACT4_END_04":
            return { id: "ACT4_END_04", speaker: "Alden", lines: ["That's a plan I can carry."] };
        case "ACT4_END_05":
            return { id: "ACT4_END_05", speaker: "", lines: ["Taren walks at the back of the line the whole way to Coleford, and says nothing, and does not once look at Alden's coat."] };
        case "ACT4_END_06":
            return { id: "ACT4_END_06", speaker: "SYSTEM", lines: ["Quest complete: The King Who Was Forgotten.", "Chapter 11 — The Forgotten King — Complete.", "Act IV — The Forgotten King — Complete."] };
        case "BH_NAMES_R1":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "BH_NAMES_R1", speaker: "", lines: ["The struck names have nothing more to say."] };
        case "BH_NICHE_R1":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "BH_NICHE_R1", speaker: "", lines: ["The cup, the knife and the shoe. Nobody has taken them."] };
        case "FD_CHARTER_R1":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "FD_CHARTER_R1", speaker: "", lines: ["The charter says what it said. The name is still the name."] };
        case "FK_RETRY_01":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "FK_RETRY_01", speaker: "", lines: ["The King is on his feet again, the iron turning over in his chest."] };
    }
    return undefined;
}
