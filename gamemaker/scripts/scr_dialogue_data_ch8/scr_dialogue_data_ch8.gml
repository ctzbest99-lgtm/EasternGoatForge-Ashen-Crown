function scr_ch8_dialogue_node(_id) {
    switch (_id) {
        case "DW_ARRIVE_01":
            return { id: "DW_ARRIVE_01", speaker: "", lines: ["The trees stop at a wall of cut stone, and the wall was squared by hand.", "Nothing about it has fallen down in the years since."] };
        case "DW_ARRIVE_02":
            return { id: "DW_ARRIVE_02", speaker: "Caelan", lines: ["This is the sanctuary's work at ten times the size.", "Same courses. Same joints. Same hands, a long time apart."] };
        case "DW_ARRIVE_03":
            return { id: "DW_ARRIVE_03", speaker: "Lyra", lines: ["There's no lintel, no roof, no gate.", "Walls without a building. Who builds a wall and stops?"] };
        case "DW_ARRIVE_04":
            return { id: "DW_ARRIVE_04", speaker: "Sera", lines: ["Someone swept the step.", "Look at the litter. It's pushed to the sides, and recently."] };
        case "DW_ARRIVE_05":
            return { id: "DW_ARRIVE_05", speaker: "Kael", lines: ["Then we're expected, and we're late.", "Stay off the step until we know what's standing in the leaves."] };
        case "DW_SENT_01":
            return { id: "DW_SENT_01", speaker: "Kael", lines: ["Standing. Not leaning, not fallen.", "They've been in this litter since before the road and they haven't rotted."] };
        case "DW_SENT_02":
            return { id: "DW_SENT_02", speaker: "Caelan", lines: ["They're the same make as the Warden under the sanctuary.", "If they wake, they wake all at once."] };
        case "DW_SENT_03":
            return { id: "DW_SENT_03", speaker: "Taren", lines: ["Then we don't touch the step.", "We go around it and we look at the door first."] };
        case "DW_INTRO_01":
            return { id: "DW_INTRO_01", speaker: "", lines: ["The opening in the wall is a door's height and the thing standing in it is taller.", "It has been waiting with its hands at its sides."] };
        case "DW_INTRO_02":
            return { id: "DW_INTRO_02", speaker: "Caelan", lines: ["It's the Warden's make. Older, bigger, and it hasn't been sleeping.", "It's been standing in a doorway for however long this has been shut."] };
        case "DW_INTRO_03":
            return { id: "DW_INTRO_03", speaker: "Sera", lines: ["Does it talk?"] };
        case "DW_INTRO_04":
            return { id: "DW_INTRO_04", speaker: "Caelan", lines: ["The last one didn't.", "I don't think this one was made for talking."] };
        case "DW_INTRO_05":
            return { id: "DW_INTRO_05", speaker: "Kael", lines: ["Then we don't ask it anything.", "Weapons out."] };
        case "DW_AFTER_01":
            return { id: "DW_AFTER_01", speaker: "Taren", lines: ["It's down. The ones in the leaves went down with it.", "Same moment. Same everything."] };
        case "DW_AFTER_02":
            return { id: "DW_AFTER_02", speaker: "Caelan", lines: ["One maker, one order.", "It was never guarding the wall. It was guarding the opening."] };
        case "DW_AFTER_03":
            return { id: "DW_AFTER_03", speaker: "Lyra", lines: ["Then the opening's ours.", "Nobody's swept the step for us in a while."] };
        case "DW_AFTER_04":
            return { id: "DW_AFTER_04", speaker: "Kael", lines: ["Kael. — no. Say it plainly: we go in, we look, we come back out.", "Nobody touches the seam."] };
        case "PD_SCENE_01":
            return { id: "PD_SCENE_01", speaker: "", lines: ["The door is two stones tall and one seam wide, and the seam is dark the way a held breath is quiet."] };
        case "PD_SCENE_02":
            return { id: "PD_SCENE_02", speaker: "Caelan", lines: ["There. On the lintel. The crown around the black sun.", "The Watchtower banner. The basement. The stone at the shrine. All of it, here."] };
        case "PD_SCENE_03":
            return { id: "PD_SCENE_03", speaker: "Kael", lines: ["Mira's pendant has that mark on it.", "She had it made before any of this."] };
        case "PD_SCENE_04":
            return { id: "PD_SCENE_04", speaker: "", lines: ["The pendant is warm through the cloth before he has it out of his coat.", "It is the first time it has done anything at all."] };
        case "PD_SCENE_05":
            return { id: "PD_SCENE_05", speaker: "Sera", lines: ["Kael. The seam."] };
        case "PD_SCENE_06":
            return { id: "PD_SCENE_06", speaker: "", lines: ["Light, thin as a hair, runs the height of the seam and stops.", "From the far side, once, something answers — a sound like a word heard through a wall.", "Then nothing. The pendant cools."] };
        case "PD_SCENE_07":
            return { id: "PD_SCENE_07", speaker: "Kael", lines: ["It knows the mark. It answered the mark.", "It didn't open, and it didn't say her name."] };
        case "PD_SCENE_08":
            return { id: "PD_SCENE_08", speaker: "Caelan", lines: ["It answered and it didn't open. That's not a lock refusing a key.", "That's something on the other side saying not yet."] };
        case "PD_SCENE_09":
            return { id: "PD_SCENE_09", speaker: "Taren", lines: ["Or it's a door that only opens from inside, and whoever's inside is busy.", "I've had that thought for nine chapters. Say it out loud, someone."] };
        case "PD_SCENE_10":
            return { id: "PD_SCENE_10", speaker: "Lyra", lines: ["Then we find the inside.", "Not today, but we find it."] };
        case "PD_SCENE_11":
            return { id: "PD_SCENE_11", speaker: "Kael", lines: ["We mark the clearing. We go back to Berrin and we tell him the bowl stays dry.", "Then we find out who built a door and forgot the handle."] };
        case "ACT3_END_01":
            return { id: "ACT3_END_01", speaker: "SYSTEM", lines: ["Quest updated: Learn what the doors want.", "Chapter 8 — The Door in the Wood — Complete."] };
        case "ACT3_END_02":
            return { id: "ACT3_END_02", speaker: "SYSTEM", lines: ["Act III — The Blackwood — Complete."] };
        case "ACT3_END_03":
            return { id: "ACT3_END_03", speaker: "", lines: ["The wood is quiet behind them and the seam is dark when they look back.", "Somewhere south, a road that is not a deer trail yet."] };
        case "DW_SENT_R1":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "DW_SENT_R1", speaker: "", lines: ["The sentinel has not moved. The litter is still swept to the sides."] };
        case "DW_FIGHT_01":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "DW_FIGHT_01", speaker: "", lines: ["The Warden steps out of the doorway it has been filling."] };
        case "DW_FIGHT_02":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "DW_FIGHT_02", speaker: "SYSTEM", lines: ["The Door Warden. Boss."] };
    }
    return undefined;
}
