function scr_ch7_dialogue_node(_id) {
    switch (_id) {
        case "SH_ARRIVE_01":
            return { id: "SH_ARRIVE_01", speaker: "", lines: ["The roots give way to a stone face that was cut, not grown.", "A basin in front of it, dry, and older than the trees around it."] };
        case "SH_ARRIVE_02":
            return { id: "SH_ARRIVE_02", speaker: "Caelan", lines: ["Aethari. Same hand as the sanctuary, older work.", "They built this to be used, not admired."] };
        case "SH_ARRIVE_03":
            return { id: "SH_ARRIVE_03", speaker: "Lyra", lines: ["Used for what? There's no door.", "Just a bowl and a wall."] };
        case "SH_ARRIVE_04":
            return { id: "SH_ARRIVE_04", speaker: "Taren", lines: ["Bowl's for something going in.", "I've been in enough cells to know where this is going."] };
        case "SH_ARRIVE_05":
            return { id: "SH_ARRIVE_05", speaker: "Kael", lines: ["Spread out. Don't touch the basin until we know what it holds."] };
        case "SH_BASIN_01":
            return { id: "SH_BASIN_01", speaker: "Kael", lines: ["Dry. Not rained in, not cracked.", "Something takes what goes in here and doesn't leave a stain."] };
        case "SH_BASIN_02":
            return { id: "SH_BASIN_02", speaker: "Sera", lines: ["There's a lip worn into the stone on this side.", "People stood here. A lot of people. For a long time."] };
        case "SH_BASIN_03":
            return { id: "SH_BASIN_03", speaker: "Lyra", lines: ["Then they stopped.", "Berrin's patrols stopped. The wood noticed the difference."] };
        case "TT_MEET_01":
            return { id: "TT_MEET_01", speaker: "Berrin", lines: ["I said I wouldn't come. I came as far as the trees.", "That's as far as I've come in forty years."] };
        case "TT_MEET_02":
            return { id: "TT_MEET_02", speaker: "Kael", lines: ["Your daughter's name goes down this autumn."] };
        case "TT_MEET_03":
            return { id: "TT_MEET_03", speaker: "Berrin", lines: ["It does.", "You've seen the bowl. Now you know what \"down\" means."] };
        case "TT_MEET_04":
            return { id: "TT_MEET_04", speaker: "Sera", lines: ["And the ones who went before her are still walking."] };
        case "TT_MEET_05":
            return { id: "TT_MEET_05", speaker: "Berrin", lines: ["Yes.", "That's the custom. It's not a thing you argue with."] };
        case "TT_MEET_06":
            return { id: "TT_MEET_06", speaker: "Taren", lines: ["It's a thing you can argue with. I'm arguing with it now."] };
        case "TT_CHOICE_01":
            return { id: "TT_CHOICE_01", speaker: "Kael", lines: ["Your call, Berrin. Say it and we'll do it.", "Or say nothing and we'll go on and leave you to it."] };
        case "TT_REFUSE_01":
            return { id: "TT_REFUSE_01", speaker: "Kael", lines: ["Don't pay it. Let the wood go hungry and see what it does."] };
        case "TT_REFUSE_02":
            return { id: "TT_REFUSE_02", speaker: "Berrin", lines: ["Then you'll have my daughter's name and my house empty.", "You'll have done it from the road, mind. I'll be here."] };
        case "TT_REFUSE_03":
            return { id: "TT_REFUSE_03", speaker: "Berrin", lines: ["Go on to the glade. I'll walk back.", "I'd rather you weren't at my kiln when it gets dark."] };
        case "TT_PAY_01":
            return { id: "TT_PAY_01", speaker: "Kael", lines: ["Then choose a name from outside. Someone we bring you.", "Not your daughter. Not anyone in the hollow."] };
        case "TT_PAY_02":
            return { id: "TT_PAY_02", speaker: "Berrin", lines: ["You'd do that.", "You'd bring a stranger to a bowl in the roots and call it mercy."] };
        case "TT_PAY_03":
            return { id: "TT_PAY_03", speaker: "Taren", lines: ["I'd call it a choice someone else made for once.", "Take it or leave it, Berrin."] };
        case "TT_PAY_04":
            return { id: "TT_PAY_04", speaker: "Berrin", lines: ["Then take this, and don't tell the hollow where it came from.", "It's what we'd have paid a carrier."] };
        case "LT_MEET_01":
            return { id: "LT_MEET_01", speaker: "", lines: ["They are standing between the trees, facing the shrine.", "None of them are breathing hard. None of them blink."] };
        case "LT_MEET_02":
            return { id: "LT_MEET_02", speaker: "Caelan", lines: ["Six. Seven. More behind them.", "They're not guarding anything. They're waiting."] };
        case "LT_MEET_03":
            return { id: "LT_MEET_03", speaker: "Lyra", lines: ["That one. The boots.", "Those are the boots from the camp. Lined up by the bedroll."] };
        case "LT_MEET_04":
            return { id: "LT_MEET_04", speaker: "Taren", lines: ["The patrol went in without a fight.", "Now I know why nobody fought."] };
        case "LT_MEET_05":
            return { id: "LT_MEET_05", speaker: "Sera", lines: ["They walked here themselves.", "Look at the ground. One set of prints, going in, none coming out."] };
        case "LT_MEET_06":
            return { id: "LT_MEET_06", speaker: "Kael", lines: ["We don't touch them.", "Whatever they are now, they were people who paid."] };
        case "GL_ARRIVE_01":
            return { id: "GL_ARRIVE_01", speaker: "", lines: ["The trees stop, and this time nothing burned them.", "Across the clearing, past the far edge, two stones stand with a dark seam between them."] };
        case "GL_ARRIVE_02":
            return { id: "GL_ARRIVE_02", speaker: "Caelan", lines: ["That's not a ruin. That's a door.", "It's been shut since before the road, and it was built shut."] };
        case "GL_ARRIVE_03":
            return { id: "GL_ARRIVE_03", speaker: "Lyra", lines: ["Then what's the thing in the middle of the clearing?", "Because it's looking at us."] };
        case "MT_INTRO_01":
            return { id: "MT_INTRO_01", speaker: "", lines: ["It is the size of the shrine and it has been here longer than the hollow.", "What looks like bark is a hide, and what looks like a root is an arm."] };
        case "MT_INTRO_02":
            return { id: "MT_INTRO_02", speaker: "Caelan", lines: ["It's not guarding the door. It's guarding the clearing.", "The burners have been feeding it the same way they fed the hulk."] };
        case "MT_INTRO_03":
            return { id: "MT_INTRO_03", speaker: "Sera", lines: ["Then it has eaten better than the hollow has.", "Look at it."] };
        case "MT_INTRO_04":
            return { id: "MT_INTRO_04", speaker: "Kael", lines: ["Weapons out. We're not here for the door yet.", "We're here for the bowl."] };
        case "MT_INTRO_05":
            return { id: "MT_INTRO_05", speaker: "", lines: ["The Matriarch turns, and the clearing is smaller than it was."] };
        case "MT_PHASE_01":
            return { id: "MT_PHASE_01", speaker: "", lines: ["The hide splits along the back and something older moves under it."] };
        case "MT_AFTER_01":
            return { id: "MT_AFTER_01", speaker: "Taren", lines: ["It's dead. The ones at the shrine haven't moved.", "Not one of them."] };
        case "MT_AFTER_02":
            return { id: "MT_AFTER_02", speaker: "Caelan", lines: ["Then it was never holding them.", "It was just the biggest thing in the wood."] };
        case "MT_AFTER_03":
            return { id: "MT_AFTER_03", speaker: "Sera", lines: ["Berrin said they feed it. He didn't say what it does with what it's fed.", "Now we know: nothing. It just eats."] };
        case "MT_AFTER_04":
            return { id: "MT_AFTER_04", speaker: "Kael", lines: ["The basin's dry, the patrol's still standing, and the door's still shut.", "Take the measure of it. We're not finishing this today."] };
        case "CH7_END_01":
            return { id: "CH7_END_01", speaker: "", lines: ["The seam between the stones is dark in a way the shade is not.", "From here it looks like a door that was closed from the inside."] };
        case "CH7_END_02":
