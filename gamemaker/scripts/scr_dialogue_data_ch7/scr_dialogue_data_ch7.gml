            return { id: "SH_BASIN_R1", speaker: "", lines: ["The basin is dry, and the stone under the lip is worn smooth."] };
        case "LT_MEET_R1":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "LT_MEET_R1", speaker: "", lines: ["They are still standing where they were, facing the shrine."] };
        case "TT_MEET_R1":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "TT_MEET_R1", speaker: "Berrin", lines: ["I've said what I came to say. Go on to the glade."] };
        case "MT_FIGHT_01":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "MT_FIGHT_01", speaker: "", lines: ["The clearing is smaller than it was."] };
        case "MT_FIGHT_02":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "MT_FIGHT_02", speaker: "SYSTEM", lines: ["The Blackwood Matriarch. Boss."] };
        case "CH7_LOCKED_GLADE":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "CH7_LOCKED_GLADE", speaker: "", lines: ["Berrin is still standing where the trees start. He came this far."] };
        case "CH7_LOCKED_DOORS":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "CH7_LOCKED_DOORS", speaker: "", lines: ["The thing in the clearing is between the party and the far edge."] };
    }
