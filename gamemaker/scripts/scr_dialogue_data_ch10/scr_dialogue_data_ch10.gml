/// scr_dialogue_data_ch10 — Chapter 10 dialogue nodes, keyed by the line ids in
/// docs/story/CHAPTER10_SCRIPT.md (built Nov 16 2026 from the approved Act IV decisions).
/// GENERATED by tools/gen_ch10_dialogue.py — edit the script and re-run, do not hand-edit.
/// Speaker "" is NARRATION. The last block holds wiring-only placeholder lines.

function scr_ch10_dialogue_node(_id) {
    switch (_id) {
        case "RG_ARRIVE_01":
            return { id: "RG_ARRIVE_01", speaker: "", lines: ["The track loses its gravel, and then a mile later it has gravel again.", "Cut stone in the ditch, laid to drain. Somebody maintains this."] };
        case "RG_ARRIVE_02":
            return { id: "RG_ARRIVE_02", speaker: "Lyra", lines: ["That's not a farmer's work. That's a road gang's work.", "Paid, and paid regularly, for a long time."] };
        case "RG_ARRIVE_03":
            return { id: "RG_ARRIVE_03", speaker: "Caelan", lines: ["\"Maintained. Item not assessed.\"", "This is what the money bought. A road to something they would not write down."] };
        case "RG_ARRIVE_04":
            return { id: "RG_ARRIVE_04", speaker: "Alden", lines: ["I've been reading that page every night since Coleford, and I keep arriving at the same place.", "Somebody in the Crown has been paying for this road out of a budget nobody audits."] };
        case "RG_ARRIVE_05":
            return { id: "RG_ARRIVE_05", speaker: "Taren", lines: ["You say that like it's a revelation. I've been saying it since the ledger."] };
        case "RG_ARRIVE_06":
            return { id: "RG_ARRIVE_06", speaker: "Alden", lines: ["You've been saying it with your arms crossed. I've been saying it with a map.", "It's the same sentence. Mine travels better."] };
        case "RG_ARRIVE_07":
            return { id: "RG_ARRIVE_07", speaker: "Sera", lines: ["Both of you stop. Look at the hill."] };
        case "SP_POST_01":
            return { id: "SP_POST_01", speaker: "", lines: ["A squat stone post, cut with the Crown's survey mark. The year has worn to a shape.", "There is a second mark under it, older, chiselled flat."] };
        case "SP_POST_02":
            return { id: "SP_POST_02", speaker: "Caelan", lines: ["They cut the old mark off and put theirs on top.", "That's not a survey. That's a correction."] };
        case "SP_POST_03":
            return { id: "SP_POST_03", speaker: "Taren", lines: ["Same hand as the ledger page. Same habit.", "Somebody in this kingdom has been very busy with a chisel."] };
        case "RG_GATE_01":
            return { id: "RG_GATE_01", speaker: "", lines: ["The road ends at a gatehouse built into the hill. Two towers, a lintel, and an iron gate across the road.", "The stone is older than the Crown. The iron is newer than the Crown."] };
        case "RG_GATE_02":
            return { id: "RG_GATE_02", speaker: "Caelan", lines: ["The gate's been replaced. Twice, by the look of the hinge seats.", "The gatehouse has been here since before there was a kingdom to pay for it."] };
        case "RG_GATE_03":
            return { id: "RG_GATE_03", speaker: "Sera", lines: ["And above the arch."] };
        case "RG_GATE_04":
            return { id: "RG_GATE_04", speaker: "", lines: ["Cut into the lintel: a shallow crown, ringing a black sun.", "The same mark as the banner, the carvings under Greyhaven, the pendant, and the doors."] };
        case "RG_GATE_05":
            return { id: "RG_GATE_05", speaker: "Kael", lines: ["Fourth time. Fifth. Nobody has explained it once."] };
        case "RG_GATE_06":
            return { id: "RG_GATE_06", speaker: "Alden", lines: ["I've seen it on a hundred banners and never once looked at it.", "That's the trick, isn't it. Put a thing on everything and nobody sees it."] };
        case "RG_GATE_07":
            return { id: "RG_GATE_07", speaker: "Lyra", lines: ["The gate's shut from this side. Bolted, not locked."] };
        case "RG_GATE_08":
            return { id: "RG_GATE_08", speaker: "Taren", lines: ["Then somebody's inside."] };
        case "RG_GATE_09":
            return { id: "RG_GATE_09", speaker: "Caelan", lines: ["Or something is, and it's been bolting the door every night for a hundred years.", "Alden. You wanted a reason. This is what one looks like."] };
        case "RG_GATE_10":
            return { id: "RG_GATE_10", speaker: "Alden", lines: ["I wanted a reason. I didn't say I wanted it to be a door with something behind it.", "Open it."] };
        case "BW_INTRO_01":
            return { id: "BW_INTRO_01", speaker: "", lines: ["The bar comes off and hits the road.", "Inside the gatehouse, something iron takes a step."] };
        case "BW_INTRO_02":
            return { id: "BW_INTRO_02", speaker: "Caelan", lines: ["That's not Aethari work. Look at the plates — riveted, replaceable.", "This was built to be maintained."] };
        case "BW_INTRO_03":
            return { id: "BW_INTRO_03", speaker: "Sera", lines: ["By the same budget as the road."] };
        case "BW_INTRO_04":
            return { id: "BW_INTRO_04", speaker: "", lines: ["It comes out of the arch at a walking pace: a head taller than Taren, plated in iron, and where a face should be there is a plate with the crown-and-sun struck into it."] };
        case "BW_INTRO_05":
            return { id: "BW_INTRO_05", speaker: "Taren", lines: ["It's not going to talk."] };
        case "BW_INTRO_06":
            return { id: "BW_INTRO_06", speaker: "Kael", lines: ["No. Alden — the outer gate. Hold it, and don't be a hero."] };
        case "BW_INTRO_07":
            return { id: "BW_INTRO_07", speaker: "Alden", lines: ["I've never been a hero. I've been reliable. There's a difference, and it's the only thing I've got."] };
        case "BW_AFTER_01":
            return { id: "BW_AFTER_01", speaker: "", lines: ["The Warden comes apart the way a wall comes apart: in pieces, all at once, and then it is rubble with a sword in it.", "Behind it, the gate is open. The road goes on into the hill."] };
        case "BW_AFTER_02":
            return { id: "BW_AFTER_02", speaker: "Alden", lines: ["I held the gate."] };
        case "BW_AFTER_03":
            return { id: "BW_AFTER_03", speaker: "Lyra", lines: ["You held the gate."] };
        case "BW_AFTER_04":
            return { id: "BW_AFTER_04", speaker: "Alden", lines: ["I'd like that recorded. Somewhere. In one of your ledgers."] };
        case "BW_AFTER_05":
            return { id: "BW_AFTER_05", speaker: "Taren", lines: ["You all right?"] };
        case "BW_AFTER_06":
            return { id: "BW_AFTER_06", speaker: "Alden", lines: ["No. I've just watched a thing made of iron and promises get up off the ground twice.", "I'm going to need a minute, and then I'm going to want to know who wrote the promises."] };
        case "BW_AFTER_07":
            return { id: "BW_AFTER_07", speaker: "Caelan", lines: ["That's the right question. It's also the one nobody in this kingdom has been allowed to ask."] };
        case "BW_AFTER_08":
            return { id: "BW_AFTER_08", speaker: "Sera", lines: ["Then we ask it inside."] };
        case "CH10_END_01":
            return { id: "CH10_END_01", speaker: "", lines: ["Past the gate the road becomes steps, cut down into the hill.", "The air coming up them is cold, dry, and moving."] };
        case "CH10_END_02":
            return { id: "CH10_END_02", speaker: "Caelan", lines: ["Ventilation. Somebody built this to be breathed in.", "Tombs don't need air. This isn't only a tomb."] };
        case "CH10_END_03":
            return { id: "CH10_END_03", speaker: "Lyra", lines: ["Then what is it?"] };
        case "CH10_END_04":
            return { id: "CH10_END_04", speaker: "Caelan", lines: ["A place somebody expected to come back from."] };
        case "CH10_END_05":
            return { id: "CH10_END_05", speaker: "Alden", lines: ["The page said \"the fifth holding\". No name, no tax line, no road on any map.", "We're standing on the road. There's a holding under it."] };
        case "CH10_END_06":
            return { id: "CH10_END_06", speaker: "Taren", lines: ["And the Crown's been paying to keep the door shut and the air moving.", "For a hundred years. For a thing it won't write down."] };
        case "CH10_END_07":
            return { id: "CH10_END_07", speaker: "Sera", lines: ["Whatever's down there, it was important enough to guard and shameful enough to forget.", "Both. At once. That's what we're walking into."] };
        case "CH10_END_08":
            return { id: "CH10_END_08", speaker: "Kael", lines: ["Then we walk in rested, with everything we brought, and we don't split up.", "Alden, stay behind Caelan. You're not the only one who wants to ask the question, and I'd like us all to get to ask it."] };
        case "CH10_END_09":
            return { id: "CH10_END_09", speaker: "SYSTEM", lines: ["Quest updated: Open the tomb of the forgotten king.", "Chapter 10 — The Barrow Road — Complete."] };
        case "SP_POST_R1":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "SP_POST_R1", speaker: "", lines: ["The Crown's mark sits on top of an older one, chiselled flat."] };
        case "RG_GATE_R1":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "RG_GATE_R1", speaker: "", lines: ["The gate stands open. The bar is on the road where it fell."] };
        case "BW_RETRY_01":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "BW_RETRY_01", speaker: "", lines: ["The Warden has rebuilt its guard. It has not left the arch."] };
        case "CH10_LOCKED":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "CH10_LOCKED", speaker: "", lines: ["The steps go down into the hill.", "The Warden is still between the party and them."] };
    }
    return undefined;
}
