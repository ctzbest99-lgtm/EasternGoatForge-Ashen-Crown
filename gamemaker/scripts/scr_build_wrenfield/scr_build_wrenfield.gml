/// scr_build_wrenfield(): fills rm_wrenfield (56x44 tiles, 896x704 px) from embedded data. Wrenfield: checkpoints, the square and the gallows, The Bent Post, Len's store, the west road.
/// Call from the room's Creation Code. Generated by wrenfield/src/export_wf.py. Uses the ts_wrenfield tileset.
function scr_build_wrenfield() {
    scr_wf_prepare_layers(56, 44);
    scr_map_build_from_arrays(scr_wrenfield_data(), 56, 44);
    if (scr_map_flag_get("flag_execution_stopped")) scr_wf_apply_patch(scr_wrenfield_after_patch());   // before -> after
    scr_map_spawn_markers(scr_wf_filter_markers(scr_wrenfield_markers()));
    scr_map_enable_camera(320, 180);   // repo addition (as in the Zone 1 builders)
    scr_camera_follow_player();
}

