/// scr_dialogue_data_ch4 — Chapter 4 dialogue nodes, keyed by the line ids in
/// docs/story/CHAPTER4_SCRIPT.md (approved Nov 15 2026). Text is verbatim.
/// GENERATED by tools/gen_ch4_dialogue.py — edit the script and re-run, do not hand-edit.
/// Speaker "" is NARRATION. The last block holds the wiring pass's placeholder lines (not in the script).

function scr_ch4_dialogue_node(_id) {
    switch (_id) {
        case "HS_ENTER_01":
            return { id: "HS_ENTER_01", speaker: "Taren", lines: ["One day from the walls and the road's already forgotten us.", "No patrols. No farm smoke. Just hills that don't answer."] };
        case "HS_ENTER_02":
            return { id: "HS_ENTER_02", speaker: "Lyra", lines: ["Hills don't charge tolls. I'm not complaining.", "Keep your eyes down. Old stone leaves a seam you can follow."] };
        case "HS_ENTER_03":
            return { id: "HS_ENTER_03", speaker: "Kael", lines: ["The notes said a hollow in the hills.", "Doors still standing."] };
        case "HS_ENTER_04":
            return { id: "HS_ENTER_04", speaker: "Taren", lines: ["Alden would call this a week wasted on a scholar's map.", "He'd still be standing here with us if the city let him go."] };
        case "HS_ENTER_05":
            return { id: "HS_ENTER_05", speaker: "Lyra", lines: ["If the door's dead, we climb back out and I sell the map."] };
        case "HS_ENTER_06":
            return { id: "HS_ENTER_06", speaker: "Kael", lines: ["It won't be dead."] };
        case "HS_SIGN_01":
            return { id: "HS_SIGN_01", speaker: "", lines: ["A waystone, half-sunk. The carved name is worn past reading.", "Someone has scratched a newer mark beneath it: a crown, and a line through it."] };
        case "HS_SHEP_01":
            return { id: "HS_SHEP_01", speaker: "Shepherd", lines: ["You're walking toward the hollow. Nothing there but doors", "that don't open and a wind that comes from the wrong way."] };
        case "HS_SHEP_02":
            return { id: "HS_SHEP_02", speaker: "Taren", lines: ["Wrong way how?"] };
        case "HS_SHEP_03":
            return { id: "HS_SHEP_03", speaker: "Shepherd", lines: ["Out of the hill, not over it. I don't go past the second stone."] };
        case "HS_DOOR_01":
            return { id: "HS_DOOR_01", speaker: "", lines: ["The hollow is a bowl of grass and old stone.", "Two doors stand in the hill, taller than any keep's gate."] };
        case "HS_DOOR_02":
            return { id: "HS_DOOR_02", speaker: "Kael", lines: ["Architect work. Same as the Watchtower."] };
        case "HS_DOOR_03":
            return { id: "HS_DOOR_03", speaker: "Lyra", lines: ["No hinges. No bar. And it's been open a hand's width", "since before any of us were born."] };
        case "HS_DOOR_04":
            return { id: "HS_DOOR_04", speaker: "Taren", lines: ["Then it opens the rest of the way. Put your back in it."] };
        case "HS_DOOR_05":
            return { id: "HS_DOOR_05", speaker: "", lines: ["Letters cut deep above the doors, older than the road outside:", "\"Here the Aethari set the first stone of the Veil.\""] };
        case "HS_DOOR_06":
            return { id: "HS_DOOR_06", speaker: "Kael", lines: ["Aethari."] };
        case "HS_DOOR_07":
            return { id: "HS_DOOR_07", speaker: "Lyra", lines: ["Is that a name, or a warning?"] };
        case "HS_DOOR_08":
            return { id: "HS_DOOR_08", speaker: "Taren", lines: ["Architects, the priests call them. This isn't a priest's word.", "Somebody wrote what they called themselves."] };
        case "HS_DOOR_09":
            return { id: "HS_DOOR_09", speaker: "Kael", lines: ["Then we find someone who can read the rest."] };
        case "HS_HALLS_01":
            return { id: "HS_HALLS_01", speaker: "", lines: ["A corridor of stone doors, most of them open.", "The dust is undisturbed except where something has walked."] };
        case "HS_HALLS_02":
            return { id: "HS_HALLS_02", speaker: "Lyra", lines: ["Something's been through here. Recently.", "Boots, not claws. One set."] };
        case "HS_HALLS_03":
            return { id: "HS_HALLS_03", speaker: "Taren", lines: ["Then we're not the first to find the door."] };
        case "HS_HALLS_04":
            return { id: "HS_HALLS_04", speaker: "Kael", lines: ["We're the first to be expected."] };
        case "HS_LORE_01_01":
            return { id: "HS_LORE_01_01", speaker: "", lines: ["A wall of small cut marks, thousands of them, worn to lines.", "Near the bottom, a few late ones still read as words."] };
        case "HS_LORE_01_02":
            return { id: "HS_LORE_01_02", speaker: "", lines: ["LUMEN. THE ENGINE. THE VEIL STANDS."] };
        case "HS_LORE_01_03":
            return { id: "HS_LORE_01_03", speaker: "Taren", lines: ["Lumen. That's a word I've heard in temple, and never explained."] };
        case "HS_LORE_01_04":
            return { id: "HS_LORE_01_04", speaker: "Lyra", lines: ["Every temple word is like that. It's how they keep the collection plate full."] };
        case "HS_LORE_02_01":
            return { id: "HS_LORE_02_01", speaker: "", lines: ["A door sealed with a ring of pale stone, warm under the hand.", "No handle. No seam. It does not answer."] };
        case "HS_LORE_02_02":
            return { id: "HS_LORE_02_02", speaker: "Kael", lines: ["Another one that won't open."] };
        case "HS_LORE_02_03":
            return { id: "HS_LORE_02_03", speaker: "Lyra", lines: ["This one isn't asking us to. It's asking us to leave it alone."] };
        case "HS_LORE_03_01":
            return { id: "HS_LORE_03_01", speaker: "", lines: ["At the foot of the stair, a lamp burns with a steady, unflickering light.", "Someone has trimmed the wick. Someone has been here for a while."] };
        case "HS_LORE_03_02":
            return { id: "HS_LORE_03_02", speaker: "Taren", lines: ["That's a scholar's lamp. No soldier carries a lamp like that."] };
        case "HS_LORE_03_03":
            return { id: "HS_LORE_03_03", speaker: "Kael", lines: ["Then we go quietly and ask him to keep it lit."] };
        case "CA_MEET_01":
            return { id: "CA_MEET_01", speaker: "", lines: ["A long hall of shelves, most of them empty.", "At the far end, a lamp. Someone has been here long enough to need one."] };
        case "CA_MEET_02":
            return { id: "CA_MEET_02", speaker: "Caelan", lines: ["Stop there.", "You're wearing a soldier's boots."] };
        case "CA_MEET_03":
            return { id: "CA_MEET_03", speaker: "Kael", lines: ["Not anymore."] };
        case "CA_MEET_04":
            return { id: "CA_MEET_04", speaker: "Caelan", lines: ["That's what the last ones said. They had horses.", "You don't. That's something."] };
        case "CA_MEET_05":
            return { id: "CA_MEET_05", speaker: "Taren", lines: ["We're not Crown. We're looking for a way through the Veil."] };
        case "CA_MEET_06":
            return { id: "CA_MEET_06", speaker: "Caelan", lines: ["Everyone with a sword is looking for something.", "Say it in one sentence. I'm busy not being found."] };
        case "CA_MEET_07":
            return { id: "CA_MEET_07", speaker: "Kael", lines: ["The door at the Crownveil didn't open. My sister crossed it.", "I need to know how."] };
        case "CA_MEET_08":
            return { id: "CA_MEET_08", speaker: "Caelan", lines: ["And you came to a dead sanctuary for that.", "At least you came to the right century."] };
        case "CA_MEET_09":
            return { id: "CA_MEET_09", speaker: "Lyra", lines: ["He talks like a ledger. Can we buy the short version?"] };
        case "CA_MEET_10":
            return { id: "CA_MEET_10", speaker: "Caelan", lines: ["The short version is a name."] };
        case "CA_MEET_11":
            return { id: "CA_MEET_11", speaker: "Caelan", lines: ["The Architects. That's what the textbooks call them.", "They called themselves the Aethari."] };
        case "CA_MEET_12":
            return { id: "CA_MEET_12", speaker: "Kael", lines: ["Aethari."] };
        case "CA_MEET_13":
            return { id: "CA_MEET_13", speaker: "Taren", lines: ["And you know that because...?"] };
        case "CA_MEET_14":
            return { id: "CA_MEET_14", speaker: "Caelan", lines: ["Because I used to be paid to know things.", "Then I stopped being paid, and started being hunted."] };
        case "CA_MEET_15":
            return { id: "CA_MEET_15", speaker: "Kael", lines: ["What did they build the Veil for?"] };
        case "CA_MEET_16":
            return { id: "CA_MEET_16", speaker: "Caelan", lines: ["They understood Lumen. They built the Crown Engine.", "That's the whole of what I'll say standing in a hallway."] };
        case "CA_MEET_17":
            return { id: "CA_MEET_17", speaker: "Kael", lines: ["That's a name and a machine. Not an answer."] };
        case "CA_MEET_18":
            return { id: "CA_MEET_18", speaker: "Caelan", lines: ["If I told you what I think, you would take it for an answer.", "It isn't one yet."] };
        case "CA_MEET_19":
            return { id: "CA_MEET_19", speaker: "Lyra", lines: ["Wonderful. A scholar with a secret and no horse."] };
        case "CA_MEET_20":
            return { id: "CA_MEET_20", speaker: "Caelan", lines: ["You're carrying paper. The Crown's seal is on the corner.", "Where did you get it?"] };
        case "CA_MEET_21":
            return { id: "CA_MEET_21", speaker: "Lyra", lines: ["A warehouse. We're thieves. Try to keep up."] };
        case "CA_MEET_22":
            return { id: "CA_MEET_22", speaker: "Caelan", lines: ["Then you already know more than you should."] };
        case "CA_MEET_23":
            return { id: "CA_MEET_23", speaker: "Taren", lines: ["We know enough to knock. We don't know enough to walk through."] };
        case "CA_MEET_24":
            return { id: "CA_MEET_24", speaker: "Caelan", lines: ["The inner door is this way. Don't touch the records.", "The Warden counts them."] };
        case "CA_MEET_25":
            return { id: "CA_MEET_25", speaker: "Kael", lines: ["The Warden."] };
        case "CA_MEET_26":
            return { id: "CA_MEET_26", speaker: "Caelan", lines: ["You'll meet it. Try not to be counted."] };
        case "CA_MEET_R1":
            return { id: "CA_MEET_R1", speaker: "Caelan", lines: ["The inner door first. Questions after, if we're both still standing."] };
        case "SW_INTRO_01":
            return { id: "SW_INTRO_01", speaker: "", lines: ["The far wall unfolds. Stone separates from stone without dust.", "Something the size of a gate takes a step."] };
        case "SW_INTRO_02":
            return { id: "SW_INTRO_02", speaker: "Taren", lines: ["That's not a door."] };
        case "SW_INTRO_03":
            return { id: "SW_INTRO_03", speaker: "Caelan", lines: ["It kept the inner door shut for a very long time.", "Stand back from the shelves."] };
        case "SW_INTRO_04":
            return { id: "SW_INTRO_04", speaker: "Lyra", lines: ["I hate old buildings."] };
        case "SW_INTRO_05":
            return { id: "SW_INTRO_05", speaker: "Kael", lines: ["Then let's be quick about leaving one."] };
        case "SW_SYS_01":
            return { id: "SW_SYS_01", speaker: "SYSTEM", lines: ["Caelan Rook has joined the party.", "He takes the fourth party slot."] };
        case "SW_DEFEAT_01":
            return { id: "SW_DEFEAT_01", speaker: "", lines: ["The Warden folds in on itself, plate by plate.", "The hall is quiet in a way it wasn't before."] };
        case "SW_DEFEAT_02":
            return { id: "SW_DEFEAT_02", speaker: "Caelan", lines: ["It counted them for a long time.", "It won't count anything now."] };
        case "SW_DEFEAT_03":
            return { id: "SW_DEFEAT_03", speaker: "Taren", lines: ["That thing was the lock on your inner door."] };
        case "SW_DEFEAT_04":
            return { id: "SW_DEFEAT_04", speaker: "Caelan", lines: ["It kept the door closed. That's all it ever did."] };
        case "SW_DEFEAT_05":
            return { id: "SW_DEFEAT_05", speaker: "Kael", lines: ["Then open it."] };
        case "SW_DEFEAT_06":
            return { id: "SW_DEFEAT_06", speaker: "Caelan", lines: ["Not yet. Whatever's behind it has waited this long.", "It can wait until we know what we're carrying."] };
        case "CA_JOIN_01":
            return { id: "CA_JOIN_01", speaker: "Caelan", lines: ["You should go. It will be quiet here for a while.", "Quiet is what people like me are supposed to want."] };
        case "CA_JOIN_02":
            return { id: "CA_JOIN_02", speaker: "Kael", lines: ["You could stay."] };
        case "CA_JOIN_03":
            return { id: "CA_JOIN_03", speaker: "Caelan", lines: ["I could. I've done it for a year.", "The Crown would rather a vanished scholar than a talking one."] };
        case "CA_JOIN_04":
            return { id: "CA_JOIN_04", speaker: "Taren", lines: ["Then don't vanish. Walk out with us."] };
        case "CA_JOIN_05":
            return { id: "CA_JOIN_05", speaker: "Caelan", lines: ["Greyhaven.", "I heard about it from a carter. I didn't come."] };
        case "CA_JOIN_06":
            return { id: "CA_JOIN_06", speaker: "Caelan", lines: ["I told myself there was nothing to do from a hill.", "That was true right up until it wasn't."] };
        case "CA_JOIN_07":
            return { id: "CA_JOIN_07", speaker: "Kael", lines: ["We're going to the Blackwood next. There's a garrison with answers."] };
        case "CA_JOIN_08":
            return { id: "CA_JOIN_08", speaker: "Caelan", lines: ["Then I'll come as far as the answers.", "After that, we'll see what I'm worth."] };
        case "CA_JOIN_09":
            return { id: "CA_JOIN_09", speaker: "Lyra", lines: ["Another scholar. Wonderful. Do you have coin?"] };
        case "CA_JOIN_10":
            return { id: "CA_JOIN_10", speaker: "Caelan", lines: ["No."] };
        case "CA_JOIN_11":
            return { id: "CA_JOIN_11", speaker: "Lyra", lines: ["Then you're my favorite kind of problem."] };
        case "CA_JOIN_12":
            return { id: "CA_JOIN_12", speaker: "Kael", lines: ["Welcome to it."] };
        case "CA_SYS_01":
            return { id: "CA_SYS_01", speaker: "SYSTEM", lines: ["Caelan Rook has joined the party.", "He takes the fourth party slot."] };
        case "CA_SYS_02":
            return { id: "CA_SYS_02", speaker: "SYSTEM", lines: ["Weapon: spellbook.", "Starting skills: Ember, Frost Lance, and Arc Bolt."] };
        case "CA_SYS_03":
            return { id: "CA_SYS_03", speaker: "SYSTEM", lines: ["Ember: fire damage. Frost Lance: ice damage.", "Arc Bolt: lightning damage."] };
        case "CA_SYS_04":
            return { id: "CA_SYS_04", speaker: "SYSTEM", lines: ["The active party is full at four.", "The reserve slot stays empty until the garrison."] };
        case "CA_SYS_05":
            return { id: "CA_SYS_05", speaker: "SYSTEM", lines: ["Foes have weaknesses. Fire, ice and lightning don't all land the same.", "Watch what the hit says."] };
        case "CA_JOIN_R1":
            return { id: "CA_JOIN_R1", speaker: "Caelan", lines: ["I'll want the notes eventually. Not today.", "Today I'd rather know which road we're taking."] };
        case "HS_R1":
            return { id: "HS_R1", speaker: "Lyra", lines: ["He's quiet, he's broke, and he knows things.", "Two out of three is better than most of my jobs."] };
        case "HS_HANDOFF_01":
            return { id: "HS_HANDOFF_01", speaker: "Taren", lines: ["Garrison on the Blackwood road. A day, maybe two.", "Crown post, so we walk in with our hands where they can see them."] };
        case "HS_HANDOFF_02":
            return { id: "HS_HANDOFF_02", speaker: "Lyra", lines: ["They'll count us before we knock."] };
        case "HS_HANDOFF_03":
            return { id: "HS_HANDOFF_03", speaker: "Caelan", lines: ["Let them count. It's the records I want."] };
        case "HS_HANDOFF_04":
            return { id: "HS_HANDOFF_04", speaker: "Kael", lines: ["Then we walk."] };
        case "HS_HANDOFF_05":
            return { id: "HS_HANDOFF_05", speaker: "SYSTEM", lines: ["Quest updated: Investigate the Blackwood Road Garrison."] };
        case "HS_HANDOFF_06":
            return { id: "HS_HANDOFF_06", speaker: "SYSTEM", lines: ["Chapter 4 — The Old Name — Complete."] };
        case "HS_SAVE":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "HS_SAVE", speaker: "", lines: ["(The hollow is quiet behind you. A good place to stop.)"] };
        case "HS_SHEP_R1":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "HS_SHEP_R1", speaker: "", lines: ["The shepherd has already turned back toward the road."] };
        case "SW_LOCKED":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "SW_LOCKED", speaker: "", lines: ["The inner door is shut.", "The scholar by the shelves is watching you."] };
        case "SW_DOOR_AFTER":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "SW_DOOR_AFTER", speaker: "", lines: ["The inner door stands shut. Whatever is behind it can wait."] };
    }
    return undefined;
}
