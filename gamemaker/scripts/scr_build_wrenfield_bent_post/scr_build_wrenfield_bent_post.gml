/// scr_build_wrenfield_bent_post(): fills rm_wrenfield_bent_post (24x16 tiles, 384x256 px) from embedded data. The Bent Post inn: closed (chairs up, cold hearth, shutters) before the rescue, open after.
/// Call from the room's Creation Code. Generated by wrenfield/src/export_wf.py. Uses the ts_wrenfield tileset.
function scr_build_wrenfield_bent_post() {
    scr_wf_prepare_layers(24, 16);
    scr_map_build_from_arrays(scr_wrenfield_bent_post_data(), 24, 16);
    if (scr_map_flag_get("flag_execution_stopped")) scr_wf_apply_patch(scr_wrenfield_bent_post_open_patch());   // closed -> open
    scr_map_spawn_markers(scr_wf_filter_markers(scr_wrenfield_bent_post_markers()));
    scr_map_enable_camera(320, 180);   // repo addition (as in the Zone 1 builders)
    scr_camera_follow_player();
}

