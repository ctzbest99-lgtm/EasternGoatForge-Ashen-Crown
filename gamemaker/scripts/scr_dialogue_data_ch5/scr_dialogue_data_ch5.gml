/// scr_dialogue_data_ch5 — Chapter 5 dialogue nodes, keyed by the line ids in
/// docs/story/CHAPTER5_SCRIPT.md (approved Nov 16 2026). Text is verbatim.
/// GENERATED by tools/gen_ch5_dialogue.py — edit the script and re-run, do not hand-edit.
/// Speaker "" is NARRATION. The last block holds the wiring pass's placeholder lines (not in the script).

function scr_ch5_dialogue_node(_id) {
    switch (_id) {
        case "BG_ENTER_01":
            return { id: "BG_ENTER_01", speaker: "Taren", lines: ["Crown post on a forest road. Half a company, maybe less.", "They'll have a ledger and a bad temper."] };
        case "BG_ENTER_02":
            return { id: "BG_ENTER_02", speaker: "Lyra", lines: ["Every post has a ledger.", "The trick is not getting written into it."] };
        case "BG_ENTER_03":
            return { id: "BG_ENTER_03", speaker: "Caelan", lines: ["Patrol reports. Sealed orders. A post like this keeps copies.", "The Blackwood is a day in from their gate."] };
        case "BG_ENTER_04":
            return { id: "BG_ENTER_04", speaker: "Kael", lines: ["Then we ask politely, read what they've written, and leave."] };
        case "BG_ENTER_05":
            return { id: "BG_ENTER_05", speaker: "Taren", lines: ["A rebel captain, a thief and a scholar walk up to a Crown gate.", "\"Politely\" is carrying a lot of weight in that sentence."] };
        case "BG_ENTER_06":
            return { id: "BG_ENTER_06", speaker: "Caelan", lines: ["I'm not a scholar. I'm a deserter with a spellbook.", "The paperwork is different."] };
        case "BG_ENTER_07":
            return { id: "BG_ENTER_07", speaker: "Lyra", lines: ["Then we're three deserters and a rebel.", "No wonder the road's so quiet."] };
        case "BG_NOTICE_01":
            return { id: "BG_NOTICE_01", speaker: "", lines: ["A Crown notice board at the bend, most of it older than the trees.", "One sheet is fresh, and the ink hasn't faded."] };
        case "BG_NOTICE_02":
            return { id: "BG_NOTICE_02", speaker: "", lines: ["DESERTER. SILVER GUARD.", "THORN, S. — LAST SEEN ON THE BLACKWOOD ROAD. REWARD."] };
        case "BG_NOTICE_03":
            return { id: "BG_NOTICE_03", speaker: "Taren", lines: ["Silver Guard. That's a long fall from the palace.", "Or a short walk out of it."] };
        case "BG_NOTICE_04":
            return { id: "BG_NOTICE_04", speaker: "Kael", lines: ["We're not bounty hunters."] };
        case "BG_NOTICE_05":
            return { id: "BG_NOTICE_05", speaker: "Lyra", lines: ["No. But we are looking for records.", "A post holding a deserter will have plenty of both."] };
        case "BG_NOTICE_06":
            return { id: "BG_NOTICE_06", speaker: "Caelan", lines: ["A Silver Guard wouldn't run for coin.", "Whatever she left over, she left it for a reason."] };
        case "BG_GATE_01":
            return { id: "BG_GATE_01", speaker: "Sergeant", lines: ["State it."] };
        case "BG_GATE_02":
            return { id: "BG_GATE_02", speaker: "Taren", lines: ["Road's worse further on. We're looking for a way through."] };
        case "BG_GATE_03":
            return { id: "BG_GATE_03", speaker: "Sergeant", lines: ["Road's not closed. It's just not safe.", "Names. All of them."] };
        case "BG_GATE_04":
            return { id: "BG_GATE_04", speaker: "Kael", lines: ["Kael Varyn. Taren Holt."] };
        case "BG_GATE_05":
            return { id: "BG_GATE_05", speaker: "Sergeant", lines: ["Holt.", "Say that again."] };
        case "BG_GATE_06":
            return { id: "BG_GATE_06", speaker: "Taren", lines: ["You heard it the first time."] };
        case "BG_GATE_07":
            return { id: "BG_GATE_07", speaker: "Sergeant", lines: ["Hands where I can see them. All of you.", "Pikes up. Not on the ground — on them."] };
        case "BG_GATE_08":
            return { id: "BG_GATE_08", speaker: "Lyra", lines: ["Told you. Ledger."] };
        case "BG_GATE_09":
            return { id: "BG_GATE_09", speaker: "Sergeant", lines: ["Commander wants a word with this lot.", "Walk ahead of the pikes, and don't be clever."] };
        case "BG_GATE_10":
            return { id: "BG_GATE_10", speaker: "Caelan", lines: ["Four of us, six of them, and a locked gate behind.", "We do this the slow way or not at all."] };
        case "BG_YARD_01":
            return { id: "BG_YARD_01", speaker: "", lines: ["A yard of packed earth: a well, a cold forge, a cell block in the wall.", "Two pikemen are bringing someone out of it."] };
        case "BG_YARD_02":
            return { id: "BG_YARD_02", speaker: "Lyra", lines: ["That's a Silver Guard coat."] };
        case "BG_YARD_03":
            return { id: "BG_YARD_03", speaker: "Caelan", lines: ["With the crest cut off.", "That's not a soldier. That's a message."] };
        case "BG_YARD_04":
            return { id: "BG_YARD_04", speaker: "Kael", lines: ["About what?"] };
        case "BG_YARD_05":
            return { id: "BG_YARD_05", speaker: "Caelan", lines: ["About what happens to the ones who leave."] };
        case "BG_YARD_06":
            return { id: "BG_YARD_06", speaker: "Sera", lines: ["You're not Crown."] };
        case "BG_YARD_07":
            return { id: "BG_YARD_07", speaker: "Kael", lines: ["Not anymore."] };
        case "BG_YARD_08":
            return { id: "BG_YARD_08", speaker: "Sera", lines: ["Then you're either very lost or very stupid.", "The commander will want to know which."] };
        case "BG_YARD_09":
            return { id: "BG_YARD_09", speaker: "Taren", lines: ["We're looking for records. Blackwood patrols.", "Missing men, missing carts."] };
        case "BG_YARD_10":
            return { id: "BG_YARD_10", speaker: "Sera", lines: ["Of course you are."] };
        case "BG_YARD_11":
            return { id: "BG_YARD_11", speaker: "Sera", lines: ["They're in the room behind the commander.", "He keeps them close because he thinks they'll save him."] };
        case "BG_YARD_12":
            return { id: "BG_YARD_12", speaker: "Lyra", lines: ["Will they?"] };
        case "BG_YARD_13":
            return { id: "BG_YARD_13", speaker: "Sera", lines: ["No."] };
        case "BG_YARD_14":
            return { id: "BG_YARD_14", speaker: "Sergeant", lines: ["That's enough out of the deserter.", "Sit her down. Commander's coming."] };
        case "SR_MEET_01":
            return { id: "SR_MEET_01", speaker: "Kael", lines: ["Sera Thorn."] };
        case "SR_MEET_02":
            return { id: "SR_MEET_02", speaker: "Sera", lines: ["That's on a notice, not a name.", "Try again."] };
        case "SR_MEET_03":
            return { id: "SR_MEET_03", speaker: "Kael", lines: ["Seraphine Thorn. Silver Guard.", "You left."] };
        case "SR_MEET_04":
            return { id: "SR_MEET_04", speaker: "Sera", lines: ["Everyone leaves eventually.", "Some of us just get written down for it."] };
        case "SR_MEET_05":
            return { id: "SR_MEET_05", speaker: "Taren", lines: ["We're not here to take you back."] };
        case "SR_MEET_06":
            return { id: "SR_MEET_06", speaker: "Sera", lines: ["I know. You're here for the reports.", "The whole yard heard you ask."] };
        case "SR_MEET_07":
            return { id: "SR_MEET_07", speaker: "Caelan", lines: ["You were Silver Guard. Palace duty, by the coat."] };
        case "SR_MEET_08":
            return { id: "SR_MEET_08", speaker: "Sera", lines: ["*(a beat)*", "Ask me something I'll answer."] };
        case "SR_MEET_09":
            return { id: "SR_MEET_09", speaker: "Caelan", lines: ["The Blackwood. Patrols are vanishing.", "What did the Crown write down about it?"] };
        case "SR_MEET_10":
            return { id: "SR_MEET_10", speaker: "Sera", lines: ["Missing men. Missing carts. A stone door.", "The same three lines, rewritten every month."] };
        case "SR_MEET_11":
            return { id: "SR_MEET_11", speaker: "Kael", lines: ["A stone door."] };
        case "SR_MEET_12":
            return { id: "SR_MEET_12", speaker: "Sera", lines: ["And a sealed order telling this post to stop looking.", "That's the part the commander won't hand over."] };
        case "SR_MEET_13":
            return { id: "SR_MEET_13", speaker: "Taren", lines: ["Why are you still here? You could have run."] };
        case "SR_MEET_14":
            return { id: "SR_MEET_14", speaker: "Sera", lines: ["I did run. This is where they caught me."] };
        case "SR_MEET_15":
            return { id: "SR_MEET_15", speaker: "Sera", lines: ["And I'm not running from a post I already left.", "That's not desertion. That's cowardice with a head start."] };
        case "SR_MEET_16":
            return { id: "SR_MEET_16", speaker: "Lyra", lines: ["I like her."] };
        case "SR_MEET_17":
            return { id: "SR_MEET_17", speaker: "Taren", lines: ["You would."] };
        case "HL_INTRO_01":
            return { id: "HL_INTRO_01", speaker: "", lines: ["Boots on the yard stones. Unhurried.", "The sergeant steps back without being told to."] };
        case "HL_INTRO_02":
            return { id: "HL_INTRO_02", speaker: "Hailen", lines: ["Taren Holt.", "I'd hoped the report was wrong."] };
        case "HL_INTRO_03":
            return { id: "HL_INTRO_03", speaker: "Taren", lines: ["It usually isn't."] };
        case "HL_INTRO_04":
            return { id: "HL_INTRO_04", speaker: "Hailen", lines: ["No. It usually isn't."] };
        case "HL_INTRO_05":
            return { id: "HL_INTRO_05", speaker: "Hailen", lines: ["You've met my deserter.", "She's told you about the woods, I expect."] };
        case "HL_INTRO_06":
            return { id: "HL_INTRO_06", speaker: "Kael", lines: ["She's told us what's written down."] };
        case "HL_INTRO_07":
            return { id: "HL_INTRO_07", speaker: "Hailen", lines: ["Then you know this post is under orders not to look.", "I intend to keep following them."] };
        case "HL_INTRO_08":
            return { id: "HL_INTRO_08", speaker: "Caelan", lines: ["Men are disappearing under those trees.", "Orders don't make them come back."] };
        case "HL_INTRO_09":
            return { id: "HL_INTRO_09", speaker: "Hailen", lines: ["No. But they keep the rest of my men from disappearing too.", "That's the arithmetic I have."] };
        case "HL_INTRO_10":
            return { id: "HL_INTRO_10", speaker: "Taren", lines: ["The arithmetic's wrong."] };
        case "HL_INTRO_11":
            return { id: "HL_INTRO_11", speaker: "Hailen", lines: ["Possibly.", "You'll forgive me if I don't take a rebel captain's word for it."] };
        case "HL_INTRO_12":
            return { id: "HL_INTRO_12", speaker: "Sera", lines: ["Commander. Let them take the reports.", "They'll walk into the woods either way."] };
        case "HL_INTRO_13":
            return { id: "HL_INTRO_13", speaker: "Hailen", lines: ["And if they walk back out with a rebellion behind them?"] };
        case "HL_INTRO_14":
            return { id: "HL_INTRO_14", speaker: "Sera", lines: ["Then you'll have a rebellion, and the reports will still be a", "month old, and the men will still be missing."] };
        case "HL_INTRO_15":
            return { id: "HL_INTRO_15", speaker: "Hailen", lines: ["You broke an oath, Thorn.", "Don't lecture me about missing men."] };
        case "HL_INTRO_16":
            return { id: "HL_INTRO_16", speaker: "Sera", lines: ["I know what I broke.", "I know what I kept."] };
        case "HL_INTRO_17":
            return { id: "HL_INTRO_17", speaker: "Hailen", lines: ["Holt goes to the cells. The rest of you will be questioned.", "The deserter goes to the capital with the next wagon."] };
        case "HL_INTRO_18":
            return { id: "HL_INTRO_18", speaker: "Taren", lines: ["You don't want to do this."] };
        case "HL_INTRO_19":
            return { id: "HL_INTRO_19", speaker: "Hailen", lines: ["No.", "Draw."] };
        case "HL_CHOICE_01":
            return { id: "HL_CHOICE_01", speaker: "Sera", lines: ["He's not a bad man. He's a tired one.", "If he yields, let him."] };
        case "HL_CHOICE_02":
            return { id: "HL_CHOICE_02", speaker: "Kael", lines: ["He put us in a cell."] };
        case "HL_CHOICE_03":
            return { id: "HL_CHOICE_03", speaker: "Sera", lines: ["He put me in one too.", "Your call. I've made worse."] };
        case "HL_CHOICE_04":
            return { id: "HL_CHOICE_04", speaker: "Sera", lines: ["Then keep your word.", "He'll remember it longer than you will."] };
        case "HL_CHOICE_05":
            return { id: "HL_CHOICE_05", speaker: "Sera", lines: ["Your call.", "I've made worse."] };
        case "HL_FIGHT_01":
            return { id: "HL_FIGHT_01", speaker: "Hailen", lines: ["Garrison. Hold the post.", "Not the road. The post."] };
        case "HL_FIGHT_02":
            return { id: "HL_FIGHT_02", speaker: "SYSTEM", lines: ["Commander Hailen and the garrison have drawn steel."] };
        case "HL_FIGHT_03":
            return { id: "HL_FIGHT_03", speaker: "Hailen", lines: ["You're better than the reports said.", "It won't be enough."] };
        case "HL_FIGHT_04":
            return { id: "HL_FIGHT_04", speaker: "Hailen", lines: ["Steady. Steady."] };
        case "HL_YIELD_01":
            return { id: "HL_YIELD_01", speaker: "", lines: ["Hailen goes down on one knee, sword across it.", "He does not raise it again."] };
        case "HL_YIELD_02":
            return { id: "HL_YIELD_02", speaker: "Hailen", lines: ["Enough.", "I won't spend my men on this."] };
        case "HL_YIELD_03":
            return { id: "HL_YIELD_03", speaker: "Taren", lines: ["Wise."] };
        case "HL_YIELD_04":
            return { id: "HL_YIELD_04", speaker: "Hailen", lines: ["Practical.", "Don't mistake it for wise."] };
        case "HL_YIELD_05":
            return { id: "HL_YIELD_05", speaker: "Hailen", lines: ["The reports are in the room behind me.", "Take them and be gone before I change my arithmetic."] };
        case "HL_YIELD_06":
            return { id: "HL_YIELD_06", speaker: "Sera", lines: ["Commander."] };
        case "HL_YIELD_07":
            return { id: "HL_YIELD_07", speaker: "Hailen", lines: ["You'll want a coat without a crest.", "The road's cold."] };
        case "HL_DEATH_01":
            return { id: "HL_DEATH_01", speaker: "", lines: ["Hailen falls before he can order the retreat.", "The yard goes quiet in a way that has nothing to do with victory."] };
        case "HL_DEATH_02":
            return { id: "HL_DEATH_02", speaker: "Sera", lines: ["He was going to hold this post until it killed him."] };
        case "HL_DEATH_03":
            return { id: "HL_DEATH_03", speaker: "Taren", lines: ["It did."] };
        case "HL_DEATH_04":
            return { id: "HL_DEATH_04", speaker: "Kael", lines: ["The reports."] };
        case "HL_DEATH_05":
            return { id: "HL_DEATH_05", speaker: "Sera", lines: ["Behind him.", "Try to deserve them."] };
        case "BW_LEAD_01":
            return { id: "BW_LEAD_01", speaker: "", lines: ["A dispatch chest, a map table, and a ledger with a month of it missing.", "Someone has been crossing out names."] };
        case "BW_LEAD_02":
            return { id: "BW_LEAD_02", speaker: "Caelan", lines: ["Patrols. Four of them. Same road, same week of the month.", "None of them came back."] };
        case "BW_LEAD_03":
            return { id: "BW_LEAD_03", speaker: "Lyra", lines: ["And the Crown's answer was to stop looking."] };
        case "BW_LEAD_04":
            return { id: "BW_LEAD_04", speaker: "Caelan", lines: ["No. The Crown's answer was to stop writing it down.", "Look at the seal."] };
        case "BW_LEAD_05":
            return { id: "BW_LEAD_05", speaker: "", lines: ["A sealed order, broken once and folded again.", "The wax carries a mark older than the Crown."] };
        case "BW_LEAD_06":
            return { id: "BW_LEAD_06", speaker: "Caelan", lines: ["That's not a Crown seal."] };
        case "BW_LEAD_07":
            return { id: "BW_LEAD_07", speaker: "Kael", lines: ["Then whose?"] };
        case "BW_LEAD_08":
            return { id: "BW_LEAD_08", speaker: "Caelan", lines: ["A door. There's a stone door in the Blackwood,", "and someone in the palace knows it."] };
        case "BW_LEAD_09":
            return { id: "BW_LEAD_09", speaker: "Sera", lines: ["The patrols that vanished were following it.", "Every one of them left the road at the same stone."] };
        case "BW_LEAD_10":
            return { id: "BW_LEAD_10", speaker: "Taren", lines: ["And the Crown sealed the file instead of the road."] };
        case "BW_LEAD_11":
            return { id: "BW_LEAD_11", speaker: "Sera", lines: ["The Crown seals what it can't explain.", "It's cheaper than an answer."] };
        case "SR_STAKE_01":
            return { id: "SR_STAKE_01", speaker: "Kael", lines: ["You could stay. Wait for the wagon."] };
        case "SR_STAKE_02":
            return { id: "SR_STAKE_02", speaker: "Sera", lines: ["I could."] };
        case "SR_STAKE_03":
            return { id: "SR_STAKE_03", speaker: "Sera", lines: ["I took an oath to protect people.", "Not a king. Not a road. People."] };
        case "SR_STAKE_04":
            return { id: "SR_STAKE_04", speaker: "Sera", lines: ["I can keep that oath out there.", "I can't keep it in a cell."] };
        case "SR_STAKE_05":
            return { id: "SR_STAKE_05", speaker: "Kael", lines: ["Then walk with us."] };
        case "SR_STAKE_06":
            return { id: "SR_STAKE_06", speaker: "Sera", lines: ["One condition.", "When I say I won't talk about the palace, that's the whole answer."] };
        case "SR_STAKE_07":
            return { id: "SR_STAKE_07", speaker: "Sera", lines: ["Not a secret I'm saving for a better audience.", "Just the end of it."] };
        case "SR_STAKE_08":
            return { id: "SR_STAKE_08", speaker: "Kael", lines: ["Understood."] };
        case "SR_STAKE_09":
            return { id: "SR_STAKE_09", speaker: "Taren", lines: ["That's the first honest thing anyone's said in this yard."] };
        case "SR_JOIN_01":
            return { id: "SR_JOIN_01", speaker: "Sera", lines: ["Seraphine Thorn. Sera.", "Silver Guard, until I wasn't."] };
        case "SR_JOIN_02":
            return { id: "SR_JOIN_02", speaker: "Lyra", lines: ["Do you have coin?"] };
        case "SR_JOIN_03":
            return { id: "SR_JOIN_03", speaker: "Sera", lines: ["No."] };
        case "SR_JOIN_04":
            return { id: "SR_JOIN_04", speaker: "Lyra", lines: ["She's your problem now.", "I'm at capacity."] };
        case "SR_JOIN_05":
            return { id: "SR_JOIN_05", speaker: "Caelan", lines: ["You're at capacity?"] };
        case "SR_JOIN_06":
            return { id: "SR_JOIN_06", speaker: "Lyra", lines: ["Emotionally."] };
        case "SR_JOIN_07":
            return { id: "SR_JOIN_07", speaker: "Sera", lines: ["I've been in a cell for a month.", "I'll take the back rank and the first watch."] };
        case "SR_JOIN_08":
            return { id: "SR_JOIN_08", speaker: "Taren", lines: ["You'll take the fourth slot and like it.", "We'll sort the rest at the next crystal."] };
        case "SR_JOIN_09":
            return { id: "SR_JOIN_09", speaker: "Kael", lines: ["Welcome to it."] };
        case "SR_SYS_01":
            return { id: "SR_SYS_01", speaker: "SYSTEM", lines: ["Seraphine \"Sera\" Thorn has joined the party.", "Five in the roster. Four in battle."] };
        case "SR_SYS_02":
            return { id: "SR_SYS_02", speaker: "SYSTEM", lines: ["Weapon: holy sword.", "Starting skills: Mend, Aegis, and Smite."] };
        case "SR_SYS_03":
            return { id: "SR_SYS_03", speaker: "SYSTEM", lines: ["Mend: restores HP to one ally. Aegis: raises an ally's defense.", "Smite: holy damage. The restless and the Ashbound fear it."] };
        case "SR_SYS_04":
            return { id: "SR_SYS_04", speaker: "SYSTEM", lines: ["Choose who stands. Party Order, in the Adventure menu.", "The reserve stays equipped and out of the fight."] };
        case "SR_JOIN_R1":
            return { id: "SR_JOIN_R1", speaker: "Sera", lines: ["The palace isn't a story I tell in courtyards.", "Ask me about the road instead."] };
        case "BG_R1":
            return { id: "BG_R1", speaker: "Sergeant", lines: ["Commander's orders were to hold the post.", "Nobody said anything about holding it well."] };
        case "BG_HANDOFF_01":
            return { id: "BG_HANDOFF_01", speaker: "Taren", lines: ["Blackwood road.", "From here the map stops being a map."] };
        case "BG_HANDOFF_02":
            return { id: "BG_HANDOFF_02", speaker: "Caelan", lines: ["The stone door is a day in. Maybe less.", "The patrols made it in a day."] };
        case "BG_HANDOFF_03":
            return { id: "BG_HANDOFF_03", speaker: "Lyra", lines: ["The patrols didn't come out."] };
        case "BG_HANDOFF_04":
            return { id: "BG_HANDOFF_04", speaker: "Kael", lines: ["Then we're better than patrols."] };
        case "BG_HANDOFF_05":
            return { id: "BG_HANDOFF_05", speaker: "Sera", lines: ["No. We're fewer.", "It'll have to do."] };
        case "BG_HANDOFF_06":
            return { id: "BG_HANDOFF_06", speaker: "SYSTEM", lines: ["Quest updated: Follow the trail into the Blackwood."] };
        case "BG_HANDOFF_07":
            return { id: "BG_HANDOFF_07", speaker: "SYSTEM", lines: ["Chapter 5 — The Deserted Oath — Complete."] };
        case "BG_HANDOFF_08":
            return { id: "BG_HANDOFF_08", speaker: "SYSTEM", lines: ["Act II — The Broken Crown — Complete."] };
        case "FK4_01":
            return { id: "FK4_01", speaker: "", lines: ["At the first trees, a figure in ruined plate stands off the road.", "He does not move to block it."] };
        case "FK4_02":
            return { id: "FK4_02", speaker: "Fallen Knight", lines: ["The forest has already taken its share.", "It will want another."] };
        case "FK4_03":
            return { id: "FK4_03", speaker: "Kael", lines: ["Who are you?"] };
        case "FK4_04":
            return { id: "FK4_04", speaker: "Fallen Knight", lines: ["Someone who counted the ones it took."] };
        case "FK4_05":
            return { id: "FK4_05", speaker: "", lines: ["By the time the party reaches the treeline, the road is empty."] };
        case "BG_NOTICE_R1":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "BG_NOTICE_R1", speaker: "", lines: ["The deserter notice is still the freshest thing on the board."] };
        case "BG_GATE_R1":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "BG_GATE_R1", speaker: "Sergeant", lines: ["Commander's orders were to hold the post.", "Nobody said anything about holding it well."] };
        case "BG_YARD_R1":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "BG_YARD_R1", speaker: "", lines: ["The yard has gone back to its work. Nobody is meeting your eye."] };
        case "SR_MEET_R1":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "SR_MEET_R1", speaker: "Sera", lines: ["Ask the commander. He keeps the answers in a chest.", "I only know what he won't say out loud."] };
        case "HL_INTRO_R1":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "HL_INTRO_R1", speaker: "Commander Hailen", lines: ["You're still standing in my yard.", "Say what you came to say."] };
        case "BG_KEEP_LOCKED":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "BG_KEEP_LOCKED", speaker: "", lines: ["The office door is barred from the inside.", "Nobody is opening it while the commander is standing."] };
        case "BW_LEAD_R1":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "BW_LEAD_R1", speaker: "", lines: ["The ledger is open where you left it.", "Some of the crossed-out names have dates beside them."] };
        case "SR_STAKE_R1":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "SR_STAKE_R1", speaker: "Sera", lines: ["Ask me about the road.", "The road I'll answer for."] };
        case "CH5_HANDOFF_LOCKED":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "CH5_HANDOFF_LOCKED", speaker: "", lines: ["Not yet. The lead is still in the commander's office."] };
    }
    return undefined;
}
