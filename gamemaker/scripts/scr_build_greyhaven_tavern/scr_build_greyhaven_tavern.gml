/// scr_build_greyhaven_tavern(): fills rm_greyhaven_tavern (24x16 tiles, 384x256 px) from embedded data. Rusted Boar Tavern (burnt; Hob).
/// Call from the room's Creation Code. Generated by src/export.py.
function scr_build_greyhaven_tavern() {
    var _d = scr_greyhaven_tavern_data();
    scr_map_build_from_arrays(_d, 24, 16);
    scr_map_spawn_markers(scr_greyhaven_tavern_markers());
    scr_map_enable_camera(320, 180);
    scr_camera_follow_player();
}

