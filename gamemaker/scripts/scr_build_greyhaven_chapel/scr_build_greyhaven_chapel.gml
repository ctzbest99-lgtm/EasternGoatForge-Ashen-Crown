/// scr_build_greyhaven_chapel(): fills rm_greyhaven_chapel (20x18 tiles, 320x288 px) from embedded data. Greyhaven Chapel (burnt; Sister Ilse).
/// Call from the room's Creation Code. Generated by src/export.py.
function scr_build_greyhaven_chapel() {
    var _d = scr_greyhaven_chapel_data();
    scr_map_build_from_arrays(_d, 20, 18);
    scr_map_spawn_markers(scr_greyhaven_chapel_markers());
    scr_map_enable_camera(320, 180);
    scr_camera_follow_player();
}

