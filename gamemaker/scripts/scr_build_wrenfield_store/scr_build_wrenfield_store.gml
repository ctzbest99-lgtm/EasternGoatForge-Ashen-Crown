/// scr_build_wrenfield_store(): fills rm_wrenfield_store (20x14 tiles, 320x224 px) from embedded data. Len's store (open: shutters up).
/// Call from the room's Creation Code. Generated by wrenfield/src/export_wf.py. Uses the ts_wrenfield tileset.
function scr_build_wrenfield_store() {
    scr_wf_prepare_layers(20, 14);
    scr_map_build_from_arrays(scr_wrenfield_store_data(), 20, 14);
    scr_map_spawn_markers(scr_wf_filter_markers(scr_wrenfield_store_markers()));
    scr_map_enable_camera(320, 180);   // repo addition (as in the Zone 1 builders)
    scr_camera_follow_player();
}

