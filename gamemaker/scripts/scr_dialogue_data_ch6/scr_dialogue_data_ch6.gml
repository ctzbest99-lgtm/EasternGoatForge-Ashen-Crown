/// scr_dialogue_data_ch6 — Chapter 6 dialogue nodes, keyed by the line ids in
/// docs/story/CHAPTER6_SCRIPT.md (approved Nov 16 2026). Text is verbatim.
/// GENERATED by tools/gen_ch6_dialogue.py — edit the script and re-run, do not hand-edit.
/// Speaker "" is NARRATION. The last block holds the wiring pass's placeholder lines (not in the script).

function scr_ch6_dialogue_node(_id) {
    switch (_id) {
        case "BW_HANDOFF_01":
            return { id: "BW_HANDOFF_01", speaker: "Taren", lines: ["Road ends here. After this it's deer trails.", "Crown patrols don't walk deer trails."] };
        case "BW_HANDOFF_02":
            return { id: "BW_HANDOFF_02", speaker: "Sera", lines: ["They walked this one.", "Someone wanted them to."] };
        case "BW_HANDOFF_03":
            return { id: "BW_HANDOFF_03", speaker: "Lyra", lines: ["Then we walk it too, and we don't announce it.", "No torches unless the dark makes us."] };
        case "BW_HANDOFF_04":
            return { id: "BW_HANDOFF_04", speaker: "Kael", lines: ["Stay close. If the trees start looking alike,", "say so — that's how it starts."] };
        case "BW_DEEP_01":
            return { id: "BW_DEEP_01", speaker: "", lines: ["The road narrows until the trees close over it.", "It is the middle of the afternoon. It is not bright."] };
        case "BW_DEEP_02":
            return { id: "BW_DEEP_02", speaker: "Caelan", lines: ["Light's coming through the canopy and still landing grey.", "That isn't shade. Shade moves."] };
        case "BW_DEEP_03":
            return { id: "BW_DEEP_03", speaker: "Lyra", lines: ["Charcoal. Somebody's been burning here, and recently.", "Not a camp — a trade."] };
        case "BW_STONE_01":
            return { id: "BW_STONE_01", speaker: "Kael", lines: ["Same mark. Watchtower, the basement under Greyhaven.", "Now out here, on a stone nobody's read in years."] };
        case "BW_STONE_02":
            return { id: "BW_STONE_02", speaker: "Sera", lines: ["It's older than the road.", "The road was built around it."] };
        case "BW_STONE_03":
            return { id: "BW_STONE_03", speaker: "Taren", lines: ["Then somebody knew it was here and went to the trouble.", "I hate that."] };
        case "CH_ARRIVE_01":
            return { id: "CH_ARRIVE_01", speaker: "", lines: ["The trees stop. Not cleared — burned back, in a ring,", "and kept that way."] };
        case "CH_ARRIVE_02":
            return { id: "CH_ARRIVE_02", speaker: "Burner", lines: ["Crown. You're Crown.", "You're late and you're fewer than last time."] };
        case "CH_ARRIVE_03":
            return { id: "CH_ARRIVE_03", speaker: "Kael", lines: ["We're not Crown.", "We're looking for the ones who were."] };
        case "CH_ARRIVE_04":
            return { id: "CH_ARRIVE_04", speaker: "Burner", lines: ["Then you're late too."] };
        case "CH_BERRIN_01":
            return { id: "CH_BERRIN_01", speaker: "Berrin", lines: ["Berrin. I speak for the hollow, such as it is.", "You'll want water. Then you'll want answers."] };
        case "CH_BERRIN_02":
            return { id: "CH_BERRIN_02", speaker: "Kael", lines: ["The patrol that came through here.", "Where did they go?"] };
        case "CH_BERRIN_03":
            return { id: "CH_BERRIN_03", speaker: "Berrin", lines: ["Into the wood. Same as the others.", "The forest takes a share. We pay it, and it lets us stay."] };
        case "CH_BERRIN_04":
            return { id: "CH_BERRIN_04", speaker: "Lyra", lines: ["A share of what?"] };
        case "CH_BERRIN_05":
            return { id: "CH_BERRIN_05", speaker: "Berrin", lines: ["Of what's owed.", "Ask me a different question."] };
        case "CH_BERRIN_06":
            return { id: "CH_BERRIN_06", speaker: "Sera", lines: ["How long has the Crown been paying it for you?"] };
        case "CH_BERRIN_07":
            return { id: "CH_BERRIN_07", speaker: "Berrin", lines: ["Since before me. Since before the road.", "When they stopped, the wood noticed."] };
        case "CH_TALK_01":
            return { id: "CH_TALK_01", speaker: "Burner", lines: ["Kiln's cold three days. Wet wood.", "You want to be useful, carry something."] };
        case "CH_TALK_02":
            return { id: "CH_TALK_02", speaker: "Burner", lines: ["My brother went out for kindling in spring.", "I don't go out for kindling."] };
        case "CH_TALK_03":
            return { id: "CH_TALK_03", speaker: "Child", lines: ["Mother says don't go past the burn line.", "Everyone says that. Everyone goes anyway."] };
        case "CH_TITHE_01":
            return { id: "CH_TITHE_01", speaker: "Berrin", lines: ["My daughter's name goes down this autumn.", "That's the custom. It's not a thing you argue with."] };
        case "CH_TITHE_02":
            return { id: "CH_TITHE_02", speaker: "Kael", lines: ["Goes down where?"] };
        case "CH_TITHE_03":
            return { id: "CH_TITHE_03", speaker: "Berrin", lines: ["Where it goes.", "You'll want the camp. East, past the second burn line."] };
        case "PT_CAMP_01":
            return { id: "PT_CAMP_01", speaker: "", lines: ["Two tents. A fire gone cold in the night, not the rain.", "The bedrolls are rolled."] };
        case "PT_CAMP_02":
            return { id: "PT_CAMP_02", speaker: "Taren", lines: ["Armour's stacked. Boots are lined up.", "Nobody dies that tidy."] };
        case "PT_CAMP_03":
            return { id: "PT_CAMP_03", speaker: "Caelan", lines: ["They undressed. Or they were undressed.", "Either way they went without a fight."] };
        case "PT_CAMP_04":
            return { id: "PT_CAMP_04", speaker: "Sera", lines: ["The notice. Same seal as the one at the garrison.", "Not the Crown's. Broken from the inside."] };
        case "PT_CAMP_05":
            return { id: "PT_CAMP_05", speaker: "Lyra", lines: ["So whoever wrote it wanted the patrol to stop looking.", "And the patrol opened it anyway."] };
        case "PT_CAMP_06":
            return { id: "PT_CAMP_06", speaker: "Kael", lines: ["Take it. We'll want it when we find who sealed it."] };
        case "BH_INTRO_01":
            return { id: "BH_INTRO_01", speaker: "", lines: ["The burn line ends at a wall of thorn that is not a wall.", "It is breathing."] };
        case "BH_INTRO_02":
            return { id: "BH_INTRO_02", speaker: "Caelan", lines: ["That's not a hedge. That's a thing that grew into one.", "It's been fed."] };
        case "BH_INTRO_03":
            return { id: "BH_INTRO_03", speaker: "Kael", lines: ["Then we cut it back."] };
        case "BH_AFTER_01":
            return { id: "BH_AFTER_01", speaker: "Taren", lines: ["Dead. Nothing behind it but more trees.", "Whatever it was guarding, it wasn't guarding that."] };
        case "BH_AFTER_02":
            return { id: "BH_AFTER_02", speaker: "Lyra", lines: ["Berrin knew it was here. He sent us east.", "He wanted it gone and wouldn't say so."] };
        case "CH_FEED_01":
            return { id: "CH_FEED_01", speaker: "Berrin", lines: ["You killed it. Good.", "It'll grow back before the frost."] };
        case "CH_FEED_02":
            return { id: "CH_FEED_02", speaker: "Kael", lines: ["You could have told us what it was."] };
        case "CH_FEED_03":
            return { id: "CH_FEED_03", speaker: "Berrin", lines: ["I could have."] };
        case "CH_FEED_04":
            return { id: "CH_FEED_04", speaker: "Berrin", lines: ["You asked what we pay. I'll tell you, and then you'll go.", "We don't pay it. We feed it."] };
        case "CH_FEED_05":
            return { id: "CH_FEED_05", speaker: "Sera", lines: ["Feed it what?"] };
        case "CH_FEED_06":
            return { id: "CH_FEED_06", speaker: "Berrin", lines: ["The shrine's under the roots, south of here.", "Go and look. I won't stop you and I won't come."] };
        case "CH_END_01":
            return { id: "CH_END_01", speaker: "", lines: ["Berrin goes back to his kiln. The hollow goes quiet behind you.", "South, the trees are older."] };
        case "BW_STONE_R1":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "BW_STONE_R1", speaker: "", lines: ["The mark is cut shallow. Whoever made it wanted it read once."] };
        case "CH_BERRIN_R1":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "CH_BERRIN_R1", speaker: "Berrin", lines: ["Ask the wood. I've told you what I'll tell you."] };
        case "PT_CAMP_R1":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "PT_CAMP_R1", speaker: "", lines: ["The camp is as you left it. Nobody has come for the armour."] };
        case "BH_FIGHT_01":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "BH_FIGHT_01", speaker: "", lines: ["The thorn moves before you are ready for it."] };
        case "BH_FIGHT_02":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "BH_FIGHT_02", speaker: "SYSTEM", lines: ["The Burn-Line Hulk. Boss."] };
        case "CH_END_02":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "CH_END_02", speaker: "SYSTEM", lines: ["Quest updated: Find out what Cinderhollow pays, and to whom.", "Chapter 6 — The Green Silence — Complete."] };
    }
    return undefined;
}
