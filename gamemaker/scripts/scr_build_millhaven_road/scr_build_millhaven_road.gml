/// scr_build_millhaven_road(): fills rm_millhaven_road (32x60 tiles, 512x960 px) from embedded data. Millhaven Road: signpost, Crown notice, traveler (hook), Architect stones, Crown patrol.
/// Call from the room's Creation Code. Generated by wrenfield/src/export_wf.py. Uses the ts_wrenfield tileset.
function scr_build_millhaven_road() {
    scr_wf_prepare_layers(32, 60);
    scr_map_build_from_arrays(scr_millhaven_road_data(), 32, 60);
    scr_map_spawn_markers(scr_wf_filter_markers(scr_millhaven_road_markers()));
    scr_map_enable_camera(320, 180);   // repo addition (as in the Zone 1 builders)
    scr_camera_follow_player();
}

