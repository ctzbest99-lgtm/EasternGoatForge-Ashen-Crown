/// scr_dialogue_data_ch9 — Chapter 9 dialogue nodes, keyed by the line ids in
/// docs/story/CHAPTER9_SCRIPT.md (built Nov 16 2026 from the approved Act IV decisions).
/// GENERATED by tools/gen_ch9_dialogue.py — edit the script and re-run, do not hand-edit.
/// Speaker "" is NARRATION. The last block holds wiring-only placeholder lines.

function scr_ch9_dialogue_node(_id) {
    switch (_id) {
        case "TN_ROAD_01":
            return { id: "TN_ROAD_01", speaker: "", lines: ["The trees end the way a wall ends. One step of leaf litter, then a hedge, then a field with sheep in it.", "The road is graded. Someone maintains it."] };
        case "TN_ROAD_02":
            return { id: "TN_ROAD_02", speaker: "Lyra", lines: ["Cart ruts. Deep ones. This road gets used.", "We came through a wood where the patrols stopped and came out on a road the Crown keeps swept."] };
        case "TN_ROAD_03":
            return { id: "TN_ROAD_03", speaker: "Caelan", lines: ["The Blackwood is one day from a market town.", "That is not a wilderness. That is a border somebody chose."] };
        case "TN_ROAD_04":
            return { id: "TN_ROAD_04", speaker: "Sera", lines: ["A border with what on the other side?"] };
        case "TN_ROAD_05":
            return { id: "TN_ROAD_05", speaker: "Caelan", lines: ["That is the question the whole act is going to ask."] };
        case "TN_ROAD_06":
            return { id: "TN_ROAD_06", speaker: "Taren", lines: ["Then let's go ask it where there's a roof and a ledger.", "I've had enough of standing in the dark listening to stones."] };
        case "TN_ROAD_07":
            return { id: "TN_ROAD_07", speaker: "Kael", lines: ["Coleford. We buy what we need, we ask what the Crown keeps, and we don't tell anyone where we came from."] };
        case "TN_ROAD_08":
            return { id: "TN_ROAD_08", speaker: "Taren", lines: ["You say that like it'll work."] };
        case "TN_ROAD_09":
            return { id: "TN_ROAD_09", speaker: "Kael", lines: ["It won't. But we'll know the town before it knows us."] };
        case "TN_TOWN_01":
            return { id: "TN_TOWN_01", speaker: "", lines: ["The square is swept. The levy board has this quarter's grain price on it, written in a careful hand.", "Two children are playing at swords with sticks, and one of them is winning."] };
        case "TN_TOWN_02":
            return { id: "TN_TOWN_02", speaker: "Sera", lines: ["They don't know."] };
        case "TN_TOWN_03":
            return { id: "TN_TOWN_03", speaker: "Lyra", lines: ["They know the price of grain and the price of wool.", "That's what a town knows."] };
        case "TN_TOWN_04":
            return { id: "TN_TOWN_04", speaker: "Caelan", lines: ["The wood is a day away and it may as well be a story.", "Ask anyone here and they'll tell you the patrols keep it clear."] };
        case "TN_TOWN_05":
            return { id: "TN_TOWN_05", speaker: "Taren", lines: ["The patrols are standing in the leaf litter facing a bowl.", "I've been in a cell with better information than this town."] };
        case "TN_TOWN_06":
            return { id: "TN_TOWN_06", speaker: "Kael", lines: ["Then we don't argue with them. We go where the paper is."] };
        case "TN_BOARD_01":
            return { id: "TN_BOARD_01", speaker: "", lines: ["Grain, wool, salt, and a line for \"survey, Crown lands, quarterly.\"", "The survey line has a number beside it and no description."] };
        case "TN_BOARD_02":
            return { id: "TN_BOARD_02", speaker: "Caelan", lines: ["They pay for a survey every quarter.", "Someone rides out four times a year and writes down what the Crown owns."] };
        case "TN_BOARD_03":
            return { id: "TN_BOARD_03", speaker: "Lyra", lines: ["Then somewhere there's a shelf of those.", "Let's go find out what's on it."] };
        case "VG_MEET_01":
            return { id: "VG_MEET_01", speaker: "", lines: ["The public room smells of dust and lamp oil. The ledgers are matched, numbered, and in better repair than the road outside.", "The magistrate does not stand up."] };
        case "VG_MEET_02":
            return { id: "VG_MEET_02", speaker: "Vell", lines: ["Crown land survey. You'll want the quarterly volumes.", "They're public. Sit down, wash your hands, and don't touch the bindings."] };
        case "VG_MEET_03":
            return { id: "VG_MEET_03", speaker: "Caelan", lines: ["You keep them open to the public."] };
        case "VG_MEET_04":
            return { id: "VG_MEET_04", speaker: "Vell", lines: ["I keep them correct. Open is a consequence.", "There's a difference, and it's the only thing I've got."] };
        case "VG_MEET_05":
            return { id: "VG_MEET_05", speaker: "Taren", lines: ["We're looking for what the Crown built. Roads, walls, anything older than the roads.", "Specifically anything it built and then stopped writing down."] };
        case "VG_MEET_06":
            return { id: "VG_MEET_06", speaker: "Vell", lines: ["Which quarter?"] };
        case "VG_MEET_07":
            return { id: "VG_MEET_07", speaker: "Taren", lines: ["You tell me."] };
        case "VG_MEET_08":
            return { id: "VG_MEET_08", speaker: "Vell", lines: ["I'll show you the shelf. You'll find the gap yourself.", "Everyone does. Nobody asks."] };
        case "VG_MEET_09":
            return { id: "VG_MEET_09", speaker: "", lines: ["The volume is the oldest on the shelf. The page has been cut out with a blade, close to the binding, and the stub is still there.", "The cut is old. The leather has closed over it."] };
        case "VG_MEET_10":
            return { id: "VG_MEET_10", speaker: "Sera", lines: ["Who removed it?"] };
        case "VG_MEET_11":
            return { id: "VG_MEET_11", speaker: "Vell", lines: ["Before my time. Before the man before my time.", "I've been the magistrate here for eleven years and I have never once been asked that question."] };
        case "VG_MEET_12":
            return { id: "VG_MEET_12", speaker: "Kael", lines: ["I'm asking it."] };
        case "VG_MEET_13":
            return { id: "VG_MEET_13", speaker: "Vell", lines: ["And I'm telling you I don't know. I know what the volume says on either side of the gap.", "I know the survey that quarter covered four holdings and the page would have been the fifth."] };
        case "VG_MEET_14":
            return { id: "VG_MEET_14", speaker: "Caelan", lines: ["A fifth holding with no name."] };
        case "VG_MEET_15":
            return { id: "VG_MEET_15", speaker: "Vell", lines: ["A fifth holding with no name, no tax line, and no road on any map I own.", "Now you know what I know. I'd like you to leave."] };
        case "VG_MEET_16":
            return { id: "VG_MEET_16", speaker: "Vell", lines: ["I'd like you to leave, and I'm aware that you won't.", "So we'll do this the way the book says."] };
        case "VG_FIGHT_01":
            return { id: "VG_FIGHT_01", speaker: "", lines: ["Vell steps back behind the counter and rings the bell twice, unhurried.", "The door opens on two of the Crown's guard, in clean plate, who look bored until they see the party."] };
        case "VG_FIGHT_02":
            return { id: "VG_FIGHT_02", speaker: "Crown Guard", lines: ["Magistrate. Say the word."] };
        case "VG_FIGHT_03":
            return { id: "VG_FIGHT_03", speaker: "Vell", lines: ["The word is \"detain.\" Nobody dies in my public room."] };
        case "VG_FIGHT_04":
            return { id: "VG_FIGHT_04", speaker: "Taren", lines: ["That's the first sensible thing anyone's said in this town."] };
        case "VG_FIGHT_05":
            return { id: "VG_FIGHT_05", speaker: "Vell", lines: ["You'll note I'm not running. I'd like that noted.", "I'm also not the one who cut the page out, and I'd like that noted more."] };
        case "VG_YIELD_01":
            return { id: "VG_YIELD_01", speaker: "Vell", lines: ["Enough. Enough.", "Guard — stand down. They've won the room, not the argument."] };
        case "VG_YIELD_02":
            return { id: "VG_YIELD_02", speaker: "Crown Guard", lines: ["Magistrate —"] };
        case "VG_YIELD_03":
            return { id: "VG_YIELD_03", speaker: "Vell", lines: ["I said stand down. Fetch the survey box and put it on the counter.", "Then go and stand outside and be bored again."] };
        case "VG_PAGE_01":
            return { id: "VG_PAGE_01", speaker: "Vell", lines: ["The page was in the drawer when I took this post. In an envelope with my predecessor's hand on it.", "\"For the next one.\" That's all it says."] };
        case "VG_PAGE_02":
            return { id: "VG_PAGE_02", speaker: "Caelan", lines: ["He left it for you."] };
        case "VG_PAGE_03":
            return { id: "VG_PAGE_03", speaker: "Vell", lines: ["He left it for whoever came after him, and I am whoever came after him.", "I have looked at it perhaps six times in eleven years. I have never once ridden out to see."] };
        case "VG_PAGE_04":
            return { id: "VG_PAGE_04", speaker: "", lines: ["The page is a survey: bearings, distances, a holding marked with a barrow field, and a road to it drawn in a different hand from the rest.", "At the bottom, in the surveyor's column: \"Maintained. Item not assessed.\""] };
        case "VG_PAGE_05":
            return { id: "VG_PAGE_05", speaker: "Lyra", lines: ["Maintained. They've been paying to keep a road open to a field nobody owns."] };
        case "VG_PAGE_06":
            return { id: "VG_PAGE_06", speaker: "Sera", lines: ["\"Item not assessed.\" That's not a mistake. That's an instruction."] };
        case "VG_PAGE_07":
            return { id: "VG_PAGE_07", speaker: "Vell", lines: ["Yes. It is.", "And I have signed the quarterly return every year of my tenure, and the line has always been paid, and I have never asked."] };
        case "VG_PAGE_08":
            return { id: "VG_PAGE_08", speaker: "Taren", lines: ["Why not?"] };
        case "VG_PAGE_09":
            return { id: "VG_PAGE_09", speaker: "Vell", lines: ["Because a man who asks is a man who is asked about.", "I'm a filing problem, boy. I've made myself one on purpose."] };
        case "VG_PAGE_10":
            return { id: "VG_PAGE_10", speaker: "Kael", lines: ["Then we'll be the ones who ask.", "You keep the volume. We'll take the page."] };
        case "VG_PAGE_11":
            return { id: "VG_PAGE_11", speaker: "Vell", lines: ["Take it. It's been in my drawer long enough to be a confession."] };
        case "CL_CHOICE_01":
            return { id: "CL_CHOICE_01", speaker: "Nessa", lines: ["Magistrate — the page. Before it goes.", "An hour. I'll copy it and put it back in the drawer and no one will know it moved."] };
        case "CL_CHOICE_02":
            return { id: "CL_CHOICE_02", speaker: "Vell", lines: ["It's not mine to lend. Ask them."] };
        case "CL_CHOICE_03":
            return { id: "CL_CHOICE_03", speaker: "Nessa", lines: ["My cousin burns charcoal at the wood's edge. He's paid the survey line his whole life.", "I'd like to know what he bought."] };
        case "CL_CHOICE_04":
            return { id: "CL_CHOICE_04", speaker: "Kael", lines: ["Your call, Nessa. Say it and we'll do it.", "Or say nothing and we'll take the page and be gone before the bell rings again."] };
        case "CL_COPY_01":
            return { id: "CL_COPY_01", speaker: "Kael", lines: ["Copy it. An hour. We'll be at the inn."] };
        case "CL_COPY_02":
            return { id: "CL_COPY_02", speaker: "Nessa", lines: ["Thank you."] };
        case "CL_COPY_03":
            return { id: "CL_COPY_03", speaker: "Vell", lines: ["Don't thank them. Thank the fact that nobody in this town reads.", "If they did, we'd all be answering questions."] };
        case "CL_COPY_04":
            return { id: "CL_COPY_04", speaker: "", lines: ["She copies it in a clear, careful hand, and blots it, and sands it, and does not look up once.", "When she's done she folds the copy into her sleeve and hands the page back without a word."] };
        case "CL_TAKE_01":
            return { id: "CL_TAKE_01", speaker: "Kael", lines: ["No. The page doesn't leave our hands.", "Not for an hour, not for a minute."] };
        case "CL_TAKE_02":
            return { id: "CL_TAKE_02", speaker: "Nessa", lines: ["I understand."] };
        case "CL_TAKE_03":
            return { id: "CL_TAKE_03", speaker: "Taren", lines: ["Do you?"] };
        case "CL_TAKE_04":
            return { id: "CL_TAKE_04", speaker: "Nessa", lines: ["I'm a clerk, sir. Understanding things I can't change is the whole of my work.", "Mind the step on your way out."] };
        case "AL_MEET_01":
            return { id: "AL_MEET_01", speaker: "", lines: ["Alden is at the inn's back table with a pot of tea and three separate piles of paper, and he stands up so fast the chair goes over."] };
        case "AL_MEET_02":
            return { id: "AL_MEET_02", speaker: "Alden", lines: ["Kael.", "You look like a man who has been in a wood for a month."] };
        case "AL_MEET_03":
            return { id: "AL_MEET_03", speaker: "Kael", lines: ["Two. It was two."] };
        case "AL_MEET_04":
            return { id: "AL_MEET_04", speaker: "Alden", lines: ["Then sit down and eat something that isn't smoked, and tell me what the Crown has been hiding out there."] };
        case "AL_MEET_05":
            return { id: "AL_MEET_05", speaker: "Taren", lines: ["What makes you think it's hiding something?"] };
        case "AL_MEET_06":
            return { id: "AL_MEET_06", speaker: "Alden", lines: ["Because I've been three days in a Crown town asking what the Crown owns, and every answer has been a form.", "A form is what a man writes when he doesn't want to write the truth."] };
        case "AL_MEET_07":
            return { id: "AL_MEET_07", speaker: "Alden", lines: ["There's a gap in the survey. Four holdings that quarter and a fifth with no name.", "I've been trying to find a man who'd say the fifth's name out loud. You've found a page."] };
        case "AL_MEET_08":
            return { id: "AL_MEET_08", speaker: "Caelan", lines: ["You know what's on it?"] };
        case "AL_MEET_09":
            return { id: "AL_MEET_09", speaker: "Alden", lines: ["I know what it would have to be. Land the Crown maintains and doesn't assess is land the Crown is frightened of.", "And a Crown that's frightened of a field is a Crown with a reason."] };
        case "AL_MEET_10":
            return { id: "AL_MEET_10", speaker: "Sera", lines: ["That's a large conclusion from a missing page."] };
        case "AL_MEET_11":
            return { id: "AL_MEET_11", speaker: "Alden", lines: ["It's the only conclusion a man can reach from a missing page, and I've had three days to reach it.", "I'm not asking you to agree. I'm asking to come with you."] };
        case "AL_MEET_12":
            return { id: "AL_MEET_12", speaker: "Kael", lines: ["Why?"] };
        case "AL_MEET_13":
            return { id: "AL_MEET_13", speaker: "Alden", lines: ["Because whoever sits the throne next will need a reason, and the Crown has spent a hundred years making sure nobody has one.", "I want to know what it buried. That's all. I want to know what it buried."] };
        case "AL_MEET_14":
            return { id: "AL_MEET_14", speaker: "Taren", lines: ["Then come. We leave at first light."] };
        case "AL_MEET_15":
            return { id: "AL_MEET_15", speaker: "Kael", lines: ["Taren."] };
        case "AL_MEET_16":
            return { id: "AL_MEET_16", speaker: "Taren", lines: ["What? He wants the same thing we want.", "You've been asking who built the door since the Watchtower. He's asking who hid the answer. It's the same question with a roof on it."] };
        case "AL_MEET_17":
            return { id: "AL_MEET_17", speaker: "Alden", lines: ["I'll take that as a yes from the both of you.", "I've got a horse, a map with a hole in it, and no intention of being left behind."] };
        case "AL_MEET_18":
            return { id: "AL_MEET_18", speaker: "Lyra", lines: ["Can you fight?"] };
        case "AL_MEET_19":
            return { id: "AL_MEET_19", speaker: "Alden", lines: ["Badly. But I can run, and I can lie to a magistrate, and I've never once been the first to leave a room."] };
        case "AL_MEET_20":
            return { id: "AL_MEET_20", speaker: "Sera", lines: ["That's not an answer."] };
        case "AL_MEET_21":
            return { id: "AL_MEET_21", speaker: "Alden", lines: ["It's the honest one. Ask me again on the road."] };
        case "CH9_END_01":
            return { id: "CH9_END_01", speaker: "", lines: ["The road holds for a mile past the last house, then loses its gravel and becomes a track.", "Somewhere ahead of them, according to a page nobody was supposed to have, the Crown has been paying to keep a road open."] };
        case "CH9_END_02":
            return { id: "CH9_END_02", speaker: "Alden", lines: ["You know what I keep thinking about?"] };
        case "CH9_END_03":
            return { id: "CH9_END_03", speaker: "Kael", lines: ["Tell me."] };
        case "CH9_END_04":
            return { id: "CH9_END_04", speaker: "Alden", lines: ["Somebody cut that page out and then kept the book.", "They didn't burn it. They didn't burn the whole shelf. They cut one page and left the stub where anyone could see it."] };
        case "CH9_END_05":
            return { id: "CH9_END_05", speaker: "Caelan", lines: ["Because a gap can be explained. A missing book can't."] };
        case "CH9_END_06":
            return { id: "CH9_END_06", speaker: "Alden", lines: ["No. Because they wanted it found.", "By the right person. Eventually. After a hundred years."] };
        case "CH9_END_07":
            return { id: "CH9_END_07", speaker: "Taren", lines: ["Or because they were frightened, and frightened men are lazy."] };
        case "CH9_END_08":
            return { id: "CH9_END_08", speaker: "Alden", lines: ["That's the better answer. I'm hoping it's the worse one."] };
        case "CH9_END_09":
            return { id: "CH9_END_09", speaker: "SYSTEM", lines: ["Quest updated: Take the torn page to the barrow field.", "Chapter 9 — The Crown's Ledger — Complete."] };
        case "TN_BOARD_R1":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "TN_BOARD_R1", speaker: "", lines: ["The survey line is still on the board, and it still has no description."] };
        case "VG_MEET_R1":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "VG_MEET_R1", speaker: "Vell", lines: ["The page is yours. I'd rather not discuss the drawer it came out of."] };
        case "CL_WAIT_01":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "CL_WAIT_01", speaker: "Nessa", lines: ["The magistrate has the survey out. He's the one with the drawer."] };
        case "CL_WAIT_02":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "CL_WAIT_02", speaker: "Nessa", lines: ["When you've got the page, come back. I'll still be here. I'm always here."] };
        case "CL_CHOICE_R1":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "CL_CHOICE_R1", speaker: "Nessa", lines: ["I've said my piece. The page is where it is."] };
        case "AL_WAIT_01":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "AL_WAIT_01", speaker: "Alden", lines: ["You've the look of people who found something and haven't decided what to do with it."] };
        case "AL_WAIT_02":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "AL_WAIT_02", speaker: "Alden", lines: ["Go on. I'll be at this table. I'm very good at waiting in inns."] };
        case "AL_MEET_R1":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "AL_MEET_R1", speaker: "Alden", lines: ["First light. I'll be at the gate with the horses, looking useless."] };
        case "CH9_ROAD_01":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "CH9_ROAD_01", speaker: "", lines: ["The track south loses its gravel and becomes mud with a direction."] };
        case "CH9_ROAD_02":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "CH9_ROAD_02", speaker: "Taren", lines: ["That's a road the way a debt is a promise. Somebody's been paying to keep it walkable."] };
        case "CH9_ROAD_03":  // PLACEHOLDER (wiring pass, not in the script)
            return { id: "CH9_ROAD_03", speaker: "Kael", lines: ["Not yet. We finish the town first."] };
    }
    return undefined;
}
