/// obj_respawn_point : Create
/// Optional marker for the town wake-up position after a defeat.
/// Place one in TOWN_RESPAWN_ROOM (currently rm_overworld). If none exists,
/// scr_apply_town_respawn() uses TOWN_RESPAWN_X / TOWN_RESPAWN_Y instead.
/// Optional Instance Creation Code: facing_x = 0; facing_y = 1;
facing_x = 0;
facing_y = 1;
visible = DEBUG_SHOW_TRIGGERS;
